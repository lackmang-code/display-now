---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedArticles, dateLabel, articleHref } from '../../lib/articles';
import { topicIndex } from '../../lib/tags';

const articles = await getPublishedArticles();
const groups = topicIndex(articles).sort((a, b) => b.articles.length - a.articles.length);
---

<Base
  title="주제별 기사 | DISPLAY NOW"
  description="디스플레이 기술 주제별로 DISPLAY NOW 기사를 모았습니다. 산화물 반도체 TFT, 언더디스플레이 센서, OLED 증착과 발광재료, 폴더블, 특허까지 꼭지를 가로질러 한 주제를 이어 읽을 수 있습니다."
>
  <div style="background:#eeeee8; min-height:100vh;">
    <div class="frame frame-boxed">
      <Header />
      <div class="accent-bar"></div>

      <div class="topic-head">
        <div class="eyebrow">[ 주제 ]</div>
        <h1>주제별로 이어 읽기</h1>
        <p class="blurb">
          네 명의 기자가 기술노트·논문·특허·이슈로 나눠 쓰지만, 하나의 기술은 그 네 꼭지에 걸쳐 있습니다.
          같은 주제를 다룬 글을 꼭지와 상관없이 한자리에 모았습니다.
        </p>
        <div class="meta-line">
          <span>주제 {groups.length}개</span>
          <span>기사 {articles.length}편</span>
        </div>
      </div>

      <div class="grid">
        {
          groups.map((g) => (
            <a href={`/tag/${g.topic.slug}`} class="card">
              <div class="card-head">
                <span class="label">{g.topic.label}</span>
                <span class="count">{g.articles.length}편</span>
              </div>
              <p class="card-blurb">{g.topic.blurb}</p>
              <div class="recent">
                최근 · {g.articles[0].data.title}
                <span class="date">{dateLabel(g.articles[0])}</span>
              </div>
            </a>
          ))
        }
      </div>

      <Footer />
    </div>
  </div>
</Base>

<style>
  .frame-boxed {
    margin: 40px auto;
    border: 1px solid var(--line-frame);
    background: var(--card);
  }
  .accent-bar {
    height: 3px;
    background: var(--ink);
  }
  .topic-head {
    padding: 30px clamp(14px, 4vw, 26px);
    border-bottom: 2px solid var(--ink);
  }
  .topic-head h1 {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(24px, 4.8vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .blurb {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: #45453d;
    word-break: keep-all;
    max-width: 62ch;
  }
  .meta-line {
    display: flex;
    gap: 20px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0;
    padding: 0 clamp(14px, 4vw, 26px) 30px;
  }
  .card {
    display: block;
    padding: 20px 20px 18px;
    border-bottom: 1px solid var(--line-soft);
    border-right: 1px solid var(--line-soft);
  }
  .card:hover {
    background: #f7f7f3;
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
  }
  .label {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    flex: 0 0 auto;
  }
  .card-blurb {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.75;
    color: #55554d;
    word-break: keep-all;
  }
  .recent {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dotted var(--line);
    font-size: 14px;
    line-height: 1.6;
    color: var(--meta-soft);
    word-break: keep-all;
  }
  .recent .date {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
  }
</style>
