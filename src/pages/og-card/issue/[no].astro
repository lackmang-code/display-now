---
export const prerender = true;
import { ISSUES, articlesOfIssue, issueNumberLabel, issueDateLabel, type IssueMeta } from '../../../lib/issues';

export async function getStaticPaths() {
  return ISSUES.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

interface Props {
  issue: IssueMeta;
}

const { issue } = Astro.props;
const articles = await articlesOfIssue(issue);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og-card-issue</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Noto+Serif+KR:wght@700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #12120e;
      }
      .frame {
        width: 1200px;
        height: 630px;
        display: flex;
        flex-direction: column;
        padding: 44px 56px 36px;
        gap: 22px;
      }
      .top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 2px solid rgba(244, 243, 238, 0.28);
        padding-bottom: 14px;
      }
      /* 표지에서 가장 큰 활자는 언제나 제호다 */
      .mast {
        font-family: 'Noto Serif KR', serif;
        font-weight: 700;
        font-size: 76px;
        line-height: 1;
        letter-spacing: -0.045em;
        color: oklch(0.87 0.195 93);
      }
      .no {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 23px;
        letter-spacing: 0.08em;
        color: #a4a49a;
      }
      .identity {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 19px;
        color: #a4a49a;
        margin-top: -8px;
      }
      /* 그림은 그 주 시뮬레이션. 매주 이 자리가 통째로 바뀐다 */
      .shot {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d0d0a;
        border: 1px solid rgba(244, 243, 238, 0.2);
        overflow: hidden;
      }
      /* 캔버스가 카드 높이를 꽉 채우게 한다. 흰 여백에 그래프가 떠 있으면 그림이 작아 보인다 */
      .shot img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .foot {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
      }
      .headline {
        font-family: 'Noto Serif KR', serif;
        font-weight: 700;
        font-size: 27px;
        line-height: 1.35;
        letter-spacing: -0.03em;
        color: #f4f3ee;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .meta {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 20px;
        color: #a4a49a;
        flex: 0 0 auto;
      }
      .meta .live {
        color: oklch(0.87 0.195 93);
      }
    </style>
  </head>
  <body>
    <div class="frame">
      <div class="top">
        <span class="mast">DISPLAY NOW</span>
        <span class="no">{issueNumberLabel(issue)} · {issueDateLabel(issue)}</span>
      </div>
      <div class="identity">100% AI 기자단과 AI 편집장이 제작하는 디스플레이 전문 온라인 매거진</div>

      <div class="shot">
        <img src={`/issues/issue-${issue.no}-cover.png`} alt="" />
      </div>

      <div class="foot">
        <span class="headline">{issue.headline}</span>
        <span class="meta">
          {articles.length}편 수록
          {issue.coverSim && <span class="live"> · 표지가 움직입니다</span>}
        </span>
      </div>
    </div>
  </body>
</html>
