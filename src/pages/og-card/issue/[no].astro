---
export const prerender = true;
import {
  ISSUES,
  articlesOfIssue,
  issueNumberLabel,
  issueDateLabel,
  collectRangeLabel,
  SHOW_PUBLISH_DATE,
  type IssueMeta,
} from '../../../lib/issues';
import { SECTIONS, sectionColor } from '../../../lib/sections';
import { bylineOf } from '../../../lib/articles';

export async function getStaticPaths() {
  return ISSUES.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

interface Props {
  issue: IssueMeta;
}

const { issue } = Astro.props;
const articles = await articlesOfIssue(issue);
const head = articles.find((a) => a.slug === issue.headSlug) ?? articles[0];
// 표지에 헤드 기사가 실리므로 오른쪽에는 나머지 수록 기사를 전부 세운다.
// 활자는 작게 간다. 기사 제목이 제호보다 커지면 표지의 활자 위계가 뒤집힌다.
const picks = articles.filter((a) => a.slug !== head?.slug);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og-card-issue</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;600&family=Noto+Serif+KR:wght@700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      /* 공유 카드는 가로 1200x630 규격이 고정이다.
         세로 표지를 왼쪽에 그대로 세우고 오른쪽에 커버라인을 두어
         "잡지를 펼쳐 놓은" 모양으로 만든다 */
      html,
      body {
        width: 1200px;
        height: 630px;
        background: #12120e;
      }
      .card {
        width: 1200px;
        height: 630px;
        display: flex;
        color: #f4f3ee;
      }

      /* 왼쪽: 표지 실물. 표지가 2:3이므로 폭 420이면 높이가 정확히 630이 되어
         잘리는 곳 없이 통째로 들어간다 */
      .poster {
        flex: 0 0 420px;
        height: 630px;
        overflow: hidden;
        border-right: 1px solid rgba(244, 243, 238, 0.25);
        background: #12120e;
      }
      .poster img {
        width: 420px;
        height: 630px;
        display: block;
      }

      /* 오른쪽: 이번 호 안내 */
      .side {
        flex: 1 1 auto;
        min-width: 0;
        padding: 34px 40px 28px;
        display: flex;
        flex-direction: column;
      }
      .issue-line {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 19px;
        letter-spacing: 0.08em;
        color: #a4a49a;
      }
      /* 사이트의 기사 카드를 그대로 옮긴다. 꼭지 · 바이라인 · 제목 · 요약.
         활자는 작게 간다. 제목이 제호보다 커지면 표지의 활자 위계가 무너진다 */
      .picks-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 15px;
        letter-spacing: 0.12em;
        color: #8a8a80;
        margin-top: 18px;
      }
      /* 넘치면 하단 발행 정보가 밀려 사라진다. 목록에만 넘침을 가둔다 */
      .picks {
        list-style: none;
        margin-top: 6px;
        flex: 0 1 auto;
        min-height: 0;
        overflow: hidden;
      }
      .picks li {
        padding: 6px 0;
        border-bottom: 1px solid rgba(244, 243, 238, 0.14);
      }
      .meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12.5px;
      }
      .chip {
        color: #f4f3ee;
        padding: 2px 7px;
        flex: 0 0 auto;
      }
      .byline {
        color: #8a8a80;
      }
      .t {
        font-family: 'IBM Plex Sans KR', sans-serif;
        font-weight: 600;
        font-size: 17.5px;
        line-height: 1.28;
        letter-spacing: -0.02em;
        color: #f4f3ee;
        margin-top: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sum {
        font-family: 'IBM Plex Sans KR', sans-serif;
        font-size: 13px;
        line-height: 1.45;
        color: #a4a49a;
        margin-top: 3px;
        word-break: keep-all;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .foot {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 17px;
        letter-spacing: 0.06em;
        color: #8a8a80;
        margin-top: auto;
        border-top: 1px solid rgba(244, 243, 238, 0.25);
        padding-top: 12px;
      }
      .foot .live {
        color: oklch(0.87 0.195 93);
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="poster">
        <img src={`/issues/issue-${issue.no}-poster.png`} alt="" />
      </div>

      <div class="side">
        <div class="issue-line">
          {issueNumberLabel(issue)} · {collectRangeLabel(issue)}
          {SHOW_PUBLISH_DATE && <> · {issueDateLabel(issue)}</>} · {articles.length}편 수록
        </div>

        <div class="picks-label">이번 호 수록</div>
        <ul class="picks">
          {
            picks.map((a) => (
              <li>
                <div class="meta-row">
                  <span class="chip" style={`background:${sectionColor(a.data.section, 0.42)};`}>
                    {SECTIONS[a.data.section].label}
                  </span>
                  <span class="byline">{bylineOf(a)}</span>
                </div>
                <div class="t">{a.data.title}</div>
                <p class="sum">{a.data.summary}</p>
              </li>
            ))
          }
        </ul>

        <div class="foot">
          발행 Next I/O{issue.coverSim && <span class="live"> · 표지는 시뮬레이션입니다</span>}
          <span class="site">display-now.nextio.ai.kr</span>
        </div>
      </div>
    </div>
  </body>
</html>
