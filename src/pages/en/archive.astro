---
/**
 * 영문 아카이브.
 *
 * **홈에서 전체 목록을 떼어내 여기로 옮긴 면이다.** 종전에는 `/en` 한 장이 홈이자
 * 아카이브라 발행분 전체가 랜딩 페이지에 실렸는데, 호가 쌓이면 첫 화면이 목록에
 * 잠식된다(2026-09-05 대표 지적). 한글 홈처럼 홈은 최신 8편에서 끊고 전체는 여기로 온다.
 *
 * 한글 아카이브(`pages/archive.astro`)와 **일부러 다른 것 둘**:
 *  ① 기간 필터 — 영문 발행분이 아직 한 구간에 몰려 있어 칸이 채워지지 않는다.
 *  ② 태그 구름 — 태그가 한글 낱말이다(`금주의핫이슈`·`지문센서`). 영문 면에 한글
 *    칩을 세우느니 빼는 편이 낫다. 태그를 영문화하면 그때 되살린다.
 * 검색·꼭지 필터·정렬은 같다. 검수 때 「빠진 것」과 「빠뜨린 것」을 가르려고 여기 적어 둔다.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../../lib/sections';
import { getPublishedArticles, dateLabel, bylineOf, articleHref } from '../../lib/articles';

const articles = await getPublishedArticles('en');
---

<Base title="Archive | DISPLAY NOW" lang="en" altHref="/archive">
  <div class="frame">
    <Header lang="en" activeSection="archive" altHref="/archive" />
    <div class="accent-strip">
      <span style={`background:${sectionColor('tech-note')};`}></span>
      <span style={`background:${sectionColor('paper')};`}></span>
      <span style={`background:${sectionColor('patent')};`}></span>
      <span style={`background:${sectionColor('issue')};`}></span>
    </div>

    <section class="archive-hero">
      <div class="eyebrow">ARCHIVE</div>
      <h1>Every article we have published, in one place</h1>

      <div class="search-box">
        <input type="search" id="q" placeholder="Search by company, technology or title (e.g. BOE Gen 8.6)" />
        <button type="button" id="clear-btn">Clear</button>
      </div>
    </section>

    <div class="content-pad">
      <div class="filter-grid">
        <div class="filter-label">Section</div>
        <div class="chip-row" id="section-chips">
          <button type="button" class="chip active" data-section="all" style="border-color:#12120e; background:#12120e; color:#f4f3ee;">All {articles.length}</button>
          {
            SECTION_ORDER.map((key) => (
              <button type="button" class="chip" data-section={key} style={`--chip-color:${sectionColor(key)};`}>{SECTIONS[key].labelEn}</button>
            ))
          }
        </div>
      </div>

      <div class="result-bar">
        <div class="result-label" id="result-label">All {articles.length} · newest first</div>
        <div class="chip-row">
          <button type="button" class="chip sort active" data-sort="newest">Newest</button>
          <button type="button" class="chip sort" data-sort="oldest">Oldest</button>
        </div>
      </div>

      <div id="results" class="results">
        {
          articles.map((a) => (
            <a
              href={articleHref(a)}
              class="result-row"
              style={`border-left-color:${sectionColor(a.data.section)};`}
              data-title={a.data.title.toLowerCase()}
              data-summary={a.data.summary.toLowerCase()}
              data-section={a.data.section}
              data-date={a.data.publishedAt.toISOString()}
            >
              <div class="result-main">
                <div class="result-meta">
                  <span class="chip-tag" style={`background:${sectionColor(a.data.section)};`}>{SECTIONS[a.data.section].labelEn}</span>
                  <span class="byline">{bylineOf(a)}</span>
                </div>
                <div class="result-title">{a.data.title}</div>
                <p class="result-summary">{a.data.summary}</p>
              </div>
              <div class="result-side">
                <span>{dateLabel(a, 'short')}</span>
                <span>{a.data.readingMinutes} min</span>
              </div>
            </a>
          ))
        }
      </div>

      <div id="empty-state" class="empty-state" hidden>
        <div class="empty-title">Nothing matches those filters</div>
        <p>Try a shorter search term, or clear the section filter. If the subject you are after is not here yet, tell us and we will cover it.</p>
        <div class="empty-actions">
          <button type="button" id="reset-btn">Clear all filters</button>
          <a href="mailto:info@nextio.ai.kr">Suggest a subject</a>
        </div>
      </div>
    </div>

    <Footer lang="en" />
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-btn')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const results = Array.from(document.querySelectorAll<HTMLAnchorElement>('.result-row'));
  const resultLabel = document.getElementById('result-label')!;
  const emptyState = document.getElementById('empty-state')!;
  const resultsWrap = document.getElementById('results')!;

  const state = { query: '', section: 'all', sort: 'newest' };

  function setActive(container: Element | null, attr: string, value: string) {
    container?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.classList.toggle('active', b.dataset[attr] === value);
    });
  }

  function apply() {
    const q1 = state.query.trim().toLowerCase();
    const visible = results.filter((row) => {
      if (state.section !== 'all' && row.dataset.section !== state.section) return false;
      if (q1 && !`${row.dataset.title} ${row.dataset.summary}`.includes(q1)) return false;
      return true;
    });

    visible.sort((a, b) => {
      const diff = new Date(b.dataset.date!).valueOf() - new Date(a.dataset.date!).valueOf();
      return state.sort === 'oldest' ? -diff : diff;
    });

    results.forEach((r) => (r.hidden = true));
    visible.forEach((r) => {
      r.hidden = false;
      resultsWrap.appendChild(r);
    });

    const filtered = !!q1 || state.section !== 'all';
    resultLabel.textContent = filtered
      ? `${visible.length} result${visible.length === 1 ? '' : 's'}`
      : `All ${visible.length} · ${state.sort === 'oldest' ? 'oldest first' : 'newest first'}`;

    emptyState.hidden = visible.length > 0;
    resultsWrap.hidden = visible.length === 0;
  }

  q?.addEventListener('input', () => {
    state.query = q.value;
    apply();
  });
  clearBtn.addEventListener('click', () => {
    state.query = '';
    q.value = '';
    apply();
  });
  resetBtn.addEventListener('click', () => {
    state.query = '';
    state.section = 'all';
    q.value = '';
    setActive(document.getElementById('section-chips'), 'section', 'all');
    apply();
  });

  document.querySelectorAll<HTMLButtonElement>('#section-chips .chip').forEach((b) => {
    b.addEventListener('click', () => {
      state.section = b.dataset.section!;
      setActive(document.getElementById('section-chips'), 'section', state.section);
      apply();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.chip.sort').forEach((b) => {
    b.addEventListener('click', () => {
      state.sort = b.dataset.sort!;
      document.querySelectorAll('.chip.sort').forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      apply();
    });
  });

  // 홈의 꼭지 카드와 헤더 꼭지 칩이 `?section=` 을 달고 온다.
  // 영문에는 꼭지 낱장이 없어 이 면이 그 자리를 겸한다.
  const wanted = new URLSearchParams(location.search).get('section');
  if (wanted && document.querySelector(`#section-chips .chip[data-section="${wanted}"]`)) {
    state.section = wanted;
    setActive(document.getElementById('section-chips'), 'section', wanted);
  }

  apply();
</script>

<style>
  /* 한글 아카이브(`pages/archive.astro`)와 같은 판이다. 시각을 갈라 둘 이유가 없어
     스타일 블록을 그대로 가져왔다. 기간·태그 칩 규칙도 함께 들어 있는데,
     그 둘을 되살릴 때 스타일까지 다시 옮기지 않아도 되도록 남겨 둔다. */
  .archive-hero {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(22px, 5vw, 32px) clamp(14px, 4vw, 32px);
  }
  .archive-hero .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: #8c8c82;
  }
  .archive-hero h1 {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(24px, 4.6vw, 34px);
    line-height: 1.32;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .search-box {
    display: flex;
    align-items: center;
    margin-top: 20px;
    max-width: 720px;
    border: 1px solid var(--line-dark);
    background: #1c1c17;
  }
  .search-box input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    padding: 14px 16px;
    border: none;
    background: transparent;
    color: var(--on-dark);
    outline: none;
  }
  .search-box button {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 14px;
    color: #9a9a90;
    background: transparent;
    border: none;
    padding: 14px 16px;
    cursor: pointer;
  }
  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: #8c8c82;
  }
  .suggest-btn {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #c4c4bc;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-dark);
    padding: 0 0 2px;
    cursor: pointer;
  }
  .content-pad {
    padding: 18px clamp(14px, 4vw, 24px) 28px;
  }
  .filter-grid {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 10px 14px;
    align-items: start;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--meta-soft);
    padding-top: 5px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 5px 11px;
    border: 1px solid var(--line-frame);
    background: var(--card);
    color: #45453d;
    cursor: pointer;
    white-space: nowrap;
  }
  .chip.active {
    border-color: var(--chip-color, var(--ink));
    background: var(--chip-color, var(--ink));
    color: var(--card);
  }
  .chip.dashed {
    border-style: dashed;
    color: var(--meta-soft);
    background: transparent;
  }
  .result-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 0 10px;
  }
  .result-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
  }
  .results {
    border-top: 1px solid var(--ink);
  }
  .result-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    border-left: 4px solid;
    background: var(--card);
    align-items: start;
  }
  .result-row[hidden] {
    display: none;
  }
  .result-main {
    flex: 1 1 300px;
    min-width: 0;
  }
  .result-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .chip-tag {
    color: var(--card);
    padding: 3px 8px;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .byline {
    color: var(--meta);
  }
  .result-title {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2.1vw, 21px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.4;
    margin-top: 8px;
    word-break: keep-all;
  }
  .result-summary {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: #4d4d45;
    word-break: keep-all;
  }
  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .result-tags .tag {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    border: 1px solid var(--line);
    background: var(--card);
    padding: 2px 8px;
  }
  .result-side {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    justify-content: flex-end;
    min-width: 108px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    line-height: 1.8;
  }
  .empty-state {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 44px 24px;
    text-align: center;
  }
  .empty-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .empty-state p {
    margin: 10px auto 0;
    font-size: 15px;
    line-height: 1.7;
    color: #55554d;
    max-width: 46ch;
    word-break: keep-all;
  }
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 18px;
  }
  .empty-actions button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--on-dark);
    background: var(--ink);
    border: none;
    padding: 10px 18px;
    cursor: pointer;
  }
  .empty-actions a {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--ink);
    padding: 10px 18px;
  }
</style>
