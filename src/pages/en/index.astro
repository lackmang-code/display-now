---
import Base from '../../layouts/Base.astro';
import HomeDesktop from '../../components/HomeDesktop.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../../lib/sections';
import { getPublishedArticles, baseSlug } from '../../lib/articles';
import { getIssuesEn, articlesOfIssue } from '../../lib/issues';
import { resolvePicks } from '../../lib/picks';

/*
 * 영문 홈은 **한글 홈과 같은 컴포넌트(HomeDesktop)를 쓴다.**
 * 종전에는 여기에 별도 지면이 있었고, 그 결과 이번 호 배너·꼭지 카드·편집국 추천·광고가
 * 영문에만 통째로 없었다. 구조를 따로 두면 한글을 고칠 때마다 영문이 뒤처진다.
 *
 * 그 아래에 **꼭지별 전체 목록**을 이어 붙인다. 영문 쪽은 아직 꼭지 낱장도 아카이브도
 * 없어서 이 목록이 그 두 면을 겸한다. 홈의 꼭지 카드가 여기 `#sec-*` 앵커로 내려온다.
 *
 * 모바일 전용 지면(HomeMobile)은 한글만 있다. 영문은 HomeDesktop 한 벌이 좁은 폭에서
 * 그대로 접히게 둔다 — 주 6편이라 표지형 지면을 따로 유지할 만큼 분량이 없다.
 */
const articles = await getPublishedArticles('en');
const bySection = SECTION_ORDER.map((key) => ({
  key,
  meta: SECTIONS[key],
  items: articles.filter((a) => a.data.section === key),
})).filter((g) => g.items.length > 0);

// 이번 호. `headlineEn`이 있는 호만 getIssuesEn()에 들어온다.
const latestIssue = getIssuesEn()[0];
const latestIssueCount = latestIssue ? (await articlesOfIssue(latestIssue, 'en')).length : 0;

// 배너가 헤드 기사 제목을 그대로 싣는 호에서는 그 기사를 목록에서 뺀다(한글 홈과 같은 규칙).
// 영문판 slug는 `en/` 접두사가 붙으므로 `baseSlug`로 맞춘다.
const _head0 = latestIssue?.headSlug
  ? articles.find((a) => baseSlug(a) === latestIssue.headSlug)
  : undefined;
const bannerHeadSlug =
  _head0 && latestIssue?.headlineEn?.trim() === _head0.data.title.trim() ? _head0.slug : undefined;
const recentArticles = articles.filter((a) => a.slug !== bannerHeadSlug).slice(0, 8);

const shownSlugs = new Set<string>(recentArticles.map((a) => a.slug));
if (bannerHeadSlug) shownSlugs.add(bannerHeadSlug);
const editorPicks = resolvePicks(articles, shownSlugs);
---

<Base title="DISPLAY NOW" lang="en" altHref="/">
  <HomeDesktop
    lang="en"
    allArticles={articles}
    recentArticles={recentArticles}
    editorPicks={editorPicks}
    latestIssue={latestIssue}
    latestIssueCount={latestIssueCount}
  >
    {
      articles.length === 0 ? (
        <p class="empty">The English edition begins with Issue 4.</p>
      ) : (
        bySection.map((g) => (
          <section class="sec" id={`sec-${g.key}`}>
            <div class="sec-head" style={`border-color:${sectionColor(g.key)};`}>
              <span class="sec-chip" style={`background:${sectionColor(g.key)};`}>
                {g.meta.labelEn}
              </span>
              <span class="sec-count">{g.items.length}</span>
            </div>
            <div class="sec-grid">
              {g.items.map((a) => (
                <ArticleCard article={a} />
              ))}
            </div>
          </section>
        ))
      )
    }

    {/* 한글 홈의 SubscribeCTA 자리. `/subscribe`의 영문 짝이 아직 없어 여기가 그 역할을 겸한다 */}
    <section class="subscribe" id="subscribe">
      <div>
        <div class="sub-head">Every Tuesday, the week in display — as one issue.</div>
        <p class="sub-note">A free newsletter. Unsubscribe any time.</p>
      </div>
      <form id="en-subscribe-form">
        <input type="email" name="email" placeholder="Email address" required />
        <button type="submit">Subscribe</button>
      </form>
      <p class="sub-status" id="en-subscribe-status" hidden></p>
    </section>

    <Footer lang="en" />
  </HomeDesktop>
</Base>

<script>
  // 하단 구독 폼. 사이드바 폼(HomeDesktop)과 id가 겹치지 않게 따로 둔다.
  const form = document.getElementById('en-subscribe-form');
  const statusEl = document.getElementById('en-subscribe-status');

  function show(text: string) {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.textContent = text;
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.elements.namedItem('email');
      const email = input instanceof HTMLInputElement ? input.value.trim() : '';
      const btn = form.querySelector('button');
      const reset = () => {
        if (btn instanceof HTMLButtonElement) {
          btn.disabled = false;
          btn.textContent = 'Subscribe';
        }
      };
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = true;
        btn.textContent = 'Sending...';
      }
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'en-home' }),
        });
        const data = await res.json();
        if (data.ok) {
          form.hidden = true;
          show('You are subscribed. Thank you!');
        } else {
          show('Please check the email address.');
          reset();
        }
      } catch {
        show('Something went wrong. Please try again in a moment.');
        reset();
      }
    });
  }
</script>

<style>
  .sec {
    padding: clamp(22px, 5vw, 34px) clamp(16px, 5vw, 42px);
    border-top: 1px solid var(--line);
  }
  .sec-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 9px;
    border-bottom: 2px solid;
    margin-bottom: 18px;
  }
  .sec-chip {
    color: var(--card);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    padding: 3px 9px;
  }
  .sec-count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--meta-soft);
  }
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }

  .empty {
    padding: clamp(40px, 9vw, 80px) clamp(16px, 5vw, 42px);
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--meta-soft);
    border-top: 1px solid var(--line);
  }

  .subscribe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding: clamp(22px, 5vw, 32px) clamp(16px, 5vw, 42px);
    border-top: 1px solid var(--line);
    background: var(--card-warm);
  }
  .subscribe > div {
    flex: 1 1 320px;
    min-width: 0;
  }
  .sub-head {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .sub-note {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-faint);
  }
  .subscribe form {
    display: flex;
    gap: 8px;
    flex: 0 1 auto;
  }
  .subscribe form[hidden] {
    display: none;
  }
  .subscribe input {
    padding: 9px 12px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: 14px;
    min-width: 200px;
  }
  .subscribe button {
    padding: 9px 18px;
    border: none;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 14px;
    cursor: pointer;
  }
  .sub-status {
    flex: 1 1 100%;
    margin: 0;
    font-size: 14px;
    color: var(--meta);
  }
</style>
