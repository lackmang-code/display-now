---
/**
 * 모바일 개조 시안 A — 표지형 뼈대 + 얇은 2층 내비.
 *
 * 발행물이 아니다. 사이트 어디에서도 링크되지 않고 사이트맵에도 없으며 noindex다.
 * 대표가 폰으로 직접 눌러 보기 위한 페이지이고, 방향이 확정되면 이 파일은 지운다.
 *
 * 확정된 전제 (2026-08-25 대표 승인)
 *  - 내비는 기사 · 지난호 · 아카이브 · 편집국 넷만. "기사"는 꼭지로, "지난호"는 호수로 풀다운
 *  - 402px에서 제호(144) + 구독(84)이 먼저 먹어 내비에 110px만 남는다. 한 줄에 못 넣는다
 *    → 1층 제호·구독 / 2층 내비의 2층 구조. Works in Progress·The Verge가 같은 구조다
 *  - 홈은 표지 → 이번 호 목차에서 끝낸다. 기사 스트림을 잇지 않는다.
 *    지난 호 책장은 넣었다가 뺐다 — 내비 풀다운과 중복이었다(같은 날 대표 지적)
 */
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import SimBoot from '../../components/SimBoot.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../../lib/sections';
import { bylineOf, articleHref, readingLabel, leadImage } from '../../lib/articles';
import {
  getIssues,
  articlesOfIssue,
  issueNumberLabel,
  collectRangeLabel,
} from '../../lib/issues';
import { getPublishedArticles } from '../../lib/articles';
import { topicIndex } from '../../lib/tags';

// 아카이브 풀다운에 실제 숫자를 넣는다. "전체 기사"만 적혀 있으면 눌러 볼 이유가 없다.
const published = await getPublishedArticles();
const topics = topicIndex(published);
// 기사가 많은 주제부터 여섯 개만 칩으로 깐다. 열여덟 개를 다 늘어놓으면 풀다운이 아니라 목록이 된다.
const topTopics = topics.slice(0, 6);

const issues = getIssues();
const current = issues[0];
const articles = await articlesOfIssue(current);
const head = current.headSlug ? articles.find((a) => a.slug === current.headSlug) : articles[0];
const coverlines = articles.filter((a) => a.slug !== head?.slug).slice(0, 4);
// 시뮬레이터가 없는 주의 표지. 지정 이미지가 없으면 헤드 기사의 첫 그림을 쓴다.
const coverFallback = current.coverImage ?? (head ? leadImage(head) : undefined);

// 주간지라 1년이면 52호가 된다. 풀다운에 전부 넣을 수 없으므로 최근 여덟 호까지만
// 담고 나머지는 "전체 호 목록"이 받는다.
const navIssues = issues.slice(0, 8);
---

<Base title="[시안] 모바일 표지형 A | DISPLAY NOW" noindex={true}>
  <div class="proto">
    <!-- ══════════ 1층 ══════════ -->
    <div class="bar1">
      <a href="/preview/mobile-a" class="mast">
        <img class="mast-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
        <span>DISPLAY NOW</span>
      </a>
      <a class="sub" href="/subscribe">구독</a>
    </div>

    <!-- ══════════ 2층 — 스크롤하면 이 줄만 위에 붙는다 ══════════ -->
    <nav class="bar2" id="dnnav">
      <details name="dnnav" class="dd">
        <summary>기사<i class="car"></i></summary>
        <div class="panel">
          {
            SECTION_ORDER.map((key) => (
              <a class="prow" href={`/section/${key}`}>
                <span class="dot" style={`background:${sectionColor(key)};`} />
                <span class="ptxt inline">
                  <b>{SECTIONS[key].label}</b>
                  <em>{SECTIONS[key].labelEn}</em>
                </span>
              </a>
            ))
          }
        </div>
      </details>

      <details name="dnnav" class="dd">
        <summary>지난호<i class="car"></i></summary>
        <div class="panel">
          {
            navIssues.map((i) => (
              <a class="prow" href={`/issue/${i.no}`}>
                <span class="ino">{i.no}호</span>
                <span class="ihead">{i.headline}</span>
              </a>
            ))
          }
          <a class="prow all" href="/issue">전체 호 목록 →</a>
        </div>
      </details>

      {/*
        아카이브·편집국도 풀다운으로 통일한다. 넷 중 둘만 바로 넘어가면 누르기 전에
        무엇이 나올지 예측이 안 된다(2026-08-25 대표 지적). 둘을 하나로 묶는 안도 검토했으나
        "읽을 것을 찾는 곳"과 "누가 만드는가"는 성격이 달라 묶으면 "더보기" 같은 라벨밖에
        나오지 않는다. 통일하는 편이 낫고, 덤으로 상단에서 갈 길이 없던
        주제별·제보·광고 문의가 여기서 살아난다.
      */}
      <details name="dnnav" class="dd">
        <summary>아카이브<i class="car"></i></summary>
        <div class="panel">
          <a class="prow" href="/archive">
            <span class="ptxt"><b>전체 기사</b><em>제목 · 기업명으로 검색</em></span>
            <span class="cnt">{published.length}편</span>
          </a>
          <a class="prow" href="/tag">
            <span class="ptxt"><b>주제별</b><em>기술 · 기업 단위로 묶어 보기</em></span>
            <span class="cnt">{topics.length}개</span>
          </a>
          <div class="chips">
            {topTopics.map((g) => (
              <a class="chip" href={`/tag/${g.topic.slug}`}>
                {g.topic.label}<i>{g.articles.length}</i>
              </a>
            ))}
          </div>
        </div>
      </details>

      <details name="dnnav" class="dd">
        <summary>편집국<i class="car"></i></summary>
        <div class="panel">
          <a class="prow" href="/editorial">
            <span class="ptxt"><b>편집국 소개</b><em>AI 기자 4인과 AI 편집장</em></span>
          </a>
          <a class="prow" href="/board?kind=%EC%A0%95%EC%A0%95%20%EC%9A%94%EC%B2%AD">
            <span class="ptxt"><b>정정 및 제보</b><em>수치가 틀렸다면 알려 주십시오</em></span>
          </a>
          <a class="prow" href="/board?kind=%EA%B4%91%EA%B3%A0%20%EB%AC%B8%EC%9D%98">
            <span class="ptxt"><b>광고 문의</b><em>지면 · 제휴 문의</em></span>
          </a>
        </div>
      </details>
    </nav>

    <!-- ══════════ 표지 ══════════ -->
    <section class="cover">
      <div class="cno">{issueNumberLabel(current)} · {collectRangeLabel(current)}</div>

      {/*
        시뮬레이터가 하나도 없는 주에는 헤드 기사의 첫 이미지를 표지로 쓴다(CLAIM.md 규정).
        처음엔 coverSim만 그렸는데, 그러면 그런 주에 빈 흰 상자가 뜬다.
        호 페이지에는 이 폴백이 이미 있었고 시안이 빠뜨린 것이다.
      */}
      <div class="stage">
        {
          current.coverSim ? (
            <div
              class="cover-sim"
              data-sim={current.coverSim}
              style={head ? `--section-color:${sectionColor(head.data.section)};` : undefined}
            />
          ) : coverFallback ? (
            <img class="cover-img" src={coverFallback} alt={`제${current.no}호 표지`} />
          ) : (
            <p class="cover-none">표지 준비 중입니다.</p>
          )
        }
      </div>

      <h1>{current.headline}</h1>
      {current.deck && <p class="deck">{current.deck}</p>}

      <ul class="clines">
        {
          coverlines.map((a) => (
            <li>
              <span class="dot" style={`background:${sectionColor(a.data.section)};`} />
              <a href={articleHref(a)}>{a.data.title}</a>
            </li>
          ))
        }
      </ul>

      {current.coverSim && <p class="hint">이 표지는 시뮬레이션입니다. 값을 바꿔 보십시오.</p>}
    </section>

    <!-- ══════════ 이번 호 목차 ══════════ -->
    <section class="toc">
      <div class="secline"><span>이번 호</span><em>{articles.length}편</em></div>
      {
        articles.map((a) => (
          <a class="trow" href={articleHref(a)} style={`border-left-color:${sectionColor(a.data.section)};`}>
            <div class="tband" style={`color:${sectionColor(a.data.section, 0.72)};`}>
              {SECTIONS[a.data.section].label}
            </div>
            <div class="ttitle">{a.data.title}</div>
            <div class="tmeta">{bylineOf(a)} · 읽기 {readingLabel(a)}</div>
          </a>
        ))
      }
    </section>

    {/*
      표지 아래에 지난 호 책장을 깔았다가 뺐다(2026-08-25 대표 지적).
      내비 "지난호" 풀다운을 만들면서 지난 호로 가는 길이 세 군데가 됐다 —
      풀다운 · 이 책장 · 푸터의 주간호. 표지형의 핵심은 "이번 한 권"인데
      끝에 다른 호가 또 깔리면 그게 흐려진다. 표지를 책처럼 세우는 화면은
      /issue 호 목록에 이미 있으므로 그쪽이 제자리다.
      대신 한 권이 끝났다는 표시로 조용한 줄 하나만 남긴다.
    */}
    <div class="endline">
      <span>제{current.no}호 끝</span>
    </div>

    <Footer />
  </div>
</Base>

<SimBoot />

<script>
  // <details name> 하나로도 서로 배타적으로 열리지만, 바깥을 눌렀을 때와 Esc는 직접 닫는다.
  const nav = document.getElementById('dnnav');
  if (nav) {
    const close = () => nav.querySelectorAll('details[open]').forEach((d) => d.removeAttribute('open'));
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    // name 속성을 지원하지 않는 브라우저 대비 — 하나를 열면 나머지를 닫는다
    nav.querySelectorAll('details').forEach((d) => {
      d.addEventListener('toggle', () => {
        if (!d.open) return;
        nav.querySelectorAll('details').forEach((o) => {
          if (o !== d) o.removeAttribute('open');
        });
      });
    });
  }
</script>

<style is:global>
  /* 표지에서는 시뮬레이터의 제목 띠와 고지를 접는다. 표지는 한 장으로 읽혀야 한다. */
  .proto .stage .sim-embed {
    border: 0;
    margin: 0;
    background: transparent;
  }
  .proto .stage .sim-head,
  .proto .stage .sim-note {
    display: none;
  }

  /* 슬라이더가 OS 기본 파랑이라 검정·골드 지면에서 혼자 튀었다. 꼭지색으로 맞춘다 —
     골드보다 낫다. 슬라이더가 흰 판 위에 있어 골드는 대비가 약하고,
     꼭지색은 이 사이트가 이미 쓰는 언어라 어느 기사에 붙어도 저절로 맞는다.
     손잡이는 손가락으로 집을 수 있게 키운다(ciechanow.ski 실측 약 28px).
     ※ 승인 전이라 시안 안에서만 적용한다. sim.css는 건드리지 않았다. */
  .proto .sim-control input[type='range'] {
    accent-color: var(--section-color, var(--ink));
    height: 28px;
  }

  /* 표지는 한 칸짜리로 세운다. 기본 sim-body는 캔버스와 조작부를 가로로 붙이는데,
     캔버스가 302px 고정이라 카드가 490px가 되는 순간(520px 프레임·태블릿·데스크톱)
     조작부가 아래로 밀리면서 캔버스 오른쪽에 흰 여백이 157px 남았다.
     캔버스를 카드 폭에 맞춰 늘리고 조작부를 그 아래 전폭으로 둔다.

     플렉스를 유지한 채 flex-basis:100%만 주면 안 된다. basis는 가로축에만 걸리므로
     래퍼 높이가 캔버스의 원래 크기(212px)에 머무는데 늘어난 캔버스는 235px가 되어
     23px가 삐져나오고 첫 슬라이더 라벨을 덮었다. 블록으로 세우면 이 순환이 없다. */
  .proto .stage .sim-body {
    display: block;
    padding: 0;
  }
  .proto .stage .sim-canvas-wrap {
    margin-bottom: 16px;
  }
  .proto .stage .sim-canvas-wrap canvas {
    width: 100%;
    height: auto;
  }
</style>

<style>
  .proto {
    width: min(520px, 100%);
    margin: 0 auto;
    background: var(--ink);
    color: var(--on-dark);
    min-height: 100svh;
  }

  /* ─────────── 1층 ─────────── */
  .bar1 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 15px 9px;
    background: var(--ink);
  }
  .mast {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--gold);
    text-decoration: none;
    min-width: 0;
  }
  .mast-mark {
    height: 0.8em;
    width: auto;
    flex: 0 0 auto;
  }
  /* 부제를 제호 밑에서 뺐다. 두 줄짜리 부제가 제호(29px)보다 높이 54px로 커져
     부제가 매체 이름처럼 읽혔다(대표 지적 4번). 문구는 편집국 페이지와 푸터에 남아 있다. */
  .sub {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 6px 11px;
    text-decoration: none;
    border-radius: 2px;
  }

  /* ─────────── 2층 ─────────── */
  .bar2 {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--ink);
    border-top: 1px solid rgba(244, 243, 238, 0.16);
    border-bottom: 1px solid rgba(244, 243, 238, 0.16);
  }
  /* details를 static으로 둬야 패널이 .bar2 전체 폭에 걸린다 */
  .dd {
    position: static;
    flex: 0 0 auto;
  }
  .bar2 summary,
  .bar2 .flat {
    /* 시각적으로는 얇게, 손가락 대는 자리는 42px를 확보한다 */
    display: flex;
    align-items: center;
    gap: 4px;
    height: 42px;
    padding: 0 13px;
    font-size: 13.5px;
    letter-spacing: 0.02em;
    color: var(--on-dark);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .bar2 summary::-webkit-details-marker {
    display: none;
  }
  /* 320px에서 네 항목 합이 296px, 남는 폭이 9px뿐이었다. 글꼴을 키워 쓰는 사람에게는
     그대로 넘친다. 좁은 화면에서는 좌우 여백을 줄여 여유를 32px 더 만든다.
     터치 높이 42px는 건드리지 않는다. */
  @media (max-width: 360px) {
    .bar2 summary,
    .bar2 .flat {
      padding: 0 9px;
      font-size: 13px;
    }
  }
  .car {
    width: 0;
    height: 0;
    border-left: 3.5px solid transparent;
    border-right: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    opacity: 0.6;
    transition: transform 0.15s;
  }
  .dd[open] summary {
    color: var(--gold);
    background: rgba(244, 243, 238, 0.07);
  }
  .dd[open] .car {
    transform: rotate(180deg);
    opacity: 1;
  }

  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #14140f;
    border-bottom: 1px solid var(--gold);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.55);
    max-height: 62svh;
    overflow-y: auto;
  }
  .prow {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 9px 16px;
    border-top: 1px solid rgba(244, 243, 238, 0.09);
    color: var(--on-dark);
    text-decoration: none;
  }
  .prow:first-child {
    border-top: 0;
  }
  .prow .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  /* 기본은 두 줄. 제목 아래에 그 항목이 무엇인지 한 줄로 붙는다 —
     눌러 보기 전에 무엇이 나올지 알 수 있어야 풀다운을 다는 의미가 있다. */
  .ptxt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  /* 꼭지는 한글·영문 라벨이 짝이라 한 줄에 나란히 둔다 */
  .ptxt.inline {
    flex-direction: row;
    align-items: baseline;
    gap: 8px;
  }
  .ptxt b {
    font-size: 15px;
    font-weight: 600;
  }
  .ptxt em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--on-dark-mute);
    word-break: keep-all;
  }
  .ptxt.inline em {
    font-size: 11px;
    letter-spacing: 0.09em;
  }
  .cnt {
    margin-left: auto;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold);
  }

  /* 자주 다룬 주제를 칩으로 깐다. 열여덟 개를 다 늘어놓으면 풀다운이 아니라 목록이 된다 */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 11px 16px 14px;
    border-top: 1px solid rgba(244, 243, 238, 0.09);
  }
  /* 칩 높이가 31px이라 손가락으로 집기에 작았다. 최소 44px로 올린다 */
  .chips .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    font-size: 12.5px;
    line-height: 1;
    padding: 8px 11px;
    border: 1px solid rgba(244, 243, 238, 0.2);
    color: var(--on-dark);
    text-decoration: none;
    border-radius: 2px;
    word-break: keep-all;
  }
  .chips .chip i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--on-dark-mute);
  }
  .ino {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--gold);
    width: 30px;
  }
  .ihead {
    font-size: 14px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .prow.all {
    justify-content: flex-end;
