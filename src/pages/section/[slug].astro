---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../../lib/sections';
import { getArticlesBySection, dateLabel, articleHref } from '../../lib/articles';

export function getStaticPaths() {
  return SECTION_ORDER.map((key) => ({ params: { slug: key } }));
}

const { slug } = Astro.params;
const section = SECTIONS[slug as keyof typeof SECTIONS];
const articles = await getArticlesBySection(slug!);
const color = sectionColor(slug as keyof typeof SECTIONS);

// 논문(paper) 섹션만 "금주의 논문"(심층기사)과 "논문 브리핑"(주간 목록)을 2열로 나눠 보여준다.
// 다른 꼭지(테커·클레임·데스크)는 기존 단일 목록 그대로 유지.
const isPaper = slug === 'paper';
const BRIEF_TAG = '논문 브리핑';
const features = isPaper ? articles.filter((a) => !a.data.tags.includes(BRIEF_TAG)) : [];
const briefs = isPaper ? articles.filter((a) => a.data.tags.includes(BRIEF_TAG)) : [];
---

<Base title={`${section.label} — DISPLAY NOW`}>
  <div style={`background: oklch(0.925 0.022 ${section.hue}); min-height: 100vh;`}>
    <div class="frame frame-boxed">
      <Header activeSection={slug} />
      <div class="accent-bar" style={`background:${color};`}></div>

      <div class="section-head">
        <div class="head-left">
          <div class="eyebrow">[ 꼭지 ]</div>
          <h1>{section.label}</h1>
          <p>{section.blurb}</p>
          <div class="meta-line">
            {
              isPaper ? (
                <span>금주의 논문 {features.length}편 · 브리핑 {briefs.length}편</span>
              ) : (
                <span>총 {articles.length}편</span>
              )
            }
            <span>담당 {section.reporter}</span>
            <span>편집 박원상</span>
          </div>
        </div>
        <aside class="head-right">
          <div class="eyebrow" style="padding-bottom:8px; border-bottom:1px solid var(--ink);">꼭지 전환</div>
          <div class="tab-list">
            {
              SECTION_ORDER.map((key) => (
                <a href={`/section/${key}`} class={`tab ${key === slug ? 'active' : ''}`}>
                  <span>{SECTIONS[key].label}</span>
                </a>
              ))
            }
          </div>
        </aside>
      </div>

      <div class="sort-bar">
        <div class="sort-group">
          <span class="eyebrow">정렬</span>
          <button type="button" data-sort="latest" class="chip active">최신순</button>
          <button type="button" data-sort="read" class="chip">긴 글순</button>
        </div>
      </div>

      {
        isPaper ? (
          <div class="list-wrap two-col">
            <div class="col">
              <div class="col-head" style={`border-bottom-color:${color};`}>금주의 논문 <span class="col-count">{features.length}</span></div>
              <div class="sortable-list" id="feature-list">
                {
                  features.map((a, i) => (
                    <a
                      href={articleHref(a)}
                      class="list-row"
                      data-date={a.data.publishedAt.toISOString()}
                      data-read={a.data.readingMinutes}
                    >
                      <div class="no-col">
                        {`#${String(features.length - i).padStart(4, '0')}`}
                        <br />
                        <span class="kind">{section.label}</span>
                      </div>
                      <div>
                        <div class="row-title">{a.data.title}</div>
                        <p class="row-summary">{a.data.summary}</p>
                        <div class="tags">
                          {a.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                        </div>
                      </div>
                      <div class="date-col">
                        {dateLabel(a)}<br />{a.data.readingMinutes}분
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>
            <div class="col">
              <div class="col-head" style={`border-bottom-color:${color};`}>논문 브리핑 <span class="col-count">{briefs.length}</span></div>
              <div class="sortable-list" id="brief-list">
                {
                  briefs.map((a, i) => (
                    <a
                      href={articleHref(a)}
                      class="list-row"
                      data-date={a.data.publishedAt.toISOString()}
                      data-read={a.data.readingMinutes}
                    >
                      <div class="no-col">
                        {`#${String(briefs.length - i).padStart(4, '0')}`}
                        <br />
                        <span class="kind">{section.label}</span>
                      </div>
                      <div>
                        <div class="row-title">{a.data.title}</div>
                        <p class="row-summary">{a.data.summary}</p>
                        <div class="tags">
                          {a.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                        </div>
                      </div>
                      <div class="date-col">
                        {dateLabel(a)}<br />{a.data.readingMinutes}분
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        ) : (
          <div class="list-wrap">
            <div class="sortable-list" id="article-list">
              {
                articles.map((a, i) => (
                  <a
                    href={articleHref(a)}
                    class="list-row"
                    data-date={a.data.publishedAt.toISOString()}
                    data-read={a.data.readingMinutes}
                  >
                    <div class="no-col">
                      {`#${String(articles.length - i).padStart(4, '0')}`}
                      <br />
                      <span class="kind">{section.label}</span>
                    </div>
                    <div>
                      <div class="row-title">{a.data.title}</div>
                      <p class="row-summary">{a.data.summary}</p>
                      <div class="tags">
                        {a.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                      </div>
                    </div>
                    <div class="date-col">
                      {dateLabel(a)}<br />{a.data.readingMinutes}분
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
        )
      }

      <section class="newsletter-strip">
        <div style="flex:1 1 320px; min-width:0;">
          <div style="font-family:var(--font-serif); font-size:19px; font-weight:600; letter-spacing:-0.03em;">{section.label} 새 글이 올라오면 알려드립니다</div>
          <p style="margin:6px 0 0; font-size:14px; line-height:1.7; color:var(--ink-faint); word-break:keep-all;">꼭지 단위로 구독할 수 있습니다. 무료이며 언제든 해지할 수 있습니다.</p>
        </div>
        <form onsubmit="return false;">
          <input type="email" placeholder="이메일 주소" />
          <button type="submit">구독</button>
        </form>
      </section>

      <Footer />
    </div>
  </div>
</Base>

<script>
  const lists = document.querySelectorAll<HTMLElement>('.sortable-list');
  if (lists.length) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('button[data-sort]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const mode = btn.dataset.sort;
        lists.forEach((list) => {
          const rows = Array.from(list.querySelectorAll<HTMLAnchorElement>('.list-row'));
          rows.sort((a, b) => {
            if (mode === 'read') {
              return Number(b.dataset.read) - Number(a.dataset.read);
            }
            return new Date(b.dataset.date!).valueOf() - new Date(a.dataset.date!).valueOf();
          });
          rows.forEach((r) => list.appendChild(r));
        });
      });
    });
  }
</script>

<style>
  .frame-boxed {
    margin: 40px auto;
    border: 1px solid var(--line-frame);
    background: var(--card);
  }
  .accent-bar {
    height: 3px;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--ink);
  }
  .head-left {
    flex: 1 1 460px;
    min-width: 0;
    padding: 30px clamp(14px, 4vw, 26px);
    border-right: 1px solid #d8d8d2;
  }
  .head-left h1 {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(24px, 4.8vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .head-left p {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.75;
    color: #45453d;
    word-break: keep-all;
    max-width: 66ch;
  }
  .meta-line {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
  }
  .head-right {
    flex: 1 1 240px;
    padding: 30px 26px;
  }
  .tab-list {
    display: flex;
    flex-direction: column;
  }
  .tab {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    width: 100%;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 14px;
    color: #55554d;
    background: transparent;
    border: none;
    border-left: 2px solid var(--line-soft);
    padding: 9px 10px;
  }
  .tab.active {
    font-weight: 600;
    color: var(--ink);
    background: #f4f4ef;
    border-left-color: var(--ink);
  }

  @media (max-width: 780px) {
    .head-right {
      flex: 1 1 100%;
      border-top: 1px solid #d8d8d2;
      padding: 18px clamp(14px, 4vw, 26px) 22px;
    }
    .tab-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }
    .tab {
      width: auto;
      justify-content: center;
      border: 1px solid var(--line-frame);
      padding: 6px 12px;
    }
    .tab.active {
      border-color: var(--ink);
    }
  }
  .sort-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 26px;
    border-bottom: 1px solid var(--line-soft);
    background: #f7f7f3;
  }
  .sort-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #55554d;
    background: transparent;
    border: 1px solid var(--line-frame);
    padding: 4px 10px;
    cursor: pointer;
  }
  .chip.active {
    color: var(--card);
    background: var(--ink);
    border-color: var(--ink);
  }
  .list-wrap {
    padding: 0 clamp(14px, 4vw, 26px) 26px;
  }
  .list-wrap.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(20px, 3vw, 36px);
  }
  .list-wrap.two-col .col {
    min-width: 0;
    border-left: 1px solid var(--line-soft);
    padding-left: clamp(16px, 3vw, 28px);
  }
  .list-wrap.two-col .col:first-child {
    border-left: none;
    padding-left: 0;
  }
  .col-head {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--ink);
    padding: 18px 0 8px;
    border-bottom: 2px solid var(--ink);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .col-count {
    color: var(--meta-soft);
    font-weight: 400;
  }
  .list-wrap.two-col .list-row {
    grid-template-columns: 64px 1fr;
    gap: 4px 14px;
  }
  .list-wrap.two-col .date-col {
    grid-column: 2;
    text-align: left;
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .list-wrap.two-col {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .list-wrap.two-col .col {
      border-left: none;
      padding-left: 0;
    }
    .list-wrap.two-col .col + .col {
      border-top: 2px solid var(--ink);
      margin-top: 20px;
    }
  }
  .list-row {
    display: grid;
    grid-template-columns: 96px 1fr 128px;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .no-col {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.7;
  }
  .no-col .kind {
    color: #b4b4aa;
  }
  .row-title {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.4;
    word-break: keep-all;
  }
  .row-summary {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: #55554d;
    word-break: keep-all;
    max-width: 92ch;
  }
  .tags {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    border: 1px solid var(--line);
    padding: 2px 7px;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .date-col {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.8;
  }
</style>
