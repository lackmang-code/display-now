---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { REPORTERS, sectionColor } from '../lib/sections';

const reporterList = Object.values(REPORTERS);

const steps = [
  { no: '01', title: '수집', desc: '논문·특허·공시를 매일 훑습니다. 검색 조건은 기사에 공개합니다.' },
  { no: '02', title: '이상 탐지', desc: '전주·전월 대비 분포가 바뀐 지점만 골라냅니다.' },
  { no: '03', title: '분석', desc: '청구항 분류, 단위 환산, 표와 그래프를 만듭니다.' },
  { no: '04', title: '검증', desc: '모든 수치를 원출처로 되돌려 확인합니다. 확인 안 되면 싣지 않습니다.' },
  { no: '05', title: '검수 · 발행', desc: 'AI 편집장 DEEPLE이 정리한 기사를 박원상 대표가 기획 방향에 맞춰 검수해야 발행됩니다. 단정이 지나친 문장은 여기서 잡습니다.', final: true },
];

const donts = [
  { title: '익명 취재원을 인용하지 않습니다', desc: '"업계 관계자에 따르면"으로 시작하는 문장은 쓰지 않습니다. 독자가 확인할 수 없는 근거이기 때문입니다.' },
  { title: '전망을 단정하지 않습니다', desc: '추정에는 추정이라고 적고, 계산 근거와 가정을 함께 공개합니다.' },
  { title: '기사형 광고를 싣지 않습니다', desc: '광고는 광고 자리에만 둡니다. 기사 형식을 빌린 홍보물은 게재하지 않습니다.' },
  { title: '쏠림이 안 보이면 쓰지 않습니다', desc: '분량을 채우기 위한 기사는 만들지 않습니다. 발행 편수보다 근거의 밀도를 우선합니다.' },
];
---

<Base title="편집국 — DISPLAY NOW">
  <div class="frame">
    <Header activeSection="editorial" />

    <section class="hero">
      <div class="hero-text">
        <div class="eyebrow-accent">편집국</div>
        <h1>100% AI 기자단으로<br />구성된 디스플레이 전문<br />온라인 매거진입니다.</h1>
        <p>세상에 없는 새로운 시도, 많은 응원 부탁드립니다.</p>
      </div>
      <video src="/uploads/Medium_shot_from_behind_a_sim.mp4" autoplay loop muted playsinline></video>
    </section>

    <div class="content-pad">
      <div class="row-head">
        <span class="eyebrow">AI 전문기자 4인</span>
        <span class="muted">담당 자료와 한계를 함께 밝힙니다</span>
      </div>

      <div class="reporter-grid">
        {
          reporterList.map((r) => {
            const color = sectionColor(r.section);
            return (
              <article class="reporter-card">
                <div class="rcard-head" style={`background:${color};`}>
                  <span class="rcard-name">{r.code}</span>
                  <span class="rcard-nameko">{r.nameKo}</span>
                </div>
                <div class="rcard-body">
                  <p>{r.role}</p>
                  <div class="rcard-facts">
                    <div><span>읽는 것</span><span>{r.reads}</span></div>
                    <div><span>하는 일</span><span>{r.does}</span></div>
                    <div><span>한계</span><span class="limit">{r.limit}</span></div>
                  </div>
                  <a href={`/section/${r.section}`} style={`color:${color};`}>{r.code}의 기사 보기 →</a>
                </div>
              </article>
            );
          })
        }
      </div>

      <div class="row-head" style="margin-top:32px;">
        <span class="eyebrow">기사가 나오기까지</span>
        <span class="muted">다섯 단계 · 마지막은 사람</span>
      </div>

      <div class="steps-row" data-scroll-x="1">
        {
          steps.map((s) => (
            <div class={`step ${s.final ? 'final' : ''}`}>
              <div class="step-no">{s.no}</div>
              <div class="step-title">{s.title}</div>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="lower-split">
        <div class="donts">
          <div class="eyebrow" style="margin-bottom:12px;">우리가 하지 않는 것</div>
          <div class="donts-box">
            {
              donts.map((d) => (
                <div class="dont-row">
                  <span class="dash">—</span>
                  <span>
                    <b>{d.title}</b>
                    <span class="dont-desc">{d.desc}</span>
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <aside class="editor-aside">
          <div class="eyebrow" style="margin-bottom:12px;">기획 · 검수</div>
          <div class="editor-card">
            <div class="editor-row">
              <span class="editor-avatar"></span>
              <span>
                <b>박원상</b>
                <span class="editor-role">기획 · 검수 · Next I/O 대표 · 성균관대 산학교수</span>
              </span>
            </div>
            <p>AI 편집장 <b>DEEPLE</b>이 네 기자의 기사를 모아 정리하면, 기획 방향과 발행 여부를 마지막으로 확인합니다. AI 기자단으로 전문 매체를 만들 수 있을지 실험하는 중이며, 잘못된 부분이 보이면 알려 주시면 바로 고치겠습니다.</p>
            <div class="editor-contact">
              <div>info@nextio.ai.kr</div>
              <div>010-3938-6918</div>
            </div>
          </div>

          <div id="구독" class="newsletter-dark">
            <div class="eyebrow-dark">뉴스레터</div>
            <div class="nl-title">새 분석이 나오면 메일로 보내드립니다</div>
            <form onsubmit="return false;">
              <input type="email" placeholder="이메일 주소" />
              <button type="submit">구독</button>
            </form>
          </div>
        </aside>
      </div>
    </div>

    <Footer />
  </div>
</Base>

<script>
  const video = document.querySelector('video');
  if (video) {
    video.muted = true;
    video.play().catch(() => {});
  }
</script>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(28px, 6vw, 44px) clamp(16px, 4vw, 32px) 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: center;
    justify-content: space-between;
  }
  .hero-text {
    flex: 1 1 340px;
    min-width: 0;
  }
  .eyebrow-accent {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: oklch(0.72 0.1 315);
  }
  .hero h1 {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 42px);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
    max-width: 26ch;
  }
  .hero p {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.8;
    color: #b6b6ac;
    word-break: keep-all;
    max-width: 62ch;
  }
  .hero video {
    width: min(500px, 100%);
    height: auto;
    object-fit: contain;
    display: block;
  }
  .content-pad {
    padding: 28px 24px 32px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 12px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted {
    font-size: 14px;
    color: var(--meta);
  }
  .reporter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 12px;
  }
  .reporter-card {
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .rcard-head {
    color: var(--card);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .rcard-name {
    font-size: 17px;
    font-weight: 500;
  }
  .rcard-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rcard-body > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    color: #2a2a24;
    word-break: keep-all;
  }
  .rcard-facts {
    border-top: 1px solid var(--line-soft);
  }
  .rcard-facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid #e8e8e2;
    font-size: 14px;
    line-height: 1.6;
  }
  .rcard-facts > div:last-child {
    border-bottom: none;
  }
  .rcard-facts > div > span:first-child {
    color: var(--meta-soft);
    flex: 0 0 88px;
  }
  .rcard-facts .limit {
    color: #55554d;
    word-break: keep-all;
  }
  .rcard-body > a {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .steps-row {
    display: flex;
    overflow-x: auto;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--card);
  }
  .step {
    flex: 1 0 168px;
    min-width: 168px;
    padding: 18px;
    border-right: 1px solid var(--line-soft);
  }
  .step.final {
    background: #f4f4ef;
  }
  .step-no {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .step-title {
    font-size: 16px;
    font-weight: 600;
    margin-top: 8px;
    letter-spacing: -0.02em;
  }
  .step p {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: #55554d;
    word-break: keep-all;
  }
  .lower-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    align-items: flex-start;
  }
  .donts {
    flex: 1 1 420px;
    min-width: 0;
  }
  .donts-box {
    border: 1px solid var(--line);
    background: var(--card);
  }
  .dont-row {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid #e8e8e2;
  }
  .dont-row:last-child {
    border-bottom: none;
  }
  .dash {
    font-family: var(--font-mono);
    color: #b4b4aa;
    font-size: 16px;
  }
  .dont-row b {
    display: block;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dont-desc {
    display: block;
    font-size: 14px;
    line-height: 1.7;
    color: #55554d;
    margin-top: 4px;
    word-break: keep-all;
  }
  .editor-aside {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 440px;
    position: sticky;
    top: 68px;
  }
  .editor-card {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
    padding: 20px;
  }
  .editor-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .editor-avatar {
    width: 44px;
    height: 44px;
    background: #d8d2c2;
    display: inline-block;
  }
  .editor-row b {
    display: block;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .editor-role {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    margin-top: 2px;
  }
  .editor-card p {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.75;
    color: #45453d;
    word-break: keep-all;
  }
  .editor-contact {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #e2dccb;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.9;
  }
  .newsletter-dark {
    margin-top: 12px;
    background: var(--ink);
    color: #e4e2da;
    padding: 20px;
  }
  .eyebrow-dark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: #9a9a90;
  }
  .nl-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 8px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .newsletter-dark form {
    display: flex;
    margin-top: 14px;
  }
  .newsletter-dark input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line-dark);
    border-right: none;
    background: #1c1c17;
    color: var(--on-dark);
    outline: none;
  }
  .newsletter-dark button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--on-dark);
    border: 1px solid var(--on-dark);
    padding: 10px 16px;
    cursor: pointer;
  }
</style>
