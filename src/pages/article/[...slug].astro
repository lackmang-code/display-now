---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SimBoot from '../../components/SimBoot.astro';
import '../../styles/article.css';
import { getCollection } from 'astro:content';
import { SECTIONS, sectionColor } from '../../lib/sections';
import { getPublishedArticles, dateLabel, articleHref } from '../../lib/articles';
import { seriesOf, partOf, episodesOfPart, seriesKicker } from '../../lib/series';
import { topicsOf, topicIndex } from '../../lib/tags';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const section = SECTIONS[entry.data.section];
const color = sectionColor(entry.data.section);

// 연재 목차·다른 글에는 발행된 기사만 세운다. 다만 지금 읽고 있는 기사가 아직 발행 전이면
// (검수 중) 자기가 목차에서 빠져 어색해지므로 그 한 편만 되넣는다.
const published = await getPublishedArticles();
const all = published.some((a) => a.slug === entry.slug)
  ? published
  : [entry, ...published].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const reporterInitial = entry.data.reporter[0];

// 연재 정보. 같은 부의 다른 편들이 있으면 기사 끝에 목차를 세운다.
const series = seriesOf(entry);
const seriesPart = partOf(entry);
const kicker = seriesKicker(entry);
const siblings =
  series && entry.data.series ? episodesOfPart(all, series.id, entry.data.series.part) : [];
const hasSeriesNav = siblings.length > 1;

// 연재 편이면 "다른 글" 자리를 연재 목차가 대신한다. 같은 목록을 두 번 보여줄 이유가 없다.
const related = hasSeriesNav
  ? []
  : all.filter((a) => a.slug !== entry.slug && a.data.section === entry.data.section).slice(0, 3);

// 이 기사가 속한 주제. 페이지가 실제로 존재하는(기사 2편 이상) 주제만 링크로 건다.
// 기사마다 주제 허브로 나가는 링크가 생기면 크롤러가 사이트 안을 돌아다닐 길이 열린다.
const liveTopics = new Set(topicIndex(published).map((g) => g.topic.slug));
const topics = topicsOf(entry).filter((t) => liveTopics.has(t.slug));

// 검색엔진에 보내는 제목. 화면 제목(h1)은 언제나 entry.data.title 그대로다.
const seoTitle = entry.data.searchTitle ?? entry.data.title;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: seoTitle,
  alternativeHeadline: entry.data.title,
  description: entry.data.summary,
  inLanguage: 'ko',
  articleSection: section.label,
  keywords: entry.data.tags.join(', '),
  about: topics.map((t) => ({
    '@type': 'Thing',
    name: t.label,
    url: new URL(`/tag/${t.slug}`, Astro.site).toString(),
  })),
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.publishedAt.toISOString(),
  image: [new URL(`/og/${entry.slug}.png`, Astro.site).toString()],
  author: {
    '@type': 'Organization',
    name: `${entry.data.reporter} (AI 기자)`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'DISPLAY NOW',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo/dn-lockup-reverse.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(articleHref(entry), Astro.site).toString(),
  },
};
---

<Base title={`${seoTitle} | DISPLAY NOW`} description={entry.data.summary} image={`/og/${entry.slug}.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <div class="frame">
    <Header activeSection={entry.data.section} />
    <div class="accent-line" style={`background:${color};`}></div>

    <div class="article-layout">
      <aside class="toc-aside">
        <div class="toc-label" style={`color:${color}; border-bottom-color:${color};`}>목차</div>
        <nav class="toc-nav">
          {
            toc.map((h) => (
              <a href={`#${h.slug}`} style={`border-left-color:${color};`}>{h.text}</a>
            ))
          }
        </nav>
        <div class="toc-meta">
          <div>읽는 시간 {entry.data.readingMinutes}분</div>
        </div>
        {
          entry.data.sources.length > 0 && (
            <div class="toc-sources">
              <div class="toc-sub-label">근거 자료</div>
              <div class="src-count">{entry.data.sources.length}건</div>
            </div>
          )
        }
      </aside>

      <div class="article-main">
        <article class="article-body" style={`--section-color:${color};`} data-paywall-after={entry.data.paywallAfter}>
          <div class="top-meta">
            <a href={`/section/${entry.data.section}`} style={`border-bottom-color:${color};`}>{section.label}</a>
            <span>{dateLabel(entry)} · 읽는 시간 {entry.data.readingMinutes}분</span>
          </div>

          {
            kicker && (
              <div class="series-kicker" style={`color:${color}; border-color:${color};`}>
                <span class="series-kicker-label">연재</span>
                {kicker}
              </div>
            )
          }

          <h1 class="headline">{entry.data.title}</h1>
          <p class="dek">{entry.data.summary}</p>

          <div class="byline-box">
            <span class="reporter-badge">{reporterInitial}</span>
            <span><span class="dim">by</span> <b>{entry.data.reporter}</b> <span class="dim">(AI 기자 · {section.label} 담당)</span></span>
            <span class="sep">|</span>
            <span><span class="dim">AI 편집장</span> <b>DEEPLE</b></span>
          </div>

          <Content />
        </article>

        <SimBoot />

        {
          entry.data.sources.length > 0 && (
            <section class="sources-box">
              <div class="sources-head">
                <span class="reporter-badge">{reporterInitial}</span>
                <span class="sources-label">이 기사의 근거</span>
                <span class="sources-sign">AI 기자 <b>{entry.data.reporter}</b> 작성 · AI 편집장 <b>DEEPLE</b> 편집 완료</span>
              </div>
              {
                entry.data.sources.length === 1 ? (
                  <p class="sources-note">
                    이 기사는 위 서지정보의 논문 1편을 근거로 작성했습니다. 수치·서술은 모두 원문과
                    대조했습니다{entry.data.sources[0].url && <>. <a href={entry.data.sources[0].url} target="_blank" rel="noopener">원문 열기</a></>}.
                  </p>
                ) : (
                  <ul class="sources-list">
                    {
                      entry.data.sources.map((s) => (
                        <li>
                          <span class="src-type">{s.type}</span>
                          {s.url ? (
                            <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
                          ) : (
                            <span>{s.title}{s.number ? ` (${s.number})` : ''}</span>
                          )}
                        </li>
                      ))
                    }
                  </ul>
                )
              }
            </section>
          )
        }

        {/* 정정 요청이 가장 자연스럽게 나오는 자리는 근거를 확인한 직후다 */}
        <aside class="correction">
          <span class="correction-text">
            이 기사에서 사실과 다른 부분을 발견하셨습니까. 알려주시면 확인하고 바로잡겠습니다.
          </span>
          <a class="correction-link" href="/board?kind=%EC%A0%95%EC%A0%95%20%EC%9A%94%EC%B2%AD">정정 요청하기 →</a>
        </aside>

        {
          topics.length > 0 && (
            <nav class="topic-chips" aria-label="이 기사의 주제">
              <span class="topic-chips-label">주제</span>
              {topics.map((t) => (
                <a href={`/tag/${t.slug}`} class="topic-chip">
                  {t.label}
                </a>
              ))}
            </nav>
          )
        }

        {
          hasSeriesNav && seriesPart && (
            <section class="series-box" style={`--section-color:${color};`}>
              <div class="series-head">
                <div class="series-part-no" style={`color:${color};`}>{seriesPart.part}부</div>
                <div>
                  <div class="series-part-title">{seriesPart.title}</div>
                  <div class="series-part-deck">{seriesPart.deck}</div>
                </div>
              </div>

              <ol class="series-list">
                {siblings.map((a) => {
                  const here = a.slug === entry.slug;
                  return (
                    <li class={here ? 'here' : ''}>
                      <span class="ep" style={here ? `background:${color}; color:#fff; border-color:${color};` : ''}>
                        {a.data.series!.episode}
                      </span>
                      {here ? (
                        <span class="ep-title">{a.data.title}<span class="ep-now">지금 읽는 글</span></span>
                      ) : (
                        <a class="ep-title" href={articleHref(a)}>{a.data.title}</a>
                      )}
                    </li>
                  );
                })}
              </ol>

              {seriesPart.status === 'ongoing' && (
                <p class="series-foot">
                  {seriesPart.closesWith
                    ? `이어지는 편은 ${seriesPart.closesWith}(으)로 이 부를 닫습니다. `
                    : ''}각 편은 따로 읽어도 완결됩니다.
                </p>
              )}
              {seriesPart.status === 'done' && seriesPart.closesWith && (
                <p class="series-foot">이 부는 {seriesPart.closesWith}(으)로 닫혔습니다. 각 편은 따로 읽어도 완결됩니다.</p>
              )}
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="related">
              <a href={`/section/${entry.data.section}`} class="related-head">{section.label} · {entry.data.reporter}의 다른 글 →</a>
              <div class="related-grid">
                {related.map((a) => (
                  <a href={articleHref(a)} class="related-item">
                    <div class="related-date">{dateLabel(a)} · {a.data.readingMinutes}분</div>
                    <div class="related-title">{a.data.title}</div>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <section class="newsletter-strip">
          <div style="flex:1 1 320px; min-width:0;">
            <div style="font-family:var(--font-serif); font-size:19px; font-weight:600; letter-spacing:-0.03em;">매주 화요일, 그 주의 디스플레이를 한 권으로 보내드립니다</div>
            <p style="margin:6px 0 0; font-size:14px; line-height:1.7; color:var(--ink-faint); word-break:keep-all;">무료 뉴스레터입니다. 언제든 해지할 수 있습니다.</p>
          </div>
          <form onsubmit="return false;">
            <input type="email" placeholder="이메일 주소" />
            <button type="submit">구독</button>
          </form>
        </section>

        <div style="height:40px;"></div>
      </div>
    </div>

    <Footer />
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.article-body[data-paywall-after]').forEach((article) => {
    const n = Number(article.dataset.paywallAfter || '0');
    if (!n) return;

    const sections = Array.from(article.querySelectorAll('h2'));
    const boundary = sections[n];
    if (!boundary) return;

    const gate = document.createElement('div');
    gate.id = 'paywall';
    gate.className = 'paywall-box';
    gate.innerHTML = `
      <div class="paywall-title">여기부터는 구독자 전용입니다</div>
      <p>남은 분석은 무료 뉴스레터를 구독하시면 이어서 볼 수 있습니다.</p>
      <a class="paywall-cta" href="/editorial#구독">무료로 구독하고 계속 읽기 →</a>
    `;
    boundary.before(gate);

    let el: Element | null = boundary;
    while (el) {
      const next: Element | null = el.nextElementSibling;
      el.classList.add('paywall-hidden');
      el = next;
    }
  });
</script>

<style>
  .accent-line {
    height: 3px;
  }
  .topic-chips {
    /* 부속 블록이므로 880px(README "기사 페이지는 폭이 두 가지"). 본문 700px이 아니다.
       종전에는 폭 제한 없이 margin clamp만 있어서 오른쪽은 부속 블록과 맞는데
       왼쪽만 26px 안으로 밀려 있었다(2026-08-31 발견). */
    max-width: 700px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    /* 좌우 여백은 .article-main 패딩이 이미 준다. clamp로 한 번 더 주면 왼쪽이 밀린다. */
    margin: 0 0 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
  }
  .topic-chips-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
    margin-right: 4px;
  }
  .topic-chip {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #45453d;
    border: 1px solid var(--line-frame);
    padding: 5px 11px;
    white-space: nowrap;
  }
  .topic-chip:hover {
    color: var(--card);
    background: var(--ink);
    border-color: var(--ink);
  }
  .article-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .toc-aside {
    position: sticky;
    top: 56px;
    flex: 1 1 216px;
    max-width: 216px;
    min-width: 0;
    padding: 32px 20px 40px clamp(14px, 4vw, 26px);
    border-right: 1px solid var(--line-soft);
    align-self: start;
  }
  .toc-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    padding-bottom: 8px;
    border-bottom: 2px solid;
  }
  .toc-nav {
    display: flex;
    flex-direction: column;
    margin-top: 2px;
  }
  .toc-nav a {
    font-size: 14px;
    line-height: 1.5;
    padding: 9px 0 9px 10px;
    border-left: 2px solid var(--line-soft);
    color: #55554d;
    word-break: keep-all;
  }
  .toc-meta,
  .toc-sources {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.9;
  }
  .toc-sub-label {
    letter-spacing: 0.08em;
  }
  .article-main {
    flex: 1 1 520px;
    min-width: 0;
    padding: 32px clamp(14px, 4vw, 26px) 0 clamp(14px, 4vw, 32px);
  }
  .top-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    letter-spacing: 0.05em;
  }
  .top-meta a {
    color: var(--ink);
    border-bottom: 2px solid;
    padding-bottom: 2px;
  }
  .headline {
    margin: 16px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 42px);
    line-height: 1.28;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
    max-width: 700px;
  }
  .dek {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.75;
    color: #45453d;
    word-break: keep-all;
    max-width: 700px;
  }
  /* tokens.css의 .newsletter-strip 은 880px이고 섹션 페이지와 공유한다.
     기사 페이지에서만 본문 폭에 맞춘다. */
  .newsletter-strip {
    max-width: 700px;
  }
  .correction {
    /* 부속 블록 폭(880px). 이 블록만 max-width가 없어 .article-main(962px)을
       그대로 채우는 바람에 904px로 혼자 튀어나와 있었다(2026-08-31 발견). */
    max-width: 700px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    background: var(--card);
    padding: 14px 16px;
    margin-top: 22px;
  }
  .correction-text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-mute);
    word-break: keep-all;
    flex: 1 1 260px;
  }
  .correction-link {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    flex: 0 0 auto;
  }

  /* 연재 표기는 제목 위로 올린다. 제목 안에 편 번호를 넣으면 목록에서 후크가 죽는다 */
  .series-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
    margin-bottom: 14px;
  }
  .series-kicker-label {
    font-size: 10.5px;
    letter-spacing: 0.22em;
    opacity: 0.72;
  }

  .series-box {
    margin: 44px 0 0;
    max-width: 700px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--section-color);
    background: var(--card);
    padding: 20px 22px 18px;
  }
  .series-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-soft);
  }
  .series-part-no {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    flex: 0 0 auto;
    padding-top: 3px;
  }
  .series-part-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .series-part-deck {
    margin-top: 3px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-mute);
    word-break: keep-all;
  }
  .series-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  .series-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .series-list li:last-child {
    border-bottom: 0;
  }
  .series-list .ep {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--meta-soft);
    align-self: center;
  }
  .series-list .ep-title {
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  a.ep-title {
    color: var(--ink);
    border-bottom: 1px solid transparent;
  }
  a.ep-title:hover {
    border-bottom-color: var(--section-color);
  }
  .series-list li.here .ep-title {
    font-weight: 600;
  }
  .ep-now {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--section-color);
    margin-left: 9px;
    white-space: nowrap;
  }
  .series-foot {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-faint);
    word-break: keep-all;
  }

  .sources-box {
    margin: 40px 0 0;
    max-width: 700px;
    border: 1px solid var(--line);
    background: #f7f7f3;
  }
  .sources-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line-soft);
    flex-wrap: wrap;
  }
  .sources-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
  }
  .sources-sign {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
  }
  .sources-sign b {
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.03em;
  }
  .sources-note {
    margin: 0;
    padding: 6px 20px 16px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--meta-soft);
  }
  .sources-note a {
    color: var(--accent, inherit);
  }
  .sources-list {
    margin: 0;
    padding: 6px 20px 16px;
    list-style: none;
  }
  .sources-list li {
    display: flex;
    gap: 10px;
