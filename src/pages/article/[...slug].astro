---
import { getCollection } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';

// 한글판만 이 경로가 맡는다. 영문판(`lang: 'en'`)은 /en/article/ 이 맡는다.
// 발행 예정분(미래 날짜)도 페이지는 만든다 — 검수용 URL이 필요하기 때문이다.
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((entry) => (entry.data.lang ?? 'ko') === 'ko')
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ArticleView entry={entry} />
