---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { getAllArticles, bylineOf, articleHref } from '../lib/articles';
import { getIssues, articlesOfIssue, issueNumberLabel, issueDateLabel, issueHref } from '../lib/issues';

const allArticles = await getAllArticles();
const latestBySection = SECTION_ORDER.map((key) => {
  const list = allArticles.filter((a) => a.data.section === key);
  return { key, article: list[0] };
}).filter((x) => x.article);

const recentArticles = allArticles.slice(0, 8);

// 이번 호 배너. ISSUES에는 발행 확정된 호만 넣으므로 맨 앞이 곧 최신 호다.
const latestIssue = getIssues()[0];
const latestIssueCount = latestIssue ? (await articlesOfIssue(latestIssue)).length : 0;

// 편집국 추천 — 사람이 고르는 목록 (조회수 아님)
const editorPicksSlugs = [
  '2026-08-13-hunan-indis-microled',
  '2026-08-18-self-healing-wearable-peled',
  '2026-08-11-udc-diffraction',
  '2026-08-14-proximity-sensor-transmittance',
  '2026-08-04-dgist-samsung-igzo-laser-anneal',
  '2026-08-06-fmp-privacy-display',
  '2026-08-13-flex-titanium-fold8',
  '2026-08-14-boe-samsung-display-upc-lawsuit',
  '2026-08-14-utg-six-companies-deep-report',
  '2026-08-14-als-behind-oled-crosstalk',
];
const editorPicks = editorPicksSlugs
  .map((slug) => allArticles.find((a) => a.slug === slug))
  .filter(Boolean);
---

<Base title="DISPLAY NOW | AI 기자단이 쓰는 디스플레이 전문 매거진">
  <div class="frame">
    <Header showNav={false} />

    <section class="hero">
      <h1>100% 전문 AI 기자단으로 구성된 디스플레이 전문 매거진</h1>
    </section>

    {
      latestIssue && (
        <a class="issue-banner" href={issueHref(latestIssue)}>
          <div class="ib-left">
            <span class="ib-label">이번 호</span>
            <span class="ib-no">{issueNumberLabel(latestIssue)} · {issueDateLabel(latestIssue)}</span>
          </div>
          <div class="ib-main">
            <div class="ib-headline">{latestIssue.headline}</div>
            <div class="ib-meta">
              {latestIssueCount}편 수록
              {latestIssue.coverSim && ' · 표지는 시뮬레이션입니다'}
            </div>
          </div>
          <span class="ib-go">표지 열기 →</span>
        </a>
      )
    }

    <div class="content-pad">
      <div class="row-head">
        <span class="eyebrow">꼭지 바로가기</span>
        <a href="/editorial" class="muted-link">편집국 소개 →</a>
      </div>

      <div class="quick-cards" data-nav="1">
        {
          latestBySection.map(({ key, article }) => {
            const s = SECTIONS[key];
            return (
              <a href={`/section/${key}`} class="quick-card" style={`border-color:${sectionColor(key)};`}>
                <div class="band" style={`background:${sectionColor(key)};`}>{s.label}</div>
                <div class="body">
                  <div class="title">{article!.data.title}</div>
                  <div class="byline">{bylineOf(article!)}</div>
                </div>
              </a>
            );
          })
        }
        <a href="/archive" class="quick-card archive-card">
          <div class="band archive-band">아카이브</div>
          <div class="body">
            <div class="title">발행한 기사 전체를 제목·기업명으로 검색</div>
            <div class="byline">전체 {allArticles.length}편 · 검색하기 →</div>
          </div>
        </a>
      </div>

      <div class="main-split">
        <div class="feed">
          <div class="row-head">
            <span class="eyebrow">전체 글 · 최신순</span>
            <a href="/archive" class="muted-link">아카이브 전체 {allArticles.length}편 →</a>
          </div>
          <div class="feed-grid">
            {recentArticles.map((a) => <ArticleCard article={a} />)}
          </div>
        </div>

        <aside class="sidebar">
          <div class="row-head">
            <span class="eyebrow">편집국 추천</span>
            <span class="muted">{new Date().getMonth() + 1}월</span>
          </div>
          <div class="picks">
            {
              editorPicks.map((a, i) => (
                <a href={articleHref(a!)} class="pick-row">
                  <span class="no">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="pick-title">{a!.data.title}</span>
                    <span class="pick-meta">
                      <span style={`color:${sectionColor(a!.data.section)};`}>{SECTIONS[a!.data.section].label}</span>
                      {' · by '}{a!.data.reporter}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <div class="newsletter-dark">
            <div class="eyebrow-dark">뉴스레터</div>
            <div class="nl-title">새 분석이 나오면 메일로 보내드립니다</div>
            <form id="subscribe-form">
              <input type="email" name="email" placeholder="이메일 주소" required />
              <button type="submit">구독</button>
            </form>
            <p class="nl-status" id="subscribe-status" hidden></p>
            <a class="nl-more" href="/subscribe">관심 꼭지까지 지정해 신청하기 →</a>
          </div>

          <a class="ad-box" href="https://www.nextio.ai.kr" target="_blank" rel="noopener">
            <span class="ad-label">광고</span>
            <img class="ad-logo" src="/uploads/nextio-lockup-reverse.svg" alt="Next I/O" />
            <video src="/uploads/nextio-ad-mobile-robot.mp4" autoplay loop muted playsinline></video>
            <div class="ad-copy">
              <div class="ad-tagline">당신의 PC에 AI 직원을<br />복제/이식시켜 드립니다.</div>
              <div class="ad-contact">문의: info@nextio.ai.kr</div>
            </div>
          </a>
        </aside>
      </div>
    </div>

    <SubscribeCTA />

    <Footer />
  </div>
</Base>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
    padding: clamp(20px, 5vw, 28px) clamp(14px, 4vw, 32px);
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(20px, 4.4vw, 32px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  /* 이번 호 배너. 히어로 바로 아래에서 그 주 호로 보낸다 */
  .issue-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    background: var(--ink);
    color: var(--on-dark);
    border-top: 1px solid rgba(244, 243, 238, 0.18);
    padding: 14px clamp(14px, 4vw, 32px) 16px;
  }
  .ib-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 0 0 auto;
  }
  .ib-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .ib-no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .ib-main {
    flex: 1 1 320px;
    min-width: 0;
  }
  .ib-headline {
    font-family: var(--font-serif);
    font-size: clamp(17px, 3vw, 21px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .ib-meta {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .ib-go {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold);
  }
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 24px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 10px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted-link {
    font-size: 14px;
    color: var(--meta);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .quick-cards {
    display: flex;
    gap: 12px;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2px;
  }
  .quick-card {
    background: var(--card);
    border: 1.5px solid var(--line-frame);
    display: flex;
    flex-direction: column;
    flex: 1 0 clamp(152px, 42vw, 200px);
    min-width: clamp(152px, 42vw, 200px);
    scroll-snap-align: start;
  }
  .quick-card .band {
    color: var(--card);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 8px clamp(12px, 3.2vw, 18px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .archive-card {
    background: var(--card-warm);
    border-color: var(--line-dark);
  }
  .archive-band {
    background: var(--line-dark);
  }
  .quick-card .body {
    padding: clamp(12px, 3.4vw, 16px) clamp(13px, 3.8vw, 18px) clamp(11px, 3vw, 14px);
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }
  .quick-card .title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 18px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.03em;
    word-break: keep-all;
    flex: 1;
  }
  .quick-card .byline {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .main-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
    align-items: flex-start;
  }
  .feed {
    flex: 1 1 520px;
    min-width: 0;
  }
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .sidebar {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 316px;
  }
  .picks {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
  }
  .pick-row {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid #e2dccb;
  }
  .pick-row:last-child {
    border-bottom: none;
  }
  .no {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
  }
  .pick-title {
    display: block;
    font-size: clamp(14px, 3.6vw, 15px);
    line-height: 1.5;
    word-break: keep-all;
  }
  .pick-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    margin-top: 5px;
  }
  .newsletter-dark {
    margin-top: 12px;
    background: var(--ink);
    color: #e4e2da;
    padding: 18px;
  }
  .eyebrow-dark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: #9a9a90;
  }
  .nl-title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 17px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 8px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .newsletter-dark form {
    display: flex;
    margin-top: 12px;
  }
  .newsletter-dark form[hidden] {
    display: none;
  }
  .newsletter-dark input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line-dark);
    border-right: none;
    background: #1c1c17;
    color: var(--on-dark);
    outline: none;
  }
  .newsletter-dark button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--on-dark);
    border: 1px solid var(--on-dark);
    padding: 10px 16px;
    cursor: pointer;
  }
  .ad-box {
    position: relative;
    display: block;
    margin-top: 12px;
    overflow: hidden;
    background: #0b0e19;
    border: 1px solid var(--line-dark);
  }
  .ad-box video {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .ad-label {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #e4e2da;
    background: rgba(0, 0, 0, 0.55);
    padding: 2px 7px;
  }
  .ad-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.8));
    color: var(--on-dark);
  }
  .ad-logo {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    height: 18px;
    width: auto;
  }
  .ad-tagline {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .ad-contact {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-dark-mute);
    margin-top: 5px;
  }
  .nl-status {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .nl-more {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--on-dark-mute);
    border-bottom: 1px solid var(--line-dark);
  }
  .nl-more:hover {
    color: var(--on-dark);
  }
</style>

<script>
  const form = document.getElementById('subscribe-form');
  const status = document.getElementById('subscribe-status');

  function showStatus(text: string) {
    if (!status) return;
    status.hidden = false;
    status.textContent = text;
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.elements.namedItem('email');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      const btn = form.querySelector('button');
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = true;
        btn.textContent = '처리 중...';
      }
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'home-sidebar' }),
        });
        const data = await res.json();
        if (data.ok) {
          form.hidden = true;
          showStatus('구독 신청 완료했습니다. 감사합니다!');
        } else {
          showStatus('이메일 주소를 확인해주세요.');
          if (btn instanceof HTMLButtonElement) {
            btn.disabled = false;
            btn.textContent = '구독';
          }
        }
      } catch {
        showStatus('오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
        if (btn instanceof HTMLButtonElement) {
          btn.disabled = false;
          btn.textContent = '구독';
        }
      }
    });
  }
</script>
