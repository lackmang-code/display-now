---
import Base from '../layouts/Base.astro';
import HomeMobile from '../components/HomeMobile.astro';
import HomeDesktop from '../components/HomeDesktop.astro';
import Footer from '../components/Footer.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import { getPublishedArticles } from '../lib/articles';
import { getIssues, articlesOfIssue } from '../lib/issues';
import { resolvePicks } from '../lib/picks';

const allArticles = await getPublishedArticles();

// 이번 호 배너가 헤드 기사 제목을 그대로 싣는다(headline = 그 기사 제목).
// 그 기사를 목록에도 두면 한 화면에 같은 제목이 두 번 나오므로 목록에서 뺀다.
// 배너 자체가 그 기사로 가는 길이라 닿지 못하게 되는 것은 아니다.
// ⚠️ 헤드라인이 기사 제목과 **같을 때만** 뺀다. 제1호처럼 표지 문구를 따로 지은 호에서는
// 헤드라인이 기사 제목이 아니어서, 목록에서까지 빼면 그 제목이 홈 어디에도 나오지 않는다.
const _issue0 = getIssues()[0];
const _head0 = _issue0?.headSlug ? allArticles.find((a) => a.slug === _issue0.headSlug) : undefined;
const bannerHeadSlug =
  _head0 && _issue0 && _issue0.headline.trim() === _head0.data.title.trim() ? _head0.slug : undefined;
const recentArticles = allArticles.filter((a) => a.slug !== bannerHeadSlug).slice(0, 8);

// 이번 호 배너. ISSUES에는 발행 확정된 호만 넣으므로 맨 앞이 곧 최신 호다.
const latestIssue = getIssues()[0];
const latestIssueCount = latestIssue ? (await articlesOfIssue(latestIssue)).length : 0;

// 편집국 추천 — 사람이 고르는 목록 (조회수 아님). 목록 자체는 `src/lib/picks.ts`에 있다.
// 바로 왼쪽 기사 목록에 이미 있는 것과 배너에 실린 헤드 기사는 뺀다.
const shownSlugs = new Set<string>(recentArticles.map((a) => a.slug));
if (bannerHeadSlug) shownSlugs.add(bannerHeadSlug);
const editorPicks = resolvePicks(allArticles, shownSlugs);
---

<Base title="DISPLAY NOW | AI 기자단이 쓰는 디스플레이 전문 매거진" altHref="/en">
  {/*
    홈은 폭 820px을 경계로 지면이 갈린다.

    이하 → 표지형(HomeMobile.astro) · 초과 → PC 지면(HomeDesktop.astro).
    둘은 구조가 아예 달라서 CSS로 접는 방식으로는 안 되고, 두 벌을 다 두고 가른다.
    경계값 820px은 첨디공On이 쓰는 값과 같게 맞췄다.

    주소는 하나다. 첨디공처럼 phone.html/book.html로 나누면 페이지가 93 → 186이 되고
    같은 기사가 두 주소에 생겨 색인을 다시 잡아야 한다(현재 45개 중 1개 색인).

    ⚠️ 구글은 모바일 지면을 기준으로 색인한다. PC에만 있고 모바일에 없는 링크는 값이 깎인다.
    그래서 꼭지·주간호·아카이브·주제별·편집국 링크가 모바일 내비 풀다운과 푸터 양쪽에 있다.

    🔴 PC 지면은 영문 홈(`/en`)과 **같은 컴포넌트 한 벌**을 쓴다. 여기를 고치면 영문도 같이
    바뀐다 — 그것이 이 구조의 목적이다. 언어별로 다른 것은 문구(i18n)와 링크 경로뿐이다.
  */}
  {/* 데이터는 여기서 한 번만 계산해 넘긴다. 양쪽이 따로 계산하면 두 지면이 어긋난다 */}
  <div class="home-mobile">
    <HomeMobile
      latestIssue={latestIssue}
      latestIssueCount={latestIssueCount}
      recentArticles={recentArticles}
      editorPicks={editorPicks as any}
      totalCount={allArticles.length}
    />
  </div>

  <div class="home-desktop">
    <HomeDesktop
      allArticles={allArticles}
      recentArticles={recentArticles}
      editorPicks={editorPicks}
      latestIssue={latestIssue}
      latestIssueCount={latestIssueCount}
    />
  </div>

  {/*
    구독 CTA와 푸터는 두 지면이 함께 쓴다. PC 블록 안에 두면 모바일에서 통째로 사라지는데,
    푸터에는 꼭지·주간호·아카이브·주제별·편집국 링크가 들어 있어 모바일 색인이 그만큼 얇아진다.
  */}
  <div class="frame home-foot">
    <SubscribeCTA />
    <Footer />
  </div>
</Base>

<style>
  /* ── 지면 가르기 ────────────────────────────────────────────
     820px 이하는 표지형, 초과는 PC 지면.
     기본을 모바일로 두고 넓어질 때 바꾼다(좁은 화면이 기준이라는 뜻).
     경계값은 첨디공On과 같은 820px. */
  .home-mobile {
    display: block;
  }
  .home-desktop {
    display: none;
  }
  @media (min-width: 821px) {
    .home-mobile {
      display: none;
    }
    .home-desktop {
      display: block;
    }
  }
</style>
