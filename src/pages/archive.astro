---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { getAllArticles, dateLabel, bylineOf, articleHref } from '../lib/articles';

const articles = await getAllArticles();

const periods = Array.from(
  new Set(
    articles.map((a) => {
      const d = a.data.publishedAt;
      return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
    }),
  ),
).sort((a, b) => b.localeCompare(a));

const tagFreq = new Map<string, number>();
articles.forEach((a) => a.data.tags.forEach((t) => tagFreq.set(t, (tagFreq.get(t) || 0) + 1)));
const rankedTags = Array.from(tagFreq.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'))
  .map(([t]) => t);
const TAG_CAP = 10;
const visibleTags = rankedTags.slice(0, TAG_CAP);
const hiddenTagCount = rankedTags.length - TAG_CAP;

const suggestions = rankedTags.slice(0, 5);
---

<Base title="아카이브 — DISPLAY NOW">
  <div class="frame">
    <Header activeSection="archive" />
    <div class="accent-strip">
      <span style={`background:${sectionColor('tech-note')};`}></span>
      <span style={`background:${sectionColor('paper')};`}></span>
      <span style={`background:${sectionColor('patent')};`}></span>
      <span style={`background:${sectionColor('issue')};`}></span>
    </div>

    <section class="archive-hero">
      <div class="eyebrow">아카이브</div>
      <h1>발행한 모든 기사를 여기서 찾습니다</h1>

      <div class="search-box">
        <input type="search" id="q" placeholder="기업명, 기술, 제목으로 검색 — 예: BOE 8.6세대" />
        <button type="button" id="clear-btn">지우기</button>
      </div>

      <div class="suggestions">
        <span>자주 찾는 검색어</span>
        {suggestions.map((s) => <button type="button" class="suggest-btn" data-query={s}>{s}</button>)}
      </div>
    </section>

    <div class="content-pad">
      <div class="filter-grid">
        <div class="filter-label">꼭지</div>
        <div class="chip-row" id="section-chips">
          <button type="button" class="chip active" data-section="전체" style="border-color:#12120e; background:#12120e; color:#f4f3ee;">전체 {articles.length}</button>
          {
            SECTION_ORDER.map((key) => (
              <button type="button" class="chip" data-section={key} style={`--chip-color:${sectionColor(key)};`}>{SECTIONS[key].label}</button>
            ))
          }
        </div>

        <div class="filter-label">기간</div>
        <div class="chip-row" id="period-chips">
          <button type="button" class="chip active" data-period="전체">전체</button>
          {periods.map((p) => <button type="button" class="chip" data-period={p}>{p.replace('.', '년 ')}월</button>)}
        </div>

        <div class="filter-label">태그</div>
        <div class="chip-row" id="tag-chips">
          {visibleTags.map((t) => <button type="button" class="chip" data-tag={t}>{t}</button>)}
          {
            hiddenTagCount > 0 && (
              <button type="button" class="chip dashed" id="more-tags">더 보기 +{hiddenTagCount}</button>
            )
          }
          {rankedTags.slice(TAG_CAP).map((t) => <button type="button" class="chip hidden-tag" data-tag={t} hidden>{t}</button>)}
        </div>
      </div>

      <div class="result-bar">
        <div class="result-label" id="result-label">전체 {articles.length}편 · 최신순</div>
        <div class="chip-row">
          <button type="button" class="chip sort active" data-sort="최신순">최신순</button>
          <button type="button" class="chip sort" data-sort="오래된순">오래된순</button>
        </div>
      </div>

      <div id="results" class="results">
        {
          articles.map((a) => (
            <a
              href={articleHref(a)}
              class="result-row"
              style={`border-left-color:${sectionColor(a.data.section)};`}
              data-title={a.data.title.toLowerCase()}
              data-summary={a.data.summary.toLowerCase()}
              data-tags={a.data.tags.join(' ').toLowerCase()}
              data-section={a.data.section}
              data-period={`${a.data.publishedAt.getFullYear()}.${String(a.data.publishedAt.getMonth() + 1).padStart(2, '0')}`}
              data-date={a.data.publishedAt.toISOString()}
            >
              <div class="result-main">
                <div class="result-meta">
                  <span class="chip-tag" style={`background:${sectionColor(a.data.section)};`}>{SECTIONS[a.data.section].label}</span>
                  <span class="byline">{bylineOf(a)}</span>
                </div>
                <div class="result-title">{a.data.title}</div>
                <p class="result-summary">{a.data.summary}</p>
                <div class="result-tags">
                  {a.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                </div>
              </div>
              <div class="result-side">
                <span>{dateLabel(a, 'short')}</span>
                <span>{a.data.readingMinutes}분</span>
              </div>
            </a>
          ))
        }
      </div>

      <div id="empty-state" class="empty-state" hidden>
        <div class="empty-title">조건에 맞는 기사가 없습니다</div>
        <p>검색어를 줄이거나 필터를 해제해 보십시오. 찾으시는 주제가 아직 없다면 제보해 주시면 다루겠습니다.</p>
        <div class="empty-actions">
          <button type="button" id="reset-btn">필터 전체 해제</button>
          <a href="mailto:info@nextio.ai.kr">주제 제보하기</a>
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-btn')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const moreTags = document.getElementById('more-tags');
  const results = Array.from(document.querySelectorAll<HTMLAnchorElement>('.result-row'));
  const resultLabel = document.getElementById('result-label')!;
  const emptyState = document.getElementById('empty-state')!;
  const resultsWrap = document.getElementById('results')!;

  const state = { query: '', section: '전체', period: '전체', tag: '', sort: '최신순' };

  function setActive(container: Element | null, attr: string, value: string) {
    container?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      const v = b.dataset[attr];
      b.classList.toggle('active', v === value);
    });
  }

  function apply() {
    const q1 = state.query.trim().toLowerCase();
    let visible = results.filter((row) => {
      if (state.section !== '전체' && row.dataset.section !== state.section) return false;
      if (state.period !== '전체' && row.dataset.period !== state.period) return false;
      if (state.tag && !row.dataset.tags!.includes(state.tag.toLowerCase())) return false;
      if (q1) {
        const hay = `${row.dataset.title} ${row.dataset.summary} ${row.dataset.tags}`;
        if (!hay.includes(q1)) return false;
      }
      return true;
    });

    visible.sort((a, b) => {
      const diff = new Date(b.dataset.date!).valueOf() - new Date(a.dataset.date!).valueOf();
      return state.sort === '오래된순' ? -diff : diff;
    });

    results.forEach((r) => (r.hidden = true));
    visible.forEach((r) => {
      r.hidden = false;
      resultsWrap.appendChild(r);
    });

    const filtered = !!q1 || state.section !== '전체' || state.period !== '전체' || !!state.tag;
    resultLabel.textContent = filtered
      ? `검색 결과 ${visible.length}편`
      : `전체 ${visible.length}편 · ${state.sort}`;

    emptyState.hidden = visible.length > 0;
    resultsWrap.hidden = visible.length === 0;
  }

  q?.addEventListener('input', () => {
    state.query = q.value;
    apply();
  });
  clearBtn.addEventListener('click', () => {
    state.query = '';
    q.value = '';
    apply();
  });
  resetBtn.addEventListener('click', () => {
    state.query = '';
    state.section = '전체';
    state.period = '전체';
    state.tag = '';
    q.value = '';
    setActive(document.getElementById('section-chips'), 'section', '전체');
    setActive(document.getElementById('period-chips'), 'period', '전체');
    document.querySelectorAll('#tag-chips .chip').forEach((b) => b.classList.remove('active'));
    apply();
  });

  document.querySelectorAll<HTMLButtonElement>('.suggest-btn').forEach((b) => {
    b.addEventListener('click', () => {
      state.query = b.dataset.query || '';
      q.value = state.query;
      apply();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('#section-chips .chip').forEach((b) => {
    b.addEventListener('click', () => {
      state.section = b.dataset.section!;
      setActive(document.getElementById('section-chips'), 'section', state.section);
      apply();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('#period-chips .chip').forEach((b) => {
    b.addEventListener('click', () => {
      state.period = b.dataset.period!;
      setActive(document.getElementById('period-chips'), 'period', state.period);
      apply();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('#tag-chips .chip[data-tag]').forEach((b) => {
    b.addEventListener('click', () => {
      const t = b.dataset.tag!;
      state.tag = state.tag === t ? '' : t;
      document.querySelectorAll('#tag-chips .chip[data-tag]').forEach((x) => x.classList.remove('active'));
      if (state.tag) b.classList.add('active');
      apply();
    });
  });

  moreTags?.addEventListener('click', () => {
    document.querySelectorAll('.hidden-tag').forEach((el) => el.removeAttribute('hidden'));
    moreTags.setAttribute('hidden', '');
  });

  document.querySelectorAll<HTMLButtonElement>('.chip.sort').forEach((b) => {
    b.addEventListener('click', () => {
      state.sort = b.dataset.sort!;
      document.querySelectorAll('.chip.sort').forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      apply();
    });
  });

  apply();
</script>

<style>
  .archive-hero {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(22px, 5vw, 32px) clamp(14px, 4vw, 32px);
  }
  .archive-hero .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: #8c8c82;
  }
  .archive-hero h1 {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(24px, 4.6vw, 34px);
    line-height: 1.32;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .search-box {
    display: flex;
    align-items: center;
    margin-top: 20px;
    max-width: 720px;
    border: 1px solid var(--line-dark);
    background: #1c1c17;
  }
  .search-box input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    padding: 14px 16px;
    border: none;
    background: transparent;
    color: var(--on-dark);
    outline: none;
  }
  .search-box button {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 14px;
    color: #9a9a90;
    background: transparent;
    border: none;
    padding: 14px 16px;
    cursor: pointer;
  }
  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: #8c8c82;
  }
  .suggest-btn {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #c4c4bc;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-dark);
    padding: 0 0 2px;
    cursor: pointer;
  }
  .content-pad {
    padding: 18px clamp(14px, 4vw, 24px) 28px;
  }
  .filter-grid {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 10px 14px;
    align-items: start;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--meta-soft);
    padding-top: 5px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 5px 11px;
    border: 1px solid var(--line-frame);
    background: var(--card);
    color: #45453d;
    cursor: pointer;
    white-space: nowrap;
  }
  .chip.active {
    border-color: var(--chip-color, var(--ink));
    background: var(--chip-color, var(--ink));
    color: var(--card);
  }
  .chip.dashed {
    border-style: dashed;
    color: var(--meta-soft);
    background: transparent;
  }
  .result-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 0 10px;
  }
  .result-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
  }
  .results {
    border-top: 1px solid var(--ink);
  }
  .result-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    border-left: 4px solid;
    background: var(--card);
    align-items: start;
  }
  .result-row[hidden] {
    display: none;
  }
  .result-main {
    flex: 1 1 300px;
    min-width: 0;
  }
  .result-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .chip-tag {
    color: var(--card);
    padding: 3px 8px;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .byline {
    color: var(--meta);
  }
  .result-title {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2.1vw, 21px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.4;
    margin-top: 8px;
    word-break: keep-all;
  }
  .result-summary {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: #4d4d45;
    word-break: keep-all;
  }
  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .result-tags .tag {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    border: 1px solid var(--line);
    background: var(--card);
    padding: 2px 8px;
  }
  .result-side {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    justify-content: flex-end;
    min-width: 108px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    line-height: 1.8;
  }
  .empty-state {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 44px 24px;
    text-align: center;
  }
  .empty-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .empty-state p {
    margin: 10px auto 0;
    font-size: 15px;
    line-height: 1.7;
    color: #55554d;
    max-width: 46ch;
    word-break: keep-all;
  }
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 18px;
  }
  .empty-actions button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--on-dark);
    background: var(--ink);
    border: none;
    padding: 10px 18px;
    cursor: pointer;
  }
  .empty-actions a {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--ink);
    padding: 10px 18px;
  }
</style>
