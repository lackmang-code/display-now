---
// DISPLAY NOW 책 — 기사를 바탕으로 엮은 단행본. 홈 세 축 중 「책」.
// 목록은 `src/lib/books.ts` 한 곳. 판매 링크는 판매가 열린 뒤에만 그 파일에 넣는다.
// 출판사(발행) 명의는 넥스트아이오, DISPLAY NOW는 지은이(편집부)다.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookEntry from '../components/BookEntry.astro';
import { BOOKS } from '../lib/books';

// 한국어 책 먼저, 영문판은 아래 「English editions」에 따로(11/20 대표 「분리」)
const koBooks = BOOKS.filter((b) => b.lang !== 'en');
const enBooks = BOOKS.filter((b) => b.lang === 'en');
---

<Base title="책 | DISPLAY NOW" description="DISPLAY NOW 기사를 바탕으로 엮은 디스플레이 기술 단행본입니다.">
  <div class="frame dark-frame">
    <Header showNav={false} />

    <section class="pg-hero">
      <div class="eyebrow">DISPLAY NOW BOOKS</div>
      <h1>매주 쓴 기사를, 한 주제씩 책으로 묶습니다</h1>
    </section>

    <div class="content-pad">
      {koBooks.map((b) => <BookEntry book={b} />)}
      {
        enBooks.length > 0 && (
          <>
            <h2 class="group" lang="en">English editions</h2>
            {enBooks.map((b) => <BookEntry book={b} />)}
          </>
        )
      }
    </div>

    <Footer />
  </div>
</Base>

<style>
  .dark-frame {
    width: min(808px, 100%);
    background: var(--ink);
    color: var(--on-dark);
    border-left-color: var(--line-dark);
    border-right-color: var(--line-dark);
  }
  .pg-hero {
    padding: clamp(20px, 5vw, 28px) clamp(14px, 4vw, 32px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .pg-hero h1 {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(20px, 4.4vw, 32px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .content-pad {
    padding: 8px clamp(14px, 4vw, 32px) 36px;
  }
  .group {
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 2px solid var(--line-dark);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--gold);
    font-weight: 600;
  }
  /* 「English editions」 머리 바로 아래 칸은 구분선을 겹치지 않는다 */
  .group + :global(.book) {
    border-top: none;
  }
</style>
