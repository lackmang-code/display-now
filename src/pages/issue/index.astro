---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sectionColor } from '../../lib/sections';
import {
  getIssues,
  articlesOfIssue,
  issueNumberLabel,
  issueDateLabel,
  collectRangeLabel,
  SHOW_PUBLISH_DATE,
  issueHref,
} from '../../lib/issues';

const issues = getIssues();
const withCounts = await Promise.all(
  issues.map(async (issue) => {
    const list = await articlesOfIssue(issue);
    const head = issue.headSlug ? list.find((a) => a.slug === issue.headSlug) : list[0];
    // 카드 상단 띠는 그 호 헤드 기사의 꼭지 색. 호마다 색이 달라져 목록에서 서로 구분된다
    const band = head ? sectionColor(head.data.section) : 'var(--gold)';
    return { issue, count: list.length, band };
  }),
);
---

<Base title="지난 호 | DISPLAY NOW" description="DISPLAY NOW가 매주 화요일 발행하는 주간 호 목록입니다.">
  <div class="frame issue-frame">
    <Header showNav={false} />
    <div class="accent-strip">
      <span style={`background:${sectionColor('tech-note')};`}></span>
      <span style={`background:${sectionColor('paper')};`}></span>
      <span style={`background:${sectionColor('patent')};`}></span>
      <span style={`background:${sectionColor('issue')};`}></span>
    </div>

    <section class="issues-hero">
      <div class="eyebrow">지난 호</div>
      <h1>매주 화요일, 그 주의 디스플레이를 한 권으로 묶습니다</h1>
    </section>

    <div class="content-pad">
      {
        withCounts.length === 0 ? (
          <p class="empty">창간호를 준비하고 있습니다. 그동안 발행한 기사는 <a href="/archive">아카이브</a>에서 보실 수 있습니다.</p>
        ) : (
          <div class="issue-grid">
            {
              withCounts.map(({ issue, count, band }) => (
                <a href={issueHref(issue)} class="issue-card">
                  <div class="band" style={`background:${band};`} />
                  <div class="shot">
                    <img
                      src={`/issues/issue-${issue.no}-poster.png`}
                      alt={`${issueNumberLabel(issue)} 표지: ${issue.headline}`}
                      loading="lazy"
                    />
                  </div>
                  <div class="card-body">
                    <div class="card-no">
                      {issueNumberLabel(issue)} · {collectRangeLabel(issue)}
                      {SHOW_PUBLISH_DATE && <> · {issueDateLabel(issue)}</>}
                    </div>
                    <div class="card-title">{issue.headline}</div>
                    <div class="card-count">{count}편 수록</div>
                  </div>
                </a>
              ))
            }
          </div>
        )
      }
    </div>

    <Footer />
  </div>
</Base>

<style>
  /* 호 목록도 호 페이지와 같은 검정 판형으로 이어 붙인다 */
  .issue-frame {
    width: min(808px, 100%);
    background: var(--ink);
    color: var(--on-dark);
    border-left-color: var(--line-dark);
    border-right-color: var(--line-dark);
  }

  .issues-hero {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(20px, 5vw, 28px) clamp(14px, 4vw, 32px);
  }
  .issues-hero .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }
  .issues-hero h1 {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(20px, 4.4vw, 32px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
  }
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 32px;
  }
  .empty {
    font-size: 15px;
    line-height: 1.7;
    color: var(--on-dark-mute);
  }
  .empty a {
    color: var(--gold-dim);
  }
  .issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  /* 검정 지면 위에 표지를 책처럼 세운다. 회사 홈페이지 매거진 진열대와 같은 방식으로,
     경계를 선이 아니라 빛(흰 반투명 테두리)으로 긋고 아래로 그림자를 떨어뜨린다 */
  .issue-card {
    display: block;
    background: transparent;
    color: var(--on-dark);
    border: none;
  }
  .band {
    display: none;
  }
  /* 표지는 2:3 세로 판형이다. 제호·호수·커버라인이 표지 안에 이미 들어 있으므로
     카드에서 따로 덧씌우지 않는다 */
  .shot {
    position: relative;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
    /* 발광을 기본 상태에 켜 둔다. 표지가 모두 검정 판이라 빛이 없으면
       호끼리 경계가 붙어 보인다. 구분은 처음부터, 마우스는 떠오르는 동작만 */
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.6))
      drop-shadow(0 0 22px oklch(0.87 0.195 93 / 0.32))
      drop-shadow(0 0 60px oklch(0.87 0.195 93 / 0.2));
  }
  .shot img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
    /* 경계를 선이 아니라 빛으로 긋는다 */
    border: 1px solid oklch(0.87 0.195 93 / 0.42);
  }
  /* 마우스를 올리면 떠오르기만 한다. 발광은 그대로 둔다 */
  .issue-card:hover .shot {
    transform: translateY(-8px);
    filter: drop-shadow(0 24px 26px rgba(0, 0, 0, 0.65))
      drop-shadow(0 0 22px oklch(0.87 0.195 93 / 0.32))
      drop-shadow(0 0 60px oklch(0.87 0.195 93 / 0.2));
  }

  .card-body {
    padding: 12px 2px 0;
  }
  .card-no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .card-title {
    margin: 6px 0 8px;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .card-count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--meta);
  }
  .issue-grid {
    row-gap: 30px;
  }
</style>
