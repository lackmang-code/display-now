---
import { ISSUES, type IssueMeta } from '../../lib/issues';
import IssueView from '../../components/IssueView.astro';

export async function getStaticPaths() {
  return ISSUES.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

interface Props {
  issue: IssueMeta;
}

const { issue } = Astro.props;
---

<IssueView issue={issue} />
