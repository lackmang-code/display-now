---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';

const ROLES = [
  '공정 · 소재',
  '장비',
  '설계 · 회로',
  '연구개발',
  '기획 · 전략',
  '구매 · 영업',
  '투자 · 애널리스트',
  '학계 · 학생',
  '기타',
];
---

<Base
  title="구독 신청 | DISPLAY NOW"
  description="매주 화요일, 그 주의 디스플레이를 한 권으로 묶어 보내드립니다. DISPLAY NOW 뉴스레터 구독 신청."
>
  <div class="frame">
    <Header />

    <main class="sub-wrap">
      <p class="eyebrow">SUBSCRIBE</p>
      <h1>구독 신청</h1>
      <p class="tagline">
        매주 화요일, 그 주에 발행한 기사를 한 권으로 묶어 보내드립니다. 이메일 주소만 있으면 됩니다.
        나머지는 어떤 독자가 보고 있는지 파악하려는 것이니 편한 만큼만 적어 주십시오.
      </p>

      <form id="subForm" class="sf" novalidate>
        <div class="sf-full">
          <label class="sf-label" for="sf-email">이메일 <span class="sf-req">*</span></label>
          <input
            class="sf-input"
            id="sf-email"
            type="email"
            name="email"
            placeholder="뉴스레터를 받을 이메일 주소"
            autocomplete="email"
            required
          />
        </div>

        <div class="sf-row">
          <div class="sf-col">
            <label class="sf-label" for="sf-name">이름</label>
            <input class="sf-input" id="sf-name" type="text" name="name" placeholder="성함 (선택)" autocomplete="name" />
          </div>
          <div class="sf-col">
            <label class="sf-label" for="sf-org">소속 · 기관</label>
            <input class="sf-input" id="sf-org" type="text" name="org" placeholder="회사 · 학교 · 기관명 (선택)" autocomplete="organization" />
          </div>
        </div>

        <div class="sf-full">
          <label class="sf-label" for="sf-role">담당 업무</label>
          <select class="sf-input" id="sf-role" name="role">
            <option value="" selected>선택하지 않음</option>
            {ROLES.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>

        <div class="sf-full">
          <span class="sf-label">관심 꼭지 <span class="sf-opt">복수 선택</span></span>
          <div class="sf-chips">
            {
              SECTION_ORDER.map((key) => (
                <label class="sf-chip">
                  <input type="checkbox" name="interests" value={key} />
                  <span class="sf-dot" style={`background:${sectionColor(key)};`} />
                  <span>{SECTIONS[key].label}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div class="sf-full">
          <label class="sf-label" for="sf-note">편집국에 하고 싶은 말</label>
          <textarea
            class="sf-textarea"
            id="sf-note"
            name="note"
            placeholder="다뤄 줬으면 하는 주제, 지금 보고 있는 기술 (선택)"
          ></textarea>
        </div>

        {/* 사람에게는 보이지 않는 칸. 봇이 채우면 서버에서 걸러진다 */}
        <div class="sf-hp" aria-hidden="true">
          <label for="sf-website">Website</label>
          <input id="sf-website" type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="sf-actions">
          <label class="sf-agree">
            <input type="checkbox" id="sf-agree-chk" />
            <span>
              뉴스레터 발송을 위한 개인정보 수집·이용에 동의합니다.
              <a href="/privacy">개인정보처리방침</a>
            </span>
          </label>
          <button type="submit" class="sf-submit" id="sf-btn">구독 신청 →</button>
        </div>

        <p class="sf-error" id="sf-error" hidden></p>
      </form>

      <div id="subDone" class="sf-result" hidden>
        <div class="sf-result-icon">✓</div>
        <p class="sf-result-title" id="sf-done-title">구독 신청이 접수되었습니다</p>
        <p class="sf-result-sub" id="sf-done-sub">다음 호부터 보내드립니다. 감사합니다.</p>
        <a class="sf-result-btn" href="/">기사 보러 가기</a>
      </div>

      <div id="subFail" class="sf-result" hidden>
        <div class="sf-result-icon fail">✕</div>
        <p class="sf-result-title">접수에 실패했습니다</p>
        <p class="sf-result-sub" id="sf-fail-msg">잠시 후 다시 시도해 주십시오.</p>
        <button class="sf-result-btn" id="sf-again-btn" type="button">다시 신청하기</button>
      </div>

      <div class="sf-alt">
        <span class="sf-alt-text">메일 대신 카카오톡으로 받고 싶으시면 채널을 추가해 주십시오.</span>
        <a class="sf-kakao" href="https://pf.kakao.com/_ZGQiX" target="_blank" rel="noopener">
          <span class="kakao-dot" aria-hidden="true"></span>
          카카오톡 채널 추가
        </a>
      </div>

      <div class="sf-foot">
        <a class="sf-admin" href="/admin">관리자</a>
      </div>

      <div class="sf-notice">
        <p>수집 항목은 이메일 주소이며, 이름·소속·담당 업무·관심 꼭지·남기신 말은 선택 항목입니다.</p>
        <p>뉴스레터 발송 외의 목적으로 쓰지 않고 제3자에게 제공하지 않습니다.</p>
        <p>구독 해지는 <a href="mailto:info@nextio.ai.kr">info@nextio.ai.kr</a>로 알려 주시면 즉시 처리합니다.</p>
      </div>
    </main>

    <Footer />
  </div>
</Base>

<style>
  .sub-wrap {
    padding: 40px clamp(14px, 4vw, 32px) 64px;
    max-width: 720px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    color: var(--meta);
    margin: 0 0 6px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(28px, 5vw, 38px);
    letter-spacing: -0.035em;
    margin: 0 0 12px;
  }
  .tagline {
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--ink-soft);
    word-break: keep-all;
    margin: 0 0 28px;
  }

  .sf {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    padding: clamp(18px, 3.5vw, 28px);
  }
  /* display를 직접 지정한 요소는 hidden 속성만으로 감춰지지 않는다.
     UA 스타일시트의 [hidden]{display:none}보다 이쪽 선언이 우선하기 때문이다 */
  .sf[hidden],
  .sf-result[hidden] {
    display: none;
  }
  .sf-row {
    display: flex;
    gap: 14px;
  }
  .sf-col {
    flex: 1 1 0;
    min-width: 0;
  }
  .sf-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-bottom: 7px;
  }
  .sf-req {
    color: oklch(0.55 0.19 25);
  }
  .sf-opt {
    color: var(--meta);
    letter-spacing: 0.02em;
  }
  .sf-input,
  .sf-textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-frame);
    padding: 11px 12px;
  }
  .sf-textarea {
    min-height: 96px;
    line-height: 1.7;
    resize: vertical;
  }
  .sf-input:focus,
  .sf-textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: -1px;
  }
  .sf-input.bad {
    border-color: oklch(0.55 0.19 25);
  }

  .sf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sf-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
    border: 1px solid var(--line-frame);
    background: var(--paper);
    padding: 8px 12px;
    cursor: pointer;
  }
  .sf-chip:has(input:checked) {
    border-color: var(--ink);
    background: var(--card-warm);
  }
  .sf-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .sf-chip input {
    margin: 0;
  }

  /* 봇 유인용. 화면에서 완전히 감춘다 */
  .sf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sf-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line-soft);
    padding-top: 18px;
  }
  .sf-agree {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-mute);
    cursor: pointer;
    flex: 1 1 260px;
    word-break: keep-all;
  }
  .sf-agree a {
    border-bottom: 1px solid var(--line-frame);
  }
  .sf-submit {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--on-dark);
    background: var(--ink);
    border: none;
    padding: 12px 22px;
    cursor: pointer;
    flex: 0 0 auto;
  }
  .sf-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .sf-error {
    margin: 0;
    font-size: 14px;
    color: oklch(0.5 0.19 25);
  }

  .sf-result {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 44px 24px;
    text-align: center;
  }
  .sf-result-icon {
    font-size: 34px;
    line-height: 1;
    color: oklch(0.55 0.14 150);
    margin-bottom: 14px;
  }
  .sf-result-icon.fail {
    color: oklch(0.55 0.19 25);
  }
  .sf-result-title {
    font-family: var(--font-serif);
    font-size: 21px;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .sf-result-sub {
    font-size: 14.5px;
    color: var(--ink-mute);
    margin: 0 0 20px;
    word-break: keep-all;
  }
  .sf-result-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--ink);
    padding: 10px 20px;
    cursor: pointer;
  }

  .sf-alt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 22px;
    border: 1px solid var(--line);
    background: var(--card);
    padding: 14px 16px;
  }
  .sf-alt-text {
    font-size: 14px;
    color: var(--ink-mute);
    word-break: keep-all;
    flex: 1 1 240px;
  }
  /* 카카오 옐로는 점으로만 쓴다. 버튼을 노랗게 채우면 구독 버튼보다 튄다 */
  .sf-kakao {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 9px 16px;
    flex: 0 0 auto;
  }
  .kakao-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FEE500;
    flex: 0 0 auto;
  }

  .sf-foot {
    margin-top: 22px;
    text-align: right;
  }
  .sf-admin {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--meta);
    border-bottom: 1px solid var(--line-frame);
  }
  .sf-admin:hover {
    color: var(--ink);
  }

  .sf-notice {
    margin-top: 22px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--meta-soft);
    word-break: keep-all;
  }
  .sf-notice p {
    margin: 0 0 4px;
  }
  .sf-notice a {
    border-bottom: 1px solid var(--line-frame);
  }

  @media (max-width: 560px) {
    .sf-row {
      flex-direction: column;
      gap: 18px;
    }
    .sf-actions {
      align-items: stretch;
    }
    .sf-submit {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.getElementById('subForm') as HTMLFormElement | null;
  const btn = document.getElementById('sf-btn') as HTMLButtonElement | null;
  const agree = document.getElementById('sf-agree-chk') as HTMLInputElement | null;
  const emailInput = document.getElementById('sf-email') as HTMLInputElement | null;
  const errorEl = document.getElementById('sf-error');
  const done = document.getElementById('subDone');
  const fail = document.getElementById('subFail');
  const doneTitle = document.getElementById('sf-done-title');
  const doneSub = document.getElementById('sf-done-sub');
  const failMsg = document.getElementById('sf-fail-msg');
  const againBtn = document.getElementById('sf-again-btn');

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = '';
    emailInput?.classList.remove('bad');
  }

  againBtn?.addEventListener('click', () => {
    if (fail) fail.hidden = true;
    if (form) form.hidden = false;
    if (btn) {
      btn.disabled = false;
      btn.textContent = '구독 신청 →';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const email = (emailInput?.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailInput?.classList.add('bad');
      showError('이메일 주소를 확인해 주십시오.');
      emailInput?.focus();
      return;
    }
    if (!agree?.checked) {
      showError('개인정보 수집·이용에 동의해 주셔야 접수됩니다.');
      return;
    }

    const fd = new FormData(form);
    const payload = {
      email,
      name: String(fd.get('name') || ''),
      org: String(fd.get('org') || ''),
      role: String(fd.get('role') || ''),
      note: String(fd.get('note') || ''),
      interests: fd.getAll('interests').map(String),
      website: String(fd.get('website') || ''),
      source: 'subscribe-page',
    };

    if (btn) {
      btn.disabled = true;
      btn.textContent = '접수 중...';
    }

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (data.ok) {
        form.hidden = true;
        if (done) done.hidden = false;
        if (data.already) {
          if (doneTitle) doneTitle.textContent = '이미 구독 중이십니다';
          if (doneSub) doneSub.textContent = '적어 주신 내용으로 구독 정보를 갱신했습니다. 감사합니다.';
        }
        return;
      }

      if (data.error === 'invalid_email') {
        emailInput?.classList.add('bad');
        showError('이메일 주소를 확인해 주십시오.');
      } else {
        form.hidden = true;
        if (fail) fail.hidden = false;
        if (failMsg) failMsg.textContent = '서버가 신청을 저장하지 못했습니다. info@nextio.ai.kr로 알려 주시면 직접 등록해 드리겠습니다.';
      }
      if (btn) {
        btn.disabled = false;
        btn.textContent = '구독 신청 →';
      }
    } catch {
      form.hidden = true;
      if (fail) fail.hidden = false;
      if (failMsg) failMsg.textContent = '네트워크 오류입니다. 잠시 후 다시 시도해 주십시오.';
      if (btn) {
        btn.disabled = false;
        btn.textContent = '구독 신청 →';
      }
    }
  });
</script>
