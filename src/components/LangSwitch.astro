---
import type { Lang } from '../lib/articles';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 반대 언어판 경로. **짝이 있을 때만 이 컴포넌트를 세운다.** */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const ui = t(lang);
---

<a class="lang-switch" href={altHref} aria-label={ui.langSwitchAria} data-on={lang}>
  <span class="knob" aria-hidden="true"></span>
  <span class={lang === 'ko' ? 'seg on' : 'seg'}>KO</span>
  <span class={lang === 'en' ? 'seg on' : 'seg'}>EN</span>
</a>

<style>
  /* 밀기 스위치처럼 보이지만 실제로는 반대 언어 주소로 가는 링크다.
     한 페이지에 두 언어를 넣고 감췄다 보이는 방식은 정적 사이트에서 손해만 크다 —
     구글이 영문판을 존재하지 않는 것으로 취급하고 링크를 공유해도 언어가 안 따라간다. */
  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    flex: 0 0 auto;
    padding: 2px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: transparent;
    text-decoration: none;
    line-height: 1;
    user-select: none;
  }

  .knob {
    position: absolute;
    top: 2px;
    bottom: 2px;
    width: calc(50% - 2px);
    border-radius: 999px;
    background: var(--gold);
    transition: transform 0.18s ease;
    transform: translateX(0);
  }
  .lang-switch[data-on='en'] .knob {
    transform: translateX(100%);
  }

  .seg {
    position: relative;
    z-index: 1;
    padding: 4px 9px;
    min-width: 30px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--meta-soft);
    transition: color 0.18s ease;
  }
  .seg.on {
    color: #12120f;
  }

  .lang-switch:hover .seg:not(.on) {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
</style>
