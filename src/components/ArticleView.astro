---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimBoot from '../components/SimBoot.astro';
import '../styles/article.css';
import { SECTIONS, sectionColor } from '../lib/sections';
import {
  getPublishedArticles,
  dateLabel,
  articleHref,
  langOf,
  counterpartOf,
} from '../lib/articles';
import { t } from '../lib/i18n';
import { seriesOf, partOf, episodesOfPart, seriesKicker } from '../lib/series';
import { topicsOf, topicIndex } from '../lib/tags';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// 이 기사의 언어와, 짝이 있으면 그 주소. 짝이 없으면 전환 스위치도 hreflang도 달지 않는다.
const lang = langOf(entry);
const ui = t(lang);
const counterpart = await counterpartOf(entry);
// 영문 쪽은 꼭지 목록 페이지를 따로 두지 않는다. `/en` 한 장 안의 앵커로 보낸다 —
// 없는 페이지로 보내거나 한글 목록으로 흘리지 않기 위한 분기다.
const sectionListHref =
  lang === 'en' ? `/en#sec-${entry.data.section}` : `/section/${entry.data.section}`;
const altHref = counterpart ? articleHref(counterpart) : undefined;
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const section = SECTIONS[entry.data.section];
const sectionLabel = lang === 'en' ? section.labelEn : section.label;
const color = sectionColor(entry.data.section);

// 연재 목차·다른 글에는 발행된 기사만 세운다. 다만 지금 읽고 있는 기사가 아직 발행 전이면
// (검수 중) 자기가 목차에서 빠져 어색해지므로 그 한 편만 되넣는다.
const published = await getPublishedArticles(lang);

/** 소급 번역분 고지를 세울지. **발행일만으로 판정하면 틀린 고지가 붙는다.**
 *
 * 「그림 안은 영어」는 제4호(2026-09-08)부터이고 소급하지 않는다(2026-09-05 대표 판단).
 * 그러나 그 전 기사라도 **우리가 직접 그린 것이 없으면** 고지할 것이 없다 —
 * 논문·특허에서 가져온 인용 도판은 원본 그대로가 규칙이라 애초에 한국어가 아니다.
 * 그래서 발행일과 **직접 그린 도판·시뮬레이터의 존재**를 함께 본다. */
const hasKoreanFigures =
  entry.data.publishedAt.toISOString().slice(0, 10) < '2026-09-08' &&
  (entry.body.includes('data-sim=') ||
    entry.body.includes('<svg') ||
    entry.body.includes('.svg'));
const all = published.some((a) => a.slug === entry.slug)
  ? published
  : [entry, ...published].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const reporterInitial = entry.data.reporter[0];

// 연재 정보. 같은 부의 다른 편들이 있으면 기사 끝에 목차를 세운다.
const series = seriesOf(entry);
const seriesPart = partOf(entry);
const kicker = seriesKicker(entry);
const siblings =
  series && entry.data.series ? episodesOfPart(all, series.id, entry.data.series.part) : [];
const hasSeriesNav = siblings.length > 1;

// 연재 편이면 "다른 글" 자리를 연재 목차가 대신한다. 같은 목록을 두 번 보여줄 이유가 없다.
const related = hasSeriesNav
  ? []
  : all.filter((a) => a.slug !== entry.slug && a.data.section === entry.data.section).slice(0, 3);

// 이 기사가 속한 주제. 페이지가 실제로 존재하는(기사 2편 이상) 주제만 링크로 건다.
// 기사마다 주제 허브로 나가는 링크가 생기면 크롤러가 사이트 안을 돌아다닐 길이 열린다.
const liveTopics = new Set(topicIndex(published).map((g) => g.topic.slug));
const topics = topicsOf(entry).filter((t) => liveTopics.has(t.slug));

// 검색엔진에 보내는 제목. 화면 제목(h1)은 언제나 entry.data.title 그대로다.
const seoTitle = entry.data.searchTitle ?? entry.data.title;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: seoTitle,
  alternativeHeadline: entry.data.title,
  description: entry.data.summary,
  inLanguage: lang,
  articleSection: sectionLabel,
  keywords: entry.data.tags.join(', '),
  about: topics.map((t) => ({
    '@type': 'Thing',
    name: t.label,
    url: new URL(`/tag/${t.slug}`, Astro.site).toString(),
  })),
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.publishedAt.toISOString(),
  image: [new URL(`/og/${entry.slug}.png`, Astro.site).toString()],
  author: {
    '@type': 'Organization',
    name: lang === 'en' ? `${entry.data.reporter} (AI reporter)` : `${entry.data.reporter} (AI 기자)`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'DISPLAY NOW',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo/dn-lockup-reverse.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(articleHref(entry), Astro.site).toString(),
  },
};
---

<Base
  title={`${seoTitle} | DISPLAY NOW`}
  description={entry.data.summary}
  image={`/og/${entry.slug}.png`}
  lang={lang}
  altHref={altHref}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <div class="frame">
    <Header activeSection={entry.data.section} lang={lang} altHref={altHref} />
    <div class="accent-line" style={`background:${color};`}></div>

    <div class="article-layout">
      <aside class="toc-aside">
        <div class="toc-label" style={`color:${color}; border-bottom-color:${color};`}>{ui.toc}</div>
        <nav class="toc-nav">
          {
            toc.map((h) => (
              <a href={`#${h.slug}`} style={`border-left-color:${color};`}>{h.text}</a>
            ))
          }
        </nav>
        <div class="toc-meta">
          <div>{ui.readingTime(entry.data.readingMinutes)}</div>
        </div>
        {
          entry.data.sources.length > 0 && (
            <div class="toc-sources">
              <div class="toc-sub-label">{ui.sourceMaterial}</div>
              <div class="src-count">{ui.sourceCount(entry.data.sources.length)}</div>
            </div>
          )
        }
      </aside>

      <div class="article-main">
        <article class="article-body" style={`--section-color:${color};`} data-paywall-after={entry.data.paywallAfter}
            data-paywall-title={ui.paywallTitle}
            data-paywall-body={ui.paywallBody}
            data-paywall-cta={ui.paywallCta}>
          <div class="top-meta">
            <a href={sectionListHref} style={`border-bottom-color:${color};`}>{sectionLabel}</a>
            <span>{dateLabel(entry)} · {ui.readingTime(entry.data.readingMinutes)}</span>
          </div>

          {
            kicker && (
              <div class="series-kicker" style={`color:${color}; border-color:${color};`}>
                <span class="series-kicker-label">{ui.seriesKicker}</span>
                {kicker}
              </div>
            )
          }

          <h1 class="headline">{entry.data.title}</h1>
          <p class="dek">{entry.data.summary}</p>

          <div class="byline-box">
            <span class="reporter-badge">{reporterInitial}</span>
            <span><span class="dim">{ui.byPrefix}</span> <b>{entry.data.reporter}</b> <span class="dim">{ui.reporterRole(sectionLabel)}</span></span>
            <span class="sep">|</span>
            <span><span class="dim">{ui.editorLabel}</span> <b>DEEPLE</b></span>
          </div>

          {/* 소급 번역분 고지. 「그림 안은 영어」는 제4호(2026-09-08)부터라
              그 전에 발행된 기사는 그림 안 글자가 한국어다. 소급해 고치지 않기로 했으므로
              (2026-09-05 대표 판단) 영문판에서만 사실을 밝힌다. 읽을 수 있는 것이
              무엇인지 함께 알려야 사과가 아니라 안내가 된다.
              프론트매터 플래그를 두면 누군가 반드시 빠뜨리므로 발행일로 자동 판정한다. */}
          {lang === 'en' && hasKoreanFigures && (
            <p class="legacy-figure-notice">{ui.legacyFigureNotice}</p>
          )}

          <Content />
        </article>

        <SimBoot />

        {
          entry.data.sources.length > 0 && (
            <section class="sources-box">
              <div class="sources-head">
                <span class="reporter-badge">{reporterInitial}</span>
                <span class="sources-label">{ui.sourcesTitle}</span>
                <span class="sources-sign">
                  {lang === 'en' ? (
                    <>Written by AI reporter <b>{entry.data.reporter}</b> · Edited by AI editor-in-chief <b>DEEPLE</b></>
                  ) : (
                    <>AI 기자 <b>{entry.data.reporter}</b> 작성 · AI 편집장 <b>DEEPLE</b> 편집 완료</>
                  )}
                </span>
              </div>
              {
                entry.data.sources.length === 1 ? (
                  <p class="sources-note">
                    {ui.singlePaperNote}{entry.data.sources[0].url && <>. <a href={entry.data.sources[0].url} target="_blank" rel="noopener">{ui.openOriginal}</a></>}.
                  </p>
                ) : (
                  <ul class="sources-list">
                    {
                      entry.data.sources.map((s) => (
                        <li>
                          <span class="src-type">{s.type}</span>
                          {s.url ? (
                            <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
                          ) : (
                            <span>{s.title}{s.number ? ` (${s.number})` : ''}</span>
                          )}
                        </li>
                      ))
                    }
                  </ul>
                )
              }
            </section>
          )
        }

        {/* 정정 요청이 가장 자연스럽게 나오는 자리는 근거를 확인한 직후다 */}
        <aside class="correction">
          <span class="correction-text">
            {ui.correctionAsk}
          </span>
          <a class="correction-link" href="/board?kind=%EC%A0%95%EC%A0%95%20%EC%9A%94%EC%B2%AD">{ui.correctionLink}</a>
        </aside>

        {
          topics.length > 0 && (
            <nav class="topic-chips" aria-label={ui.topicsAria}>
              <span class="topic-chips-label">{ui.topicsLabel}</span>
              {topics.map((t) => (
                <a href={`/tag/${t.slug}`} class="topic-chip">
                  {t.label}
                </a>
              ))}
            </nav>
          )
        }

        {
          hasSeriesNav && seriesPart && (
            <section class="series-box" style={`--section-color:${color};`}>
              <div class="series-head">
                <div class="series-part-no" style={`color:${color};`}>{ui.partNo(seriesPart.part)}</div>
                <div>
                  <div class="series-part-title">{seriesPart.title}</div>
                  <div class="series-part-deck">{seriesPart.deck}</div>
                </div>
              </div>

              <ol class="series-list">
                {siblings.map((a) => {
                  const here = a.slug === entry.slug;
                  return (
                    <li class={here ? 'here' : ''}>
                      <span class="ep" style={here ? `background:${color}; color:#fff; border-color:${color};` : ''}>
                        {a.data.series!.episode}
                      </span>
                      {here ? (
                        <span class="ep-title">{a.data.title}<span class="ep-now">{ui.readingNow}</span></span>
                      ) : (
                        <a class="ep-title" href={articleHref(a)}>{a.data.title}</a>
                      )}
                    </li>
                  );
                })}
              </ol>

              {seriesPart.status === 'ongoing' && (
                <p class="series-foot">
                  {seriesPart.closesWith ? ui.seriesClosesWith(seriesPart.closesWith) : ''}
                  {ui.seriesStandalone}
                </p>
              )}
              {seriesPart.status === 'done' && seriesPart.closesWith && (
                <p class="series-foot">{ui.seriesClosedWith(seriesPart.closesWith)}{ui.seriesStandalone}</p>
              )}
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="related">
              <a href={sectionListHref} class="related-head">{ui.moreFrom(sectionLabel, entry.data.reporter)}</a>
              <div class="related-grid">
                {related.map((a) => (
                  <a href={articleHref(a)} class="related-item">
                    <div class="related-date">{dateLabel(a)} · {ui.minutes(a.data.readingMinutes)}</div>
                    <div class="related-title">{a.data.title}</div>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <section class="newsletter-strip">
          <div style="flex:1 1 320px; min-width:0;">
            <div style="font-family:var(--font-serif); font-size:19px; font-weight:600; letter-spacing:-0.03em;">{ui.ctaHead}</div>
            <p style="margin:6px 0 0; font-size:14px; line-height:1.7; color:var(--ink-faint); word-break:keep-all;">{ui.ctaSub}</p>
          </div>
          <form onsubmit="return false;">
            <input type="email" placeholder={ui.emailPlaceholder} />
            <button type="submit">{ui.subscribeShort}</button>
          </form>
        </section>

        <div style="height:40px;"></div>
      </div>
    </div>

    <Footer lang={lang} />
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.article-body[data-paywall-after]').forEach((article) => {
    const n = Number(article.dataset.paywallAfter || '0');
    if (!n) return;

    const sections = Array.from(article.querySelectorAll('h2'));
    const boundary = sections[n];
    if (!boundary) return;

    const gate = document.createElement('div');
    gate.id = 'paywall';
    gate.className = 'paywall-box';
    gate.innerHTML = `
      <div class="paywall-title">${article.dataset.paywallTitle ?? ''}</div>
      <p>${article.dataset.paywallBody ?? ''}</p>
      <a class="paywall-cta" href="/editorial#구독">${article.dataset.paywallCta ?? ''}</a>
    `;
    boundary.before(gate);

    let el: Element | null = boundary;
    while (el) {
      const next: Element | null = el.nextElementSibling;
      el.classList.add('paywall-hidden');
      el = next;
    }
  });
</script>

<style>
  /* 소급 번역분 고지 — 사과가 아니라 안내이므로 본문 앞에 조용히 둔다 */
  .legacy-figure-notice {
    margin: 0 0 22px;
    padding: 10px 14px;
    border-left: 3px solid rgba(0, 0, 0, 0.18);
    background: rgba(0, 0, 0, 0.035);
    font-size: 13.5px;
    line-height: 1.6;
    color: #6f6f66;
  }

  .accent-line {
    height: 3px;
  }
  .topic-chips {
    /* 부속 블록이므로 880px(README "기사 페이지는 폭이 두 가지"). 본문 700px이 아니다.
       종전에는 폭 제한 없이 margin clamp만 있어서 오른쪽은 부속 블록과 맞는데
       왼쪽만 26px 안으로 밀려 있었다(2026-08-31 발견). */
    max-width: 700px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    /* 좌우 여백은 .article-main 패딩이 이미 준다. clamp로 한 번 더 주면 왼쪽이 밀린다. */
    margin: 0 0 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
  }
  .topic-chips-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
    margin-right: 4px;
  }
  .topic-chip {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #45453d;
    border: 1px solid var(--line-frame);
    padding: 5px 11px;
    white-space: nowrap;
  }
  .topic-chip:hover {
    color: var(--card);
    background: var(--ink);
    border-color: var(--ink);
  }
  .article-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .toc-aside {
    position: sticky;
    top: 56px;
    flex: 1 1 216px;
    max-width: 216px;
    min-width: 0;
    padding: 32px 20px 40px clamp(14px, 4vw, 26px);
    border-right: 1px solid var(--line-soft);
    align-self: start;
  }
  .toc-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    padding-bottom: 8px;
    border-bottom: 2px solid;
  }
  .toc-nav {
    display: flex;
    flex-direction: column;
    margin-top: 2px;
  }
  .toc-nav a {
    font-size: 14px;
    line-height: 1.5;
    padding: 9px 0 9px 10px;
    border-left: 2px solid var(--line-soft);
    color: #55554d;
    word-break: keep-all;
  }
  .toc-meta,
  .toc-sources {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.9;
  }
  .toc-sub-label {
    letter-spacing: 0.08em;
  }
  .article-main {
    flex: 1 1 520px;
    min-width: 0;
    padding: 32px clamp(14px, 4vw, 26px) 0 clamp(14px, 4vw, 32px);
  }
  .top-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    letter-spacing: 0.05em;
  }
  .top-meta a {
    color: var(--ink);
    border-bottom: 2px solid;
    padding-bottom: 2px;
  }
  .headline {
    margin: 16px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 42px);
    line-height: 1.28;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
    max-width: 700px;
  }
  .dek {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.75;
    color: #45453d;
    word-break: keep-all;
    max-width: 700px;
  }
  /* tokens.css의 .newsletter-strip 은 880px이고 섹션 페이지와 공유한다.
     기사 페이지에서만 본문 폭에 맞춘다. */
  .newsletter-strip {
    max-width: 700px;
  }
  .correction {
    /* 부속 블록 폭(880px). 이 블록만 max-width가 없어 .article-main(962px)을
       그대로 채우는 바람에 904px로 혼자 튀어나와 있었다(2026-08-31 발견). */
    max-width: 700px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    background: var(--card);
    padding: 14px 16px;
    margin-top: 22px;
  }
  .correction-text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-mute);
    word-break: keep-all;
    flex: 1 1 260px;
  }
  .correction-link {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    flex: 0 0 auto;
  }

  /* 연재 표기는 제목 위로 올린다. 제목 안에 편 번호를 넣으면 목록에서 후크가 죽는다 */
  .series-kicker {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
    margin-bottom: 14px;
  }
  .series-kicker-label {
    font-size: 10.5px;
    letter-spacing: 0.22em;
    opacity: 0.72;
  }

  .series-box {
    margin: 44px 0 0;
    max-width: 700px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--section-color);
    background: var(--card);
    padding: 20px 22px 18px;
  }
  .series-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-soft);
  }
  .series-part-no {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    flex: 0 0 auto;
    padding-top: 3px;
  }
  .series-part-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .series-part-deck {
    margin-top: 3px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-mute);
    word-break: keep-all;
  }
  .series-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  .series-list li {
    display: flex;
