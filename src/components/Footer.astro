---
import { SECTIONS, SECTION_ORDER } from '../lib/sections';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/articles';

interface Props {
  lang?: Lang;
}

const { lang = 'ko' } = Astro.props;
const ui = t(lang);
const en = lang === 'en';
---

<footer class="site-footer">
  <div class="inner">
    <div>
      <div class="brand">DISPLAY NOW</div>
      {/*
        한글 표기를 사람이 읽는 본문에 남긴다. 사이트 전체가 영문 워드마크뿐이라
        "디스플레이 나우"로 검색하면 이 매체가 아예 잡히지 않았다(2026-08-24 확인).
        구조화 데이터의 alternateName만으로는 부족하고, 실제 글자가 페이지에 있어야 한다.
        모든 페이지에 들어가는 푸터가 그 자리로 가장 적절하다.
      */}
      <div style="margin-top:6px;">{ui.footerBlurb}</div>
      <div style="margin-top:8px;">{ui.footerPublisher}</div>
      <div>{ui.footerEmail} <a href="mailto:info@nextio.ai.kr" style="color:#c4c4bc;">info@nextio.ai.kr</a> · {ui.footerPhone} 010-3938-6918</div>
    </div>
    <div style="text-align:right;">
      {/*
        꼭지 네 개를 푸터에 세운다. 상단 내비에서 꼭지를 풀다운 안으로 넣으면
        좁은 화면에서 이 링크들이 기본 상태에서 감춰진다. 구글은 모바일 화면을 기준으로
        색인하므로 감춰진 링크는 값이 깎인다. 모든 페이지에 들어가는 푸터가 그 대안이다.
      */}
      <div class="links">
        {SECTION_ORDER.map((key) => (
          <a href={en ? `/en#sec-${key}` : `/section/${key}`}>{lang === 'en' ? SECTIONS[key].labelEn : SECTIONS[key].label}</a>
        ))}
      </div>
      <div class="links">
        <a href={en ? '/en/issue' : '/issue'}>{ui.issues}</a>
        <a href={en ? '/en/archive' : '/archive'}>{ui.archive}</a>
        {!en && <a href="/tag">{ui.topics}</a>}
        <a href={en ? '/en/editorial' : '/editorial'}>{ui.editorial}</a>
        <a href={en ? 'mailto:info@nextio.ai.kr?subject=Correction' : '/board?kind=%EC%A0%95%EC%A0%95%20%EC%9A%94%EC%B2%AD'}>{ui.corrections}</a>
        <a href={en ? 'mailto:info@nextio.ai.kr?subject=Advertising' : '/board?kind=%EA%B4%91%EA%B3%A0%20%EB%AC%B8%EC%9D%98'}>{ui.adInquiry}</a>
        <a href={en ? '/en/privacy' : '/privacy'}>{ui.privacy}</a>
        <a href={en ? '/en/terms' : '/terms'}>{ui.terms}</a>
      </div>
      <div class="copy">{ui.footerCopy}</div>
    </div>
  </div>
</footer>
