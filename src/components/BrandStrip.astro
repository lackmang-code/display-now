---
/**
 * 홈 PC 맨 위 — 매거진 2/3 · TV 1/3 (10/31 대표).
 *
 * 매거진 칸은 이번 호를 카드로 펼친다. 최신 글 목록을 따로 두지 않으므로(랜딩을 한눈에)
 * 이번 호 기사는 여기가 홈에서 보이는 유일한 자리다.
 * 책은 아래 BOOKS 구역에 있다.
 *
 * 영문 홈도 같은 띠를 쓴다(11/16 대표). 영문은 영문 호·영문판 기사, TV는 영어판이 있는 최신 편
 * (없으면 한국어 영상 + 「English subtitles」). 모바일 한글 지면은 HomeMobile이 따로 그린다.
 */
import { issueHref, issueNumberLabel, issueDateLabel, type IssueMeta } from '../lib/issues';
import { SECTIONS, sectionColor } from '../lib/sections';
import { articleHref, type Article, type Lang } from '../lib/articles';
import { leadVideo, videoHref } from '../lib/videos';
import { issueThumbSrc } from '../lib/issueThumb';

interface Props {
  latestIssue?: IssueMeta;
  issueArticles?: Article[];
  lang?: Lang;
}
const { latestIssue, issueArticles = [], lang = 'ko' } = Astro.props;
const en = lang === 'en';

const video = leadVideo(lang);

const coverSrc = latestIssue ? issueThumbSrc(latestIssue.no, lang) : '';
const headline = latestIssue ? (en ? latestIssue.headlineEn ?? latestIssue.headline : latestIssue.headline) : '';
// 영상 표지는 한글 호에만 선다(영문 호는 coverSim 그대로)
const coverKind = !latestIssue
  ? ''
  : !en && latestIssue.coverVideo?.youtubeId
    ? ' · 표지는 영상'
    : latestIssue.coverSim
      ? en ? ' · cover is a simulation' : ' · 표지는 시뮬레이션'
      : '';
const L = en
  ? { cover: 'Open cover →', mag: 'MAGAZINE · THIS ISSUE', count: (n: number) => `${n} article${n === 1 ? '' : 's'}`, tv: 'DISPLAY NOW TV · LATEST', go: 'Watch on YouTube →', cc: 'English subtitles' }
  : { cover: '표지 열기 →', mag: 'MAGAZINE · 이번 호', count: (n: number) => `${n}편`, tv: 'DISPLAY NOW TV · 최신 영상', go: '유튜브에서 보기 →', cc: '' };
---

<div class:list={['axes', { solo: !video }]}>
  {
    latestIssue && (
      <div class="ax ax-mag">
        <a class="mag-cover" href={issueHref(latestIssue, lang)}>
          <img src={coverSrc} alt={en ? `${issueNumberLabel(latestIssue, lang)} cover: ${headline}` : `${issueNumberLabel(latestIssue)} 표지: ${headline}`} width="400" height="600" decoding="async" />
          <span class="ax-go">{L.cover}</span>
        </a>
        <div class="mag-body">
        <a class="mag-top" href={issueHref(latestIssue, lang)}>
          <span class="ax-label">{L.mag}</span>
          <span class="mag-no">
            {issueNumberLabel(latestIssue, lang)} · {issueDateLabel(latestIssue)} · {L.count(issueArticles.length)}
            {coverKind}
          </span>
          <span class="mag-head">{headline}</span>
        </a>
        <ol class="toc">
          {issueArticles.map((a) => (
            <li>
              <a href={articleHref(a)}>
                <span class="t-sec">
                  <i style={`background:${sectionColor(a.data.section)};`} />
                  {en ? SECTIONS[a.data.section].labelEn : SECTIONS[a.data.section].label}
                </span>
                <span class="t-title">{a.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
        </div>
      </div>
    )
  }
  {
    video && (
      <a class="ax ax-tv" href={videoHref(video)} target="_blank" rel="noopener">
        <span class="ax-label">{L.tv}</span>
        <span class="tv-thumb">
          <img src={video.thumb} alt="" width="640" height="360" loading="lazy" decoding="async" />
          <span class="tv-play" aria-hidden="true" />
          <span class="tv-dur">{video.duration}</span>
        </span>
        <span class="tv-title">{video.title}</span>
        {video.subtitled && <span class="tv-cc">{L.cc}</span>}
        <span class="tv-go">{L.go}</span>
      </a>
    )
  }
</div>

<style>
  .axes {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
    background: var(--ink);
  }
  .axes.solo {
    grid-template-columns: 1fr;
  }
  .ax {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 16px clamp(14px, 2.2vw, 24px) 18px;
    text-decoration: none;
    color: inherit;
  }
  .ax-label {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  /* 매거진 — 종전 이번 호 배너의 금색 */
  .ax-mag {
    flex-direction: row;
    gap: 18px;
    background: var(--gold);
    color: #17170f;
  }
  /* 표지 썸네일 — 호 목록(/issue)처럼 책을 세워 둔 모양 */
  .mag-cover {
    flex: 0 0 auto;
    width: clamp(150px, 15vw, 196px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .mag-cover img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
  }
  .mag-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mag-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }
  .mag-no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(23, 23, 15, 0.66);
  }
  .mag-head {
    font-family: var(--font-serif);
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .ax-go {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  /* 이번 호 기사 — 상자 없이 목차처럼 한 줄씩(10/31 대표). 꼭지는 색 점 + 이름 */
  .toc {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    border-top: 1px solid rgba(23, 23, 15, 0.28);
  }
  .toc a {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 9px 2px;
    border-bottom: 1px solid rgba(23, 23, 15, 0.16);
    color: #17170f;
    text-decoration: none;
  }
  .toc a:hover .t-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .t-sec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .t-sec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .t-title {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  /* TV — 흰 카드(11/5 대표 「영상도 검고 박스도 검어서 안 보인다」). 검은 썸네일이 흰 바탕에 또렷이 선다 */
  .ax-tv {
    background: #fbfaf6;
    color: #17170f;
  }
  .ax-tv .ax-label {
    color: #17170f;
  }
  .tv-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }
  .tv-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 재생 표시 — 유튜브 로고를 쓰지 않고 삼각형만 그린다 */
  .tv-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.62);
  }
  .tv-play::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 14px;
    border-style: solid;
    border-width: 10px 0 10px 16px;
    border-color: transparent transparent transparent #fff;
  }
  .tv-dur {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 1px 6px;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .tv-title {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .tv-cc {
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(23, 23, 15, 0.66);
  }
  .tv-go {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: #17170f;
  }

  /* 좁은 PC 폭(821~1000px) — 카드 두 줄, TV는 아래로 */
  @media (max-width: 1000px) {
    .axes {
      grid-template-columns: 1fr;
    }
  }
  /* 폰 폭 — 영문 홈은 모바일 지면이 따로 없어 이 띠가 좁은 폭까지 내려온다. 표지를 위로 */
  @media (max-width: 560px) {
    .axes {
      padding: 10px;
      gap: 10px;
    }
    .ax-mag {
      flex-direction: column;
    }
    .mag-cover {
      width: min(180px, 60%);
    }
    .toc a {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
