---
/**
 * 한글 홈 아래쪽 책장 — 매거진 · TV · 책을 썸네일로 최신부터 진열한다(10/31 대표).
 *
 *   magazine — 호 표지(최신 12호), 머리에 꼭지 바로가기 칩
 *   tv       — 영상 썸네일(최신 12편)
 *   books    — 책 표지
 *
 * 줄이 넘치면 좌우 화살표(또는 손가락)로 밀어 본다. 넘치지 않으면 화살표는 숨는다(11/5 대표).
 * 줄 끝 「이전 호·유튜브 채널·책 전체」 칸은 머리의 「… 전체 →」와 겹쳐 뺐다(11/5 대표).
 * 기자 소개는 편집국 페이지에 있으니 여기 싣지 않는다(10/31 대표).
 *
 * 영문 홈(`lang='en'`)의 책장은 영문 책(`books.ts`의 `lang: 'en'`)만 싣는다. 영문판은 한국어판과 별도의 책(11/20 대표). 영문 호·영문 포스터,
 * 영상은 영어판이 있으면 그것, 없으면 한국어 영상에 「EN subtitles」.
 */
import { getIssues, getIssuesEn, issueHref, issueNumberLabel, issueDateLabel } from '../lib/issues';
import { issueThumbSrc } from '../lib/issueThumb';
import { videosFor, videoHref, CHANNEL_URL } from '../lib/videos';
import { BOOKS, bookDateLabel } from '../lib/books';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { getPublishedArticles, type Lang } from '../lib/articles';

interface Props {
  which: 'magazine' | 'tv' | 'books';
  mobile?: boolean;
  lang?: Lang;
}
const { which, mobile = false, lang = 'ko' } = Astro.props;
const en = lang === 'en';

const ISSUE_COUNT = 12;
const VIDEO_COUNT = 12;

const issues = which === 'magazine' ? (en ? getIssuesEn() : getIssues()).slice(0, ISSUE_COUNT) : [];
const videos = which === 'tv' ? videosFor(lang).slice(0, VIDEO_COUNT) : [];
const books = which === 'books' && !en ? BOOKS : [];
/** 영문 홈 책장 — 영문판이 판매 중인 책만. 표지를 누르면 판매처로 바로 간다(영문 책 페이지는 없다) */
const booksEn = which === 'books' && en ? BOOKS.filter((b) => b.lang === 'en') : [];
const bookHref = (b: (typeof BOOKS)[number]) => (b.links[0]?.href ?? '/books');
const enDate = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const published = which === 'magazine' ? await getPublishedArticles(lang) : [];
const sectionCount = (key: string) => published.filter((a) => a.data.section === key).length;

const HEAD = (en ? {
  magazine: { label: 'MAGAZINE', sub: 'Published every Tuesday', more: '/en/issue', moreLabel: 'All issues' },
  tv: { label: 'DISPLAY NOW TV', sub: 'Principles in moving pictures', more: CHANNEL_URL, moreLabel: 'YouTube channel' },
  books: { label: 'BOOKS', sub: 'English editions', more: '', moreLabel: '' },
} : {
  magazine: { label: 'MAGAZINE', sub: '매주 화요일 발행', more: '/issue', moreLabel: '지난 호 전체' },
  tv: { label: 'DISPLAY NOW TV', sub: '원리를 움직이는 그림으로', more: '/tv', moreLabel: '영상 전체' },
  books: { label: 'BOOKS', sub: '기사를 주제별로 엮은 책', more: '/books', moreLabel: '책 전체' },
})[which];

const empty = issues.length + videos.length + books.length + booksEn.length === 0;
---

{
  !empty && (
    <section class:list={['shelf', `s-${which}`, { mobile }]}>
      <div class="sh">
        <span class="sh-label">{HEAD.label}</span>
        <span class="sh-sub">{HEAD.sub}</span>
        {HEAD.more && <a class="sh-more" href={HEAD.more} {...(HEAD.more.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{HEAD.moreLabel} →</a>}
      </div>

      {which === 'magazine' && (
        <nav class="chips" aria-label={en ? 'Sections' : '꼭지'}>
          {SECTION_ORDER.map((key) => (
            <a class="chip" href={en ? `/en/archive?section=${key}` : `/section/${key}`}>
              <i style={`background:${sectionColor(key)};`} />
              {en ? SECTIONS[key].labelEn : SECTIONS[key].label}
              <b>{sectionCount(key)}</b>
            </a>
          ))}
          <a class="chip" href={en ? '/en/archive' : '/archive'}>{en ? 'Archive · search' : '아카이브·검색'} <b>{published.length}</b></a>
        </nav>
      )}

      <div class="rowwrap">
      <button class="nav prev" type="button" aria-label={en ? 'Previous' : '앞쪽 보기'} hidden>‹</button>
      <div class="row">
        {issues.map((i) => (
          <a class="tile tall" href={issueHref(i, lang)}>
            <img src={issueThumbSrc(i.no, lang)} alt={en ? `${issueNumberLabel(i, lang)} cover: ${i.headlineEn}` : `${issueNumberLabel(i)} 표지: ${i.headline}`} width="600" height="900" loading="lazy" decoding="async" />
            <span class="cap"><b>{issueNumberLabel(i, lang)}</b>{' · '}{issueDateLabel(i).slice(5)}</span>
          </a>
        ))}

        {videos.map((v) => (
          <a class="tile wide" href={videoHref(v)} target="_blank" rel="noopener">
            <span class="vthumb">
              <img src={v.thumb} alt="" width="640" height="360" loading="lazy" decoding="async" />
              <span class="play" aria-hidden="true" />
              <span class="dur">{v.duration}</span>
            </span>
            <span class="cap vcap">{v.title}</span>
            {v.subtitled && <span class="cc">EN subtitles</span>}
          </a>
        ))}

        {books.map((b) => (
          <a class="tile tall book" href={`/books#${b.slug}`}>
            <img src={b.cover} alt={`${b.title} 표지`} width={b.coverW} height={b.coverH} loading="lazy" decoding="async" />
            <span class="cap"><b>{b.lang === 'en' ? b.title : `『${b.title}』`}</b><br />{bookDateLabel(b.date)} 출간{b.lang === 'en' && ' · 영문판'}</span>
          </a>
        ))}

        {booksEn.map((b) => (
          <a class="tile tall book" href={bookHref(b)} target="_blank" rel="noopener">
            <img src={b.cover} alt={`${b.title} cover`} width={b.coverW} height={b.coverH} loading="lazy" decoding="async" />
            <span class="cap"><b>{b.title}</b><br />{b.capEn}<br />{enDate(b.date)}</span>
          </a>
        ))}

      </div>
      <button class="nav next" type="button" aria-label={en ? 'Next' : '뒤쪽 보기'} hidden>›</button>
      </div>
    </section>
  )
}

<script>
  // 줄이 넘칠 때만 화살표를 보이고, 끝에 닿은 쪽은 숨긴다
  document.querySelectorAll<HTMLElement>('.rowwrap').forEach((w) => {
    const row = w.querySelector<HTMLElement>('.row')!;
    const prev = w.querySelector<HTMLButtonElement>('.prev')!;
    const next = w.querySelector<HTMLButtonElement>('.next')!;
    const sync = () => {
      prev.hidden = row.scrollLeft <= 8;
      next.hidden = row.scrollLeft + row.clientWidth >= row.scrollWidth - 8;
    };
    const step = (d: number) => row.scrollBy({ left: d * row.clientWidth * 0.8, behavior: 'smooth' });
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    row.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .rowwrap {
    position: relative;
  }
  .nav {
    position: absolute;
    top: 40%;
    z-index: 2;
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border: 1px solid var(--line-frame);
    border-radius: 50%;
    background: var(--card);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
  .nav[hidden] {
    display: none;
  }
  .nav:hover {
    border-color: var(--ink);
  }
  .prev {
    left: -6px;
  }
  .next {
    right: -6px;
  }
  .mobile .nav {
    background: rgba(17, 17, 17, 0.85);
    border-color: rgba(244, 243, 238, 0.3);
    color: var(--on-dark);
  }
  .shelf {
    margin-top: 30px;
  }
  .shelf:first-child {
    margin-top: 0;
  }
  .sh {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding-top: 10px;
    margin-bottom: 12px;
    border-top: 3px solid var(--ink);
  }
  .sh-label {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
  }
  .sh-sub {
    font-size: 14px;
    color: var(--meta-soft);
  }
  .sh-more {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--meta);
    text-decoration: none;
  }

  /* 꼭지 바로가기 — 칩 한 줄 */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--line-frame);
    background: var(--card);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .chip b {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--meta);
  }

  /* 책장 한 칸 — 아래 선반 판 위에 썸네일을 세운다 */
  .row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 4px 4px 12px;
    border-bottom: 6px solid #cfc7b1;
    box-shadow: 0 6px 8px -6px rgba(0, 0, 0, 0.35);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  .tile {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 7px;
    scroll-snap-align: start;
    color: var(--ink);
    text-decoration: none;
  }
  .tall {
    width: 116px;
  }
  .wide {
    width: 236px;
  }
  .tall img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s;
  }
  /* 책 표지는 밝은 종이색 바탕 위에(어두운 표지가 묻히지 않게, 11/20 대표) */
  .book img {
    box-sizing: border-box;
    padding: 7px;
    background: #eceae4;
    /* 표지 비율이 책마다 달라(국문 1:1.48, 킨들 1:1.6) 자르지 않고 담는다 */
    object-fit: contain;
  }
  .tile:hover img {
    transform: translateY(-3px);
  }
  .vthumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }
  .vthumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.15s;
  }
  /* 재생 표시 — 유튜브 로고를 쓰지 않고 삼각형만 그린다 */
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.62);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 11px;
    border-style: solid;
    border-width: 9px 0 9px 14px;
    border-color: transparent transparent transparent #fff;
  }
  .dur {
    position: absolute;
    right: 5px;
    bottom: 5px;
    padding: 1px 5px;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .cap {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta-soft);
    line-height: 1.4;
  }
  .cap b {
    color: var(--ink);
    font-weight: 600;
  }
  .cc {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--meta);
  }
  .vcap {
    font-family: var(--font-serif);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 모바일 지면(어두운 바탕) ── */
  .mobile {
    margin-top: 26px;
  }
  .mobile .sh {
    border-top: 2px solid var(--gold);
  }
  .mobile .sh-label {
    color: var(--gold);
    font-size: 14px;
  }
  .mobile .sh-sub {
    font-size: 12.5px;
    color: var(--on-dark-mute);
  }
  .mobile .sh-more {
    font-size: 11.5px;
    color: var(--on-dark-mute);
  }
  .mobile .chip {
    background: transparent;
    border-color: rgba(244, 243, 238, 0.2);
    color: var(--on-dark);
    font-size: 12.5px;
    padding: 4px 9px;
  }
  .mobile .chip b {
    color: var(--on-dark-mute);
  }
  .mobile .row {
    gap: 12px;
    border-bottom-color: rgba(244, 243, 238, 0.22);
    box-shadow: none;
  }
  .mobile .tall {
    width: 104px;
  }
  .mobile .wide {
    width: 200px;
  }
  .mobile .tile,
  .mobile .cap b,
  .mobile .vcap {
    color: var(--on-dark);
  }
  .mobile .cap {
    color: var(--on-dark-mute);
    font-size: 11px;
  }
</style>
