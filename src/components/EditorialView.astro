---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { REPORTERS, sectionColor } from '../lib/sections';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/articles';

interface Props {
  lang?: Lang;
}

const { lang = 'ko' } = Astro.props;
const en = lang === 'en';
const ui = t(lang);

const reporterList = Object.values(REPORTERS);

// 편집국은 고정 콘텐츠라 원고가 아니라 페이지가 갖는다. 영문은 번역이 아니라 다시 쓴 것이다.
const STEPS = {
  ko: [
    { no: '01', title: '수집', desc: '논문·특허·공시를 매일 훑습니다. 검색 조건은 기사에 공개합니다.' },
    { no: '02', title: '이상 탐지', desc: '전주·전월 대비 분포가 바뀐 지점만 골라냅니다.' },
    { no: '03', title: '분석', desc: '청구항 분류, 단위 환산, 표와 그래프를 만듭니다.' },
    { no: '04', title: '검증', desc: '모든 수치를 원출처로 되돌려 확인합니다. 확인 안 되면 싣지 않습니다.' },
    { no: '05', title: '검수 · 발행', desc: 'AI 편집장 DEEPLE이 정리한 기사를 박원상 대표가 기획 방향에 맞춰 검수해야 발행됩니다. 단정이 지나친 문장은 여기서 잡습니다.', final: true },
  ],
  en: [
    { no: '01', title: 'Collect', desc: 'Papers, patents and filings, swept daily. The search terms are published in the article.' },
    { no: '02', title: 'Detect', desc: 'Only the points where the distribution shifted against last week or last month.' },
    { no: '03', title: 'Analyse', desc: 'Claim classification, unit conversion, tables and charts.' },
    { no: '04', title: 'Verify', desc: 'Every figure is traced back to its original source. What cannot be confirmed does not run.' },
    { no: '05', title: 'Review · Publish', desc: 'What AI editor-in-chief DEEPLE has edited is published only after Wonsang Park reviews it against the editorial direction. Sentences that claim too much are caught here.', final: true },
  ],
};

const DONTS = {
  ko: [
    { title: '익명 취재원을 인용하지 않습니다', desc: '"업계 관계자에 따르면"으로 시작하는 문장은 쓰지 않습니다. 독자가 확인할 수 없는 근거이기 때문입니다.' },
    { title: '전망을 단정하지 않습니다', desc: '추정에는 추정이라고 적고, 계산 근거와 가정을 함께 공개합니다.' },
    { title: '기사형 광고를 싣지 않습니다', desc: '광고는 광고 자리에만 둡니다. 기사 형식을 빌린 홍보물은 게재하지 않습니다.' },
    { title: '쏠림이 안 보이면 쓰지 않습니다', desc: '분량을 채우기 위한 기사는 만들지 않습니다. 발행 편수보다 근거의 밀도를 우선합니다.' },
  ],
  en: [
    { title: 'We do not quote anonymous sources', desc: 'No sentence here begins with "according to an industry official". It is a basis the reader cannot check.' },
    { title: 'We do not state forecasts as fact', desc: 'An estimate is labelled an estimate, and the calculation and its assumptions are published with it.' },
    { title: 'We do not run advertorials', desc: 'Advertising stays in the advertising slot. Promotional material borrowing the form of an article does not run.' },
    { title: 'If there is no skew, we do not write', desc: 'We do not make articles to fill space. Density of evidence comes before number of articles.' },
  ],
};

const steps = en ? STEPS.en : STEPS.ko;
const donts = en ? DONTS.en : DONTS.ko;
---


<Base title={`${ui.edTitle} | DISPLAY NOW`} lang={lang}>
  <div class="frame">
    <Header activeSection="editorial" lang={lang} />

    <section class="hero">
      <div class="hero-text">
        <div class="eyebrow-accent">{ui.edTitle}</div>
        <h1 set:html={ui.edHero} />
        <p>{ui.edHeroSub}</p>
      </div>
      <video src="/uploads/editorial-hero-ai-newsroom.mp4" autoplay loop muted playsinline></video>
    </section>

    <div class="content-pad">
      <div class="row-head">
        <span class="eyebrow">{ui.edNewsroom}</span>
        <span class="muted">{ui.edNewsroomSub}</span>
      </div>

      <div class="reporter-grid">
        {
          reporterList.map((r) => {
            const color = sectionColor(r.section);
            return (
              <article class="reporter-card">
                <div class="rcard-head" style={`background:${color};`}>
                  <span class="rcard-name">{r.code}</span>
                  {!en && <span class="rcard-nameko">{r.nameKo}</span>}
                </div>
                <div class="rcard-body">
                  <p>{en ? r.roleEn : r.role}</p>
                  <div class="rcard-facts">
                    <div><span>{ui.edReads}</span><span>{en ? r.readsEn : r.reads}</span></div>
                    <div><span>{ui.edDoes}</span><span>{en ? r.doesEn : r.does}</span></div>
                    <div><span>{ui.edLimit}</span><span class="limit">{en ? r.limitEn : r.limit}</span></div>
                  </div>
                  <a
                    href={en ? `/en#sec-${r.section}` : `/section/${r.section}`}
                    style={`color:${color};`}
                  >{ui.edSeeArticles(r.code)}</a>
                </div>
              </article>
            );
          })
        }
      </div>

      <div class="editor-connector">
        <span class="connector-line"></span>
        <span class="connector-label">{ui.edConnector}</span>
        <span class="connector-line"></span>
      </div>

      <article class="deeple-capstone">
        <div class="dc-head">
          <span class="dc-name">DEEPLE</span>
          <span class="dc-role">{ui.edDeepleRole}</span>
        </div>
        <p class="dc-desc">{ui.edDeepleDesc}</p>
        <div class="dc-facts">
          <div><span>{ui.edReads}</span><span>{ui.edDeepleReads}</span></div>
          <div><span>{ui.edDoes}</span><span>{ui.edDeepleDoes}</span></div>
          <div><span>{ui.edLimit}</span><span>{ui.edDeepleLimit}</span></div>
        </div>
      </article>

      <div class="row-head" style="margin-top:32px;">
        <span class="eyebrow">{ui.edPipeline}</span>
        <span class="muted">{ui.edPipelineSub}</span>
      </div>

      <div class="steps-row" data-scroll-x="1">
        {
          steps.map((s) => (
            <div class={`step ${s.final ? 'final' : ''}`}>
              <div class="step-no">{s.no}</div>
              <div class="step-title">{s.title}</div>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="lower-split">
        <div class="donts">
          <div class="eyebrow" style="margin-bottom:12px;">{ui.edDonts}</div>
          <div class="donts-box">
            {
              donts.map((d) => (
                <div class="dont-row">
                  <span class="dash">·</span>
                  <span>
                    <b>{d.title}</b>
                    <span class="dont-desc">{d.desc}</span>
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <aside class="editor-aside">
          <div class="eyebrow" style="margin-bottom:12px;">{ui.edOversight}</div>

          <div class="editor-card">
            <div class="editor-row">
              <span class="editor-avatar"></span>
              <span>
                <b>{ui.edEditorName}</b>
                <span class="editor-role" set:html={ui.edEditorRole} />
              </span>
            </div>
            <p>{ui.edEditorDesc}</p>
            <div class="editor-contact">
              <div>info@nextio.ai.kr</div>
              <div>010-3938-6918</div>
            </div>
            <a
              class="editor-board"
              href={en ? 'mailto:info@nextio.ai.kr?subject=DISPLAY%20NOW' : '/board'}
            >{ui.edBoard}</a>
          </div>

        </aside>
      </div>
    </div>

    <Footer lang={lang} />
  </div>
</Base>

<script>
  const video = document.querySelector('video');
  if (video) {
    video.muted = true;
    video.play().catch(() => {});
  }
</script>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(28px, 6vw, 44px) clamp(16px, 4vw, 32px) 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: center;
    justify-content: space-between;
  }
  .hero-text {
    flex: 1 1 340px;
    min-width: 0;
  }
  .eyebrow-accent {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.12em;
    color: oklch(0.72 0.1 315);
  }
  .hero h1 {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 42px);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.035em;
    word-break: keep-all;
    max-width: 26ch;
  }
  .hero p {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.8;
    color: #b6b6ac;
    word-break: keep-all;
    max-width: 62ch;
  }
  .hero video {
    width: min(500px, 100%);
    height: auto;
    object-fit: contain;
    display: block;
  }
  .content-pad {
    padding: 28px 24px 32px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 12px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted {
    font-size: 14px;
    color: var(--meta);
  }
  .reporter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 12px;
  }
  .reporter-card {
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .rcard-head {
    color: var(--card);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .rcard-name {
    font-size: 17px;
    font-weight: 500;
  }
  .rcard-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rcard-body > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    color: #2a2a24;
    word-break: keep-all;
  }
  .rcard-facts {
    border-top: 1px solid var(--line-soft);
  }
  .rcard-facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid #e8e8e2;
    font-size: 14px;
    line-height: 1.6;
  }
  .rcard-facts > div:last-child {
    border-bottom: none;
  }
  .rcard-facts > div > span:first-child {
    color: var(--meta-soft);
    flex: 0 0 88px;
  }
  .rcard-facts .limit {
    color: #55554d;
    word-break: keep-all;
  }
  .rcard-body > a {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .editor-connector {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 480px;
    margin: 18px auto;
  }
  .connector-line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .connector-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--meta-soft);
    white-space: nowrap;
  }
  .deeple-capstone {
    --deeple: oklch(0.45 0.11 200);
    background: var(--deeple);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 22px 28px;
    width: 100%;
  }
  .dc-head {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-right: 24px;
    border-right: 1px solid rgba(244, 243, 238, 0.18);
  }
  .dc-name {
    font-family: var(--font-mono);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .dc-role {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
    white-space: nowrap;
  }
  .dc-desc {
    flex: 1 1 280px;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: #cfcec6;
    word-break: keep-all;
  }
  .dc-facts {
    flex: 1 1 420px;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .dc-facts > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1 1 140px;
    min-width: 140px;
  }
  .dc-facts > div > span:first-child {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--on-dark-mute);
  }
  .dc-facts > div > span:last-child {
    font-size: 13px;
    line-height: 1.55;
    color: #e4e2da;
    word-break: keep-all;
  }
  @media (max-width: 780px) {
    .deeple-capstone {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      max-width: 480px;
      margin: 0 auto;
      background: var(--card);
      color: inherit;
      border: 1.5px solid var(--deeple);
    }
    .dc-head {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      border-right: none;
      background: var(--deeple);
      color: var(--on-dark);
      padding: 10px 20px;
    }
    .dc-desc {
      flex: none;
      padding: 20px 20px 0;
      color: #2a2a24;
    }
    .dc-facts {
      flex: none;
      flex-direction: column;
      gap: 0;
      padding: 14px 20px 20px;
    }
    .dc-facts > div {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
      min-width: 0;
      padding: 9px 0;
      border-bottom: 1px solid #e8e8e2;
    }
    .dc-facts > div:last-child {
      border-bottom: none;
    }
    .dc-facts > div > span:first-child {
      color: var(--meta-soft);
      flex: 0 0 60px;
    }
    .dc-facts > div > span:last-child {
      color: #55554d;
    }
  }
  .steps-row {
    display: flex;
    overflow-x: auto;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--card);
  }
  .step {
    flex: 1 0 168px;
    min-width: 168px;
    padding: 18px;
    border-right: 1px solid var(--line-soft);
  }
  .step.final {
    background: #f4f4ef;
  }
  .step-no {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .step-title {
    font-size: 16px;
    font-weight: 600;
    margin-top: 8px;
    letter-spacing: -0.02em;
  }
  .step p {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: #55554d;
    word-break: keep-all;
  }
  .lower-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    align-items: flex-start;
  }
  .donts {
    flex: 1 1 420px;
    min-width: 0;
  }
  .donts-box {
    border: 1px solid var(--line);
    background: var(--card);
  }
  .dont-row {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid #e8e8e2;
  }
  .dont-row:last-child {
    border-bottom: none;
  }
  .dash {
    font-family: var(--font-mono);
    color: #b4b4aa;
    font-size: 16px;
  }
  .dont-row b {
    display: block;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dont-desc {
    display: block;
    font-size: 14px;
    line-height: 1.7;
    color: #55554d;
    margin-top: 4px;
    word-break: keep-all;
  }
  .editor-aside {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 440px;
    position: sticky;
    top: 68px;
  }
  .editor-card {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
    padding: 20px;
  }
  .editor-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .editor-avatar {
    width: 44px;
    height: 44px;
    background: #d8d2c2;
    display: inline-block;
    flex-shrink: 0;
  }
  .editor-row b {
    display: block;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .editor-role {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    margin-top: 2px;
    line-height: 1.6;
    word-break: keep-all;
  }
  .editor-card p {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.75;
    color: #45453d;
    word-break: keep-all;
  }
  .editor-contact {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #e2dccb;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta-soft);
    line-height: 1.9;
  }
  .editor-board {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-bottom: 1px solid var(--line-frame);
  }
</style>
