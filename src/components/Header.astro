---
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { t } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';
import type { Lang } from '../lib/articles';

interface Props {
  activeSection?: string;
  minimal?: boolean;
  showNav?: boolean;
  lang?: Lang;
  /**
   * 반대 언어판 경로. **짝이 있을 때만 넘긴다.** 없으면 전환 스위치를 세우지 않는다.
   * 헤더에 전역으로 달면 영문판이 없는 페이지에서 404가 된다.
   */
  altHref?: string;
}

const {
  activeSection,
  minimal = false,
  showNav = true,
  lang = 'ko',
  altHref,
} = Astro.props;
const ui = t(lang);
const en = lang === 'en';
const home = en ? '/en' : '/';

// 영문에는 꼭지 낱장(`/en/section/*`)이 없다. 아카이브가 그 자리를 겸하므로
// 꼭지 칩은 아카이브의 꼭지 필터를 켠 채로 연다. 없는 페이지로 보내지 않는 것이 이 분기의 이유다.
const sectionHref = (key: string) => (en ? `/en/archive?section=${key}` : `/section/${key}`);
const issuesHref = en ? '/en/issue' : '/issue';
const subscribeHref = en ? '/en#subscribe' : '/subscribe';
---

<header class="site-header">
  <div style="display:flex; align-items:center; gap:9px; min-width:0; flex:0 0 auto;">
    {
      minimal ? (
        <span class="wordmark">
          <img class="brand-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
          <span>DISPLAY NOW</span>
        </span>
      ) : (
        <a href={home} class="wordmark" aria-label={ui.home}>
          <img class="brand-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
          <span>DISPLAY NOW</span>
        </a>
      )
    }
  </div>
  {
    showNav && (
      <nav data-nav="1">
        {
          SECTION_ORDER.map((key) => {
            const s = SECTIONS[key];
            const on = activeSection === key;
            return (
              <a
                class="chip"
                aria-current={on ? 'true' : undefined}
                href={sectionHref(key)}
                style={`background:${sectionColor(key)};`}
              >
                {s.labelEn}
              </a>
            );
          })
        }
        <a
          class="archive-link"
          aria-current={activeSection === 'issue-list' ? 'true' : undefined}
          href={issuesHref}
          style={activeSection === 'issue-list' ? 'color:var(--ink); background:#c4c4bc;' : ''}
        >{ui.issues}</a>
        <a
          class="archive-link"
          aria-current={activeSection === 'archive' ? 'true' : undefined}
          href={en ? '/en/archive' : '/archive'}
          style={activeSection === 'archive' ? 'color:var(--ink); background:#c4c4bc;' : ''}
        >{ui.archive}</a>
      </nav>
    )
  }
  {altHref && <LangSwitch lang={lang} altHref={altHref} />}
  <a class="subscribe-btn" href={subscribeHref}>{ui.subscribe}</a>
</header>
