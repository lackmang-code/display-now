---
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';

interface Props {
  activeSection?: string;
  minimal?: boolean;
  showNav?: boolean;
}

const { activeSection, minimal = false, showNav = true } = Astro.props;
---

<header class="site-header">
  <div style="display:flex; align-items:center; gap:9px; min-width:0; flex:0 0 auto;">
    {
      minimal ? (
        <span class="wordmark">
          <img class="brand-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
          <span>DISPLAY NOW</span>
        </span>
      ) : (
        <a href="/" class="wordmark" aria-label="DISPLAY NOW 홈">
          <img class="brand-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
          <span>DISPLAY NOW</span>
        </a>
      )
    }
  </div>
  {
    showNav && (
      <nav data-nav="1">
        {
          SECTION_ORDER.map((key) => {
            const s = SECTIONS[key];
            const on = activeSection === key;
            return (
              <a
                class="chip"
                aria-current={on ? 'true' : undefined}
                href={`/section/${key}`}
                style={`background:${sectionColor(key)};`}
              >
                {s.labelEn}
              </a>
            );
          })
        }
        <a
          class="archive-link"
          aria-current={activeSection === 'issue-list' ? 'true' : undefined}
          href="/issue"
          style={activeSection === 'issue-list' ? 'color:var(--ink); background:#c4c4bc;' : ''}
        >주간호</a>
        <a
          class="archive-link"
          aria-current={activeSection === 'archive' ? 'true' : undefined}
          href="/archive"
          style={activeSection === 'archive' ? 'color:var(--ink); background:#c4c4bc;' : ''}
        >아카이브</a>
      </nav>
    )
  }
  <a class="subscribe-btn" href="/subscribe">구독하기</a>
</header>
