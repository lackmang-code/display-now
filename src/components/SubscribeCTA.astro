---
// 홈의 주 전환 지점. 이 매체가 독자에게 요청하는 것은 구독 하나이므로
// 기사 목록이 끝나는 자리에서 가장 큰 블록으로 받는다. 게시판은 이 아래에 둔다.
---

<section class="cta" id="subscribe-cta">
  <div class="cta-inner">
    <div class="cta-left">
      <p class="cta-eyebrow">SUBSCRIBE</p>
      <h2>매주 화요일, 그 주의 디스플레이를 한 권으로 받으십시오</h2>
      <p class="cta-sub">
        AI 기자 네 명이 그 주에 쓴 기술노트와 논문, 특허, 이슈를 묶어 보내드립니다.
        근거 목록을 모든 기사에 싣습니다. 언제든 해지하실 수 있습니다.
      </p>
    </div>

    <div class="cta-right">
      <form id="cta-form" class="cta-form">
        <input
          id="cta-email"
          type="email"
          name="email"
          placeholder="이메일 주소"
          autocomplete="email"
          required
        />
        <button type="submit" id="cta-btn">구독하기</button>
      </form>
      <p class="cta-status" id="cta-status" hidden></p>
      <a class="cta-more" href="/subscribe">이름과 소속, 관심 꼭지까지 남기고 신청하기</a>
    </div>
  </div>

  <p class="cta-board">
    제보와 기사 정정 요청, 광고와 제휴 문의는 <a href="/board">문의 게시판</a>으로 받습니다.
  </p>
</section>

<style>
  .cta {
    background: var(--ink);
    color: var(--on-dark);
    border-top: 1px solid var(--line-dark);
    padding: clamp(30px, 5vw, 46px) clamp(14px, 4vw, 32px);
  }
  .cta-inner {
    display: flex;
    gap: clamp(20px, 4vw, 48px);
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .cta-left {
    flex: 1 1 340px;
    min-width: 0;
  }
  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    color: var(--gold);
    margin: 0 0 8px;
  }
  .cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(21px, 3.4vw, 30px);
    line-height: 1.35;
    letter-spacing: -0.035em;
    margin: 0 0 10px;
    word-break: keep-all;
  }
  .cta-sub {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--on-dark-mute);
    margin: 0;
    word-break: keep-all;
    max-width: 46ch;
  }

  .cta-right {
    flex: 0 1 380px;
    min-width: 260px;
  }
  .cta-form {
    display: flex;
    gap: 8px;
  }
  .cta-form[hidden] {
    display: none;
  }
  .cta-form input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink);
    background: var(--on-dark);
    border: none;
    padding: 13px 14px;
  }
  .cta-form input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .cta-form button {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    background: var(--gold);
    border: none;
    padding: 13px 22px;
    cursor: pointer;
    flex: 0 0 auto;
  }
  .cta-form button:disabled {
    opacity: 0.55;
    cursor: default;
  }
  .cta-status {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--gold);
  }
  .cta-more {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    color: var(--on-dark-mute);
    border-bottom: 1px solid var(--line-dark);
  }
  .cta-more:hover {
    color: var(--on-dark);
  }

  .cta-board {
    margin: clamp(20px, 3vw, 28px) 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 13.5px;
    color: var(--on-dark-mute);
    word-break: keep-all;
  }
  .cta-board a {
    color: var(--on-dark);
    border-bottom: 1px solid var(--on-dark-mute);
  }

  @media (max-width: 700px) {
    .cta-right {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  const form = document.getElementById('cta-form') as HTMLFormElement | null;
  const btn = document.getElementById('cta-btn') as HTMLButtonElement | null;
  const input = document.getElementById('cta-email') as HTMLInputElement | null;
  const status = document.getElementById('cta-status');

  function say(text: string) {
    if (!status) return;
    status.hidden = false;
    status.textContent = text;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (input?.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      say('이메일 주소를 확인해 주십시오.');
      return;
    }
    if (btn) {
      btn.disabled = true;
      btn.textContent = '처리 중';
    }
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, source: 'home-cta' }),
      });
      const data = await res.json();
      if (data.ok) {
        form.hidden = true;
        say(data.already ? '이미 구독 중이십니다. 감사합니다.' : '구독 신청이 접수되었습니다. 다음 호부터 보내드립니다.');
        return;
      }
      say('이메일 주소를 확인해 주십시오.');
    } catch {
      say('오류가 발생했습니다. 잠시 후 다시 시도해 주십시오.');
    }
    if (btn) {
      btn.disabled = false;
      btn.textContent = '구독하기';
    }
  });
</script>
