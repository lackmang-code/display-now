---
/**
 * 홈 PC 지면 — **한글·영문이 함께 쓰는 한 벌.**
 *
 * 종전에는 한글 홈이 `pages/index.astro`, 영문 홈이 `pages/en/index.astro`에
 * 각각 다른 구조로 있었다. 영문 34편을 배포하고 나서 두 홈을 나란히 놓으니
 * 이번 호 배너·꼭지 카드·편집국 추천·광고가 영문 쪽에만 통째로 없었다.
 * **지면을 두 벌로 두면 한글을 고칠 때마다 영문이 조용히 뒤처진다.**
 *
 * 문구는 i18n(`t(lang)`), 데이터는 각 자료 파일의 `~En` 필드가 담당한다.
 * 여기서 언어에 따라 갈리는 것은 **링크 경로**뿐이다.
 */
import Header from './Header.astro';
import type { Article, Lang } from '../lib/articles';
import type { IssueMeta } from '../lib/issues';
import { t } from '../lib/i18n';
import BrandStrip from './BrandStrip.astro';
import Shelf from './Shelf.astro';
import Footer from './Footer.astro';

interface Props {
  lang?: Lang;
  /** 쓰지 않는다(11/26 영문 편집국 추천 제거) — 한글 홈이 아직 넘겨서 남겨 둔다 */
  editorPicks?: Article[];
  latestIssue?: IssueMeta;
  /** 이번 호 기사. 한글 홈 맨 위 매거진 칸에 카드로 싣는다 */
  issueArticles?: Article[];
}

const {
  lang = 'ko',
  latestIssue,
  issueArticles = [],
} = Astro.props;

const ui = t(lang);
const en = lang === 'en';

---

<div class="frame">
  <Header showNav={false} lang={lang} altHref={en ? '/' : '/en'} />

  <section class="hero">
    <h1>{ui.homeTagline}</h1>
  </section>

  {/* 세 축(매거진·TV·책) 띠가 이번 호 배너를 대신한다. 영문 홈도 같은 띠를 쓴다(11/16 대표) — 영문 호·영어판(없으면 자막) 영상 */}
  <BrandStrip latestIssue={latestIssue} issueArticles={issueArticles} lang={lang} />

  <div class="content-pad">
    {/* 꼭지 바로가기는 MAGAZINE 책장 머리의 칩이 맡는다(한글 10/31, 영문 11/16 대표). 종전 꼭지 카드는 뺐다 */}
    {/* 매거진·TV 책장은 콘텐츠가 많아 한 줄을 다 쓰고, 맨 아래 한 줄에 책장 | 광고 | 유튜브 채널 구독을 나란히 둔다
        (11/26 대표 — 오른쪽 칸이 위에만 있고 아래가 비어 중심이 안 맞았다. 영문 홈도 동일하게) */}
    <div class="full-shelves">
      <Shelf which="magazine" lang={lang} />
      <Shelf which="tv" lang={lang} />
    </div>

    {/* 편집국 추천 줄은 뺐다 — 영문 홈도 한글 홈과 같은 형식(11/26 대표) */}

  </div>

  {/*
    영문 홈은 구독 칸을 여기로 넣는다(영문 신청 페이지가 없어 맨 위 Subscribe가 이 칸으로 온다).
    **같은 `.frame` 안에 들어와야 한다** — 밖에 두면 테두리가 한 번 끊겼다 다시 시작해 이음매가 가로줄로 보인다.
  */}
  <slot />

  {/* 맨 아래 한 줄 — 책장 | 푸터(제호·링크·법정 기재사항). 광고는 뺐다(11/26 대표).
      유튜브 채널 구독은 TV 책장 머리 오른쪽으로 옮겼다(Shelf.astro). */}
  <div class="content-pad bottom-pad">
    <div class="main-split bottom-row">
      <div class="feed">
        {/* 영문 책장은 영문판이 있는 책만(11/20 대표) */}
        <Shelf which="books" lang={lang} />
      </div>
      <div class="foot-col">
        <Footer lang={lang} />
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
    /* 글자를 줄였으니 띠도 같이 줄인다. 안 그러면 빈 검정 띠만 두껍게 남는다 */
    padding: clamp(12px, 2.4vw, 16px) clamp(14px, 4vw, 32px);
  }
  /* 매체를 한 줄로 소개하는 문구다. 제목이 아니다.
     32px/700 흰색이던 때는 제호(24px)보다 커서 이쪽이 매체 이름처럼 읽혔다.
     제호보다 확실히 아래에 두고, 굵기와 색도 한 단계 내려 태그라인으로 만든다. */
  .hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(15px, 2.6vw, 19px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.02em;
    /* 완전 흰색. 크기를 32→19px로 줄여 제호에 자리를 내준 대신
       색은 가장 밝게 둔다(회색으로 눌렀더니 너무 물러났다). */
    color: #fff;
    word-break: keep-all;
  }
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 24px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 10px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted-link {
    font-size: 14px;
    color: var(--meta);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .main-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
    align-items: flex-start;
  }
  .full-shelves {
    margin-top: 22px;
  }
  /* 맨 아래 줄 — 책장 사이 간격(30px)과 같게 띄운다. 책장은 그 줄의 첫 자식이라 자기 위 여백이 0이다 */
  .bottom-row {
    margin-top: 30px;
  }
  /* 맨 아래 줄 — 책장 | 푸터. 책장 사이 간격(30px)과 같게 띄운다 */
  .bottom-pad {
    padding-top: 0;
  }
  .bottom-row {
    margin-top: 30px;
    align-items: stretch;
  }
  .bottom-row .feed {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
  }
  /* 책장 칸을 옆 푸터 높이까지 늘린다 — 책장 바탕이 중간에서 끊기지 않게 */
  .bottom-row .feed :global(.shelf) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .bottom-row .feed :global(.rowwrap) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .bottom-row .feed :global(.row) {
    flex: 1;
  }
  .foot-col {
    flex: 0 1 660px;
    max-width: 660px;
    display: flex;
  }
  .foot-col :global(.site-footer) {
    flex: 1;
    padding: 22px 24px 18px;
    font-size: 13.5px;
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  /* 푸터를 책장 높이에 맞춘다(11/26 대표 「오른쪽 여백이 많다」) — 제호와 링크 세 묶음을 한 줄에 나란히 */
  .foot-col :global(.ft-top) {
    flex-wrap: nowrap;
    gap: 28px;
  }
  .foot-col :global(.ft-brand) {
    flex: 1 1 200px;
  }
  .foot-col :global(.ft-nav) {
    flex: 0 0 auto;
    gap: 0 24px;
  }
  /* 좁은 폭(영문 홈은 폰까지 이 지면)에서는 제호가 위, 링크 묶음이 아래로 */
  @media (max-width: 700px) {
    .foot-col :global(.ft-top) {
      flex-wrap: wrap;
    }
    .foot-col :global(.site-footer) {
      min-width: 0;
    }
    .foot-col {
      min-width: 0;
    }
    .foot-col :global(.ft-nav) {
      flex: 1 1 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 12px;
    }
    .foot-col :global(.nw) {
      white-space: normal;
    }
  }
  .foot-col :global(.ft-legal) {
    margin-top: 14px;
    padding-top: 12px;
    font-size: 12px;
  }
  /* 폭이 모자라 아랫줄로 내려가면 푸터가 폭을 다 쓴다 */
  @media (max-width: 1160px) {
    .foot-col {
      flex-basis: 100%;
      max-width: none;
    }
  }
  @media (max-width: 600px) {
    .picks-row .pick-row {
      border-right: none;
      border-bottom: 1px solid #e2dccb;
    }
  }
  .feed {
    flex: 1 1 520px;
    min-width: 0;
  }
  .sidebar {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 316px;
  }
  .picks {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
  }
  /* 영문 편집국 추천 — TV 아래 한 줄. 넓으면 다섯 칸 가로, 좁으면 접힌다 */
  .picks-row {
    margin-top: 30px;
  }
  .picks-row .picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .picks-row .pick-row {
    border-bottom: none;
    border-right: 1px solid #e2dccb;
  }
  .picks-row .pick-row:last-child {
    border-right: none;
  }
  .pick-row {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid #e2dccb;
  }
  .pick-row:last-child {
    border-bottom: none;
  }
  .no {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
  }
  .pick-title {
    display: block;
    font-size: clamp(14px, 3.6vw, 15px);
    line-height: 1.5;
    word-break: keep-all;
  }
  .pick-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    margin-top: 5px;
  }
  .newsletter-dark {
    margin-top: 12px;
    background: var(--ink);
    color: #e4e2da;
    padding: 18px;
  }
  .eyebrow-dark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: #9a9a90;
  }
  .nl-title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 17px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 8px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .newsletter-dark form {
    display: flex;
    margin-top: 12px;
  }
  .newsletter-dark form[hidden] {
    display: none;
  }
  .newsletter-dark input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line-dark);
    border-right: none;
    background: #1c1c17;
    color: var(--on-dark);
    outline: none;
  }
  .newsletter-dark button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--on-dark);
    border: 1px solid var(--on-dark);
    padding: 10px 16px;
    cursor: pointer;
  }
  .ad-box {
    position: relative;
    display: block;
    margin-top: 12px;
    overflow: hidden;
    background: #0b0e19;
    border: 1px solid var(--line-dark);
  }
  .ad-box video {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .ad-label {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #e4e2da;
    background: rgba(0, 0, 0, 0.55);
    padding: 2px 7px;
  }
  .ad-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.8));
    color: var(--on-dark);
  }
  .ad-logo {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    height: 18px;
    width: auto;
  }
  .ad-tagline {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .ad-contact {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-dark-mute);
    margin-top: 5px;
  }
  .yt-box {
    text-decoration: none;
  }
  .yt-btn {
    align-self: flex-start;
    margin-top: 14px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: #e62117;
    padding: 10px 16px;
  }
  .yt-box:hover .yt-btn {
    background: #ff3328;
  }
  .yt-box .nl-more {
    align-self: flex-start;
  }
  .nl-status {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .nl-more {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--on-dark-mute);
    border-bottom: 1px solid var(--line-dark);
  }
  .nl-more:hover {
    color: var(--on-dark);
  }
</style>
