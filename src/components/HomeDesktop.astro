---
/**
 * 홈 PC 지면 — **한글·영문이 함께 쓰는 한 벌.**
 *
 * 종전에는 한글 홈이 `pages/index.astro`, 영문 홈이 `pages/en/index.astro`에
 * 각각 다른 구조로 있었다. 영문 34편을 배포하고 나서 두 홈을 나란히 놓으니
 * 이번 호 배너·꼭지 카드·편집국 추천·광고가 영문 쪽에만 통째로 없었다.
 * **지면을 두 벌로 두면 한글을 고칠 때마다 영문이 조용히 뒤처진다.**
 *
 * 문구는 i18n(`t(lang)`), 데이터는 각 자료 파일의 `~En` 필드가 담당한다.
 * 여기서 언어에 따라 갈리는 것은 **링크 경로**뿐이다.
 */
import Header from './Header.astro';
import { SECTIONS, sectionColor } from '../lib/sections';
import { articleHref, type Article, type Lang } from '../lib/articles';
import type { IssueMeta } from '../lib/issues';
import { t } from '../lib/i18n';
import BrandStrip from './BrandStrip.astro';
import Shelf from './Shelf.astro';

interface Props {
  lang?: Lang;
  editorPicks: Article[];
  latestIssue?: IssueMeta;
  /** 이번 호 기사. 한글 홈 맨 위 매거진 칸에 카드로 싣는다 */
  issueArticles?: Article[];
}

const {
  lang = 'ko',
  editorPicks,
  latestIssue,
  issueArticles = [],
} = Astro.props;

const ui = t(lang);
const en = lang === 'en';

const subscribeMoreHref = en ? '/en#subscribe' : '/subscribe';
---

<div class="frame">
  <Header showNav={false} lang={lang} altHref={en ? '/' : '/en'} />

  <section class="hero">
    <h1>{ui.homeTagline}</h1>
  </section>

  {/* 세 축(매거진·TV·책) 띠가 이번 호 배너를 대신한다. 영문 홈도 같은 띠를 쓴다(11/16 대표) — 영문 호·영어판(없으면 자막) 영상 */}
  <BrandStrip latestIssue={latestIssue} issueArticles={issueArticles} lang={lang} />

  <div class="content-pad">
    {/* 꼭지 바로가기는 MAGAZINE 책장 머리의 칩이 맡는다(한글 10/31, 영문 11/16 대표). 종전 꼭지 카드는 뺐다 */}
    <div class="main-split">
      <div class="feed">
        {/* 최신 글 목록을 두지 않는다 — 이번 호 기사는 맨 위 매거진 칸에 있다(한글 10/31, 영문 11/16 대표).
            그 자리에 책장을 둬서 랜딩이 한눈에 들어오게 한다. 책은 한국어뿐이라 영문에서 뺀다 */}
        <Shelf which="magazine" lang={lang} />
        <Shelf which="tv" lang={lang} />
        {!en && <Shelf which="books" />}
      </div>

      <aside class="sidebar">
        {/* 광고를 사이드바 맨 위로 올린다. 맨 아래에 두면 스크롤을 끝까지 내려야 보인다 */}
        <a class="ad-box" href="https://www.nextio.ai.kr" target="_blank" rel="noopener">
          <span class="ad-label">{ui.homeAdLabel}</span>
          <img class="ad-logo" src="/uploads/nextio-lockup-reverse.svg" alt="Next I/O" />
          {/*
            autoplay를 떼고 preload="none"으로 둔다. 이 영상은 2.47MB인데
            autoplay가 붙어 있으면 화면에 안 보여도 브라우저가 내려받는다.
            지면을 나눈 뒤 이 광고는 PC 지면에만 있는데, 폰에서 재니
            보이지도 않는 영상 2,528KB를 받고 있었다.
          */}
          <video
            src="/uploads/nextio-ad-mobile-robot.mp4"
            loop
            muted
            playsinline
            preload="none"
            data-lazy-video
          ></video>
          <div class="ad-copy">
            <div class="ad-tagline" set:html={ui.homeAdTagline} />
            <div class="ad-contact">{ui.homeAdContact}</div>
          </div>
        </a>

        {/* 편집국 추천은 영문 홈에만 둔다. 한글 홈은 맨 위 세 축 띠가 TV·책으로 그 역할을 넘겨받았다 */}
        {en && (
        <>
        <div class="row-head">
          <span class="eyebrow">{ui.homePicks}</span>
          <span class="muted">{ui.homeMonth(new Date().getMonth() + 1)}</span>
        </div>
        <div class="picks">
          {
            editorPicks.map((a, i) => (
              <a href={articleHref(a)} class="pick-row">
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="pick-title">{a.data.title}</span>
                  <span class="pick-meta">
                    <span style={`color:${sectionColor(a.data.section)};`}>
                      {en ? SECTIONS[a.data.section].labelEn : SECTIONS[a.data.section].label}
                    </span>
                    {' · by '}{a.data.reporter}
                  </span>
                </span>
              </a>
            ))
          }
        </div>
        </>
        )}

        <div class="newsletter-dark">
          <div class="eyebrow-dark">{ui.homeNlEyebrow}</div>
          <div class="nl-title">{ui.homeNlTitle}</div>
          {/* 상태 문구는 언어별로 다르다. 스크립트가 사전을 다시 들이지 않도록 여기서 실어 보낸다 */}
          <form
            id="subscribe-form"
            data-busy={ui.subProcessing}
            data-done={ui.subDone}
            data-bad={ui.subBadEmail}
            data-err={ui.subError}
            data-btn={ui.subscribeShort}
          >
            <input type="email" name="email" placeholder={ui.emailPlaceholder} required />
            <button type="submit">{ui.subscribeShort}</button>
          </form>
          <p class="nl-status" id="subscribe-status" hidden></p>
          <a class="nl-more" href={subscribeMoreHref}>{ui.homeNlMore}</a>
        </div>
      </aside>
    </div>
  </div>

  {/*
    이어지는 지면. 영문 홈이 꼭지별 전체 목록·구독·푸터를 여기로 넣는다.
    **같은 `.frame` 안에 들어와야 한다** — 밖에 두면 테두리가 한 번 끊겼다 다시 시작해
    이음매가 가로줄로 보인다(한글 홈은 그 자리가 검은 구독 CTA라 티가 나지 않았다).
  */}
  <slot />
</div>

<script>
  import { confirmEmailDomain } from '../lib/emailTypo';
  // 광고 영상은 화면에 들어올 때만 받아서 재생한다.
  // display:none 안에 있으면 교차가 일어나지 않으므로 폰에서는 아예 받지 않는다.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  if (vids.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          // preload="none"이라 이 시점에는 아직 데이터가 없다. 첫 play()는 거부되므로
          // 받을 준비를 시키고, 데이터가 오면 한 번 더 시도한다.
          // (이걸 안 하면 영상은 내려받아 놓고 멈춘 채로 있다)
          v.preload = 'auto';
          const tryPlay = () => v.play().catch(() => {});
          tryPlay();
          v.addEventListener('canplay', tryPlay, { once: true });
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '200px' });
    vids.forEach((v) => io.observe(v));
  }

  // 구독 폼. 상태 문구는 data-* 로 실려 온다(한/영 한 벌로 쓰기 위해).
  const form = document.getElementById('subscribe-form');
  const statusEl = document.getElementById('subscribe-status');

  function showStatus(text: string) {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.textContent = text;
  }

  if (form instanceof HTMLFormElement) {
    const msg = form.dataset;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.elements.namedItem('email');
      let email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      email = confirmEmailDomain(email, emailInput instanceof HTMLInputElement ? emailInput : null);
      const btn = form.querySelector('button');
      const reset = () => {
        if (btn instanceof HTMLButtonElement) {
          btn.disabled = false;
          btn.textContent = msg.btn ?? '';
        }
      };
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = true;
        btn.textContent = msg.busy ?? '';
      }
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'home-sidebar' }),
        });
        const data = await res.json();
        if (data.ok) {
          form.hidden = true;
          showStatus(msg.done ?? '');
        } else {
          showStatus(msg.bad ?? '');
          reset();
        }
      } catch {
        showStatus(msg.err ?? '');
        reset();
      }
    });
  }
</script>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
    /* 글자를 줄였으니 띠도 같이 줄인다. 안 그러면 빈 검정 띠만 두껍게 남는다 */
    padding: clamp(12px, 2.4vw, 16px) clamp(14px, 4vw, 32px);
  }
  /* 매체를 한 줄로 소개하는 문구다. 제목이 아니다.
     32px/700 흰색이던 때는 제호(24px)보다 커서 이쪽이 매체 이름처럼 읽혔다.
     제호보다 확실히 아래에 두고, 굵기와 색도 한 단계 내려 태그라인으로 만든다. */
  .hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(15px, 2.6vw, 19px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.02em;
    /* 완전 흰색. 크기를 32→19px로 줄여 제호에 자리를 내준 대신
       색은 가장 밝게 둔다(회색으로 눌렀더니 너무 물러났다). */
    color: #fff;
    word-break: keep-all;
  }
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 24px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 10px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted-link {
    font-size: 14px;
    color: var(--meta);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .main-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
    align-items: flex-start;
  }
  .feed {
    flex: 1 1 520px;
    min-width: 0;
  }
  .sidebar {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 316px;
  }
  .picks {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
  }
  .pick-row {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid #e2dccb;
  }
  .pick-row:last-child {
    border-bottom: none;
  }
  .no {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
  }
  .pick-title {
    display: block;
    font-size: clamp(14px, 3.6vw, 15px);
    line-height: 1.5;
    word-break: keep-all;
  }
  .pick-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    margin-top: 5px;
  }
  .newsletter-dark {
    margin-top: 12px;
    background: var(--ink);
    color: #e4e2da;
    padding: 18px;
  }
  .eyebrow-dark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: #9a9a90;
  }
  .nl-title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 17px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 8px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .newsletter-dark form {
    display: flex;
    margin-top: 12px;
  }
  .newsletter-dark form[hidden] {
    display: none;
  }
  .newsletter-dark input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line-dark);
    border-right: none;
    background: #1c1c17;
    color: var(--on-dark);
    outline: none;
  }
  .newsletter-dark button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--on-dark);
    border: 1px solid var(--on-dark);
    padding: 10px 16px;
    cursor: pointer;
  }
  .ad-box {
    position: relative;
    display: block;
    margin-top: 12px;
    overflow: hidden;
    background: #0b0e19;
    border: 1px solid var(--line-dark);
  }
  .ad-box video {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .ad-label {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #e4e2da;
    background: rgba(0, 0, 0, 0.55);
    padding: 2px 7px;
  }
  .ad-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.8));
    color: var(--on-dark);
  }
  .ad-logo {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    height: 18px;
    width: auto;
  }
  .ad-tagline {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .ad-contact {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-dark-mute);
    margin-top: 5px;
  }
  .nl-status {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .nl-more {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--on-dark-mute);
    border-bottom: 1px solid var(--line-dark);
  }
  .nl-more:hover {
    color: var(--on-dark);
  }
</style>
