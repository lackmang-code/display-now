---
/**
 * 홈 PC 지면 — **한글·영문이 함께 쓰는 한 벌.**
 *
 * 종전에는 한글 홈이 `pages/index.astro`, 영문 홈이 `pages/en/index.astro`에
 * 각각 다른 구조로 있었다. 영문 34편을 배포하고 나서 두 홈을 나란히 놓으니
 * 이번 호 배너·꼭지 카드·편집국 추천·광고가 영문 쪽에만 통째로 없었다.
 * **지면을 두 벌로 두면 한글을 고칠 때마다 영문이 조용히 뒤처진다.**
 *
 * 문구는 i18n(`t(lang)`), 데이터는 각 자료 파일의 `~En` 필드가 담당한다.
 * 여기서 언어에 따라 갈리는 것은 **링크 경로**뿐이다.
 */
import Header from './Header.astro';
import ArticleCard from './ArticleCard.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { articleHref, type Article, type Lang } from '../lib/articles';
import { issueNumberLabel, issueDateLabel, issueHref, type IssueMeta } from '../lib/issues';
import { t } from '../lib/i18n';

interface Props {
  lang?: Lang;
  /** 그 언어판 발행 기사 전체. 꼭지별 편수와 「전체 N편」에 쓴다 */
  allArticles: Article[];
  /** 가운데 목록에 실을 최신분 */
  recentArticles: Article[];
  editorPicks: Article[];
  latestIssue?: IssueMeta;
  latestIssueCount: number;
}

const {
  lang = 'ko',
  allArticles,
  recentArticles,
  editorPicks,
  latestIssue,
  latestIssueCount,
} = Astro.props;

const ui = t(lang);
const en = lang === 'en';

/* 영문판에는 아직 꼭지 낱장(`/en/section/*`)도 아카이브도 없다.
   없는 주소로 보내는 대신 같은 지면 아래 꼭지별 전체 목록으로 내린다.
   「아카이브」 자리는 실제로 있는 면인 지난 호 목록이 대신한다. */
const editorialHref = en ? '/en/editorial' : '/editorial';
const sectionHref = (key: string) => (en ? `/en#sec-${key}` : `/section/${key}`);
const archiveHref = en ? '/en/issue' : '/archive';
const feedMoreHref = en ? '/en#sec-tech-note' : '/archive';
const subscribeMoreHref = en ? '/en#subscribe' : '/subscribe';
---

<div class="frame">
  <Header showNav={false} lang={lang} altHref={en ? '/' : '/en'} />

  <section class="hero">
    <h1>{ui.homeTagline}</h1>
  </section>

  {
    latestIssue && (
      <a class="issue-banner" href={issueHref(latestIssue, lang)}>
        <div class="ib-left">
          <span class="ib-label">{ui.homeIssueLabel}</span>
          <span class="ib-no">
            {issueNumberLabel(latestIssue, lang)} · {issueDateLabel(latestIssue)}
          </span>
        </div>
        <div class="ib-main">
          <div class="ib-headline">{en ? latestIssue.headlineEn : latestIssue.headline}</div>
          <div class="ib-meta">
            {ui.articleCount(latestIssueCount)}
            {latestIssue.coverSim && ui.homeCoverSimNote}
          </div>
        </div>
        <span class="ib-go">{ui.homeCoverOpen}</span>
      </a>
    )
  }

  <div class="content-pad">
    <div class="row-head">
      <span class="eyebrow">{ui.homeQuickNav}</span>
      <a href={editorialHref} class="muted-link">{ui.homeEditorialLink}</a>
    </div>

    {/*
      꼭지 카드는 **내비게이션**이다. 종전에는 각 꼭지의 최신 기사 제목을 실었는데,
      그 제목이 바로 아래 기사 목록과 오른쪽 편집국 추천에 그대로 또 나와
      한 화면에서 같은 제목이 서너 번씩 보였다(기사 자리 24칸에 고유 제목 15개).

      제목 대신 **그 꼭지가 무엇을 하는 곳인지** 한 줄로 적는다.
      카드가 목록처럼 보이지 않고, 처음 온 사람이 꼭지를 고를 근거가 생긴다.
    */}
    <div class="quick-cards" data-nav="1">
      {
        SECTION_ORDER.map((key) => {
          const s = SECTIONS[key];
          const n = allArticles.filter((a) => a.data.section === key).length;
          if (n === 0) return null;
          // 첫 문장만. 이미 마침표로 끝나면 또 붙이지 않는다(특허 카드가 ".."이 됐다)
          const first = (en ? s.blurbEn : s.blurb).split('. ')[0];
          const blurb = first.endsWith('.') ? first : first + '.';
          return (
            <a href={sectionHref(key)} class="quick-card" style={`border-color:${sectionColor(key)};`}>
              <div class="band" style={`background:${sectionColor(key)};`}>
                {en ? s.labelEn : s.label}
              </div>
              <div class="body">
                <div class="title">{blurb}</div>
                <div class="byline">{ui.homeSectionByline(n, s.reporter)}</div>
              </div>
            </a>
          );
        })
      }
      <a href={archiveHref} class="quick-card archive-card">
        <div class="band archive-band">{ui.homeArchiveBand}</div>
        <div class="body">
          <div class="title">{ui.homeArchiveTitle}</div>
          <div class="byline">{ui.homeArchiveByline(allArticles.length)}</div>
        </div>
      </a>
    </div>

    <div class="main-split">
      <div class="feed">
        <div class="row-head">
          <span class="eyebrow">{ui.homeFeedHead}</span>
          <a href={feedMoreHref} class="muted-link">{ui.homeFeedLink(allArticles.length)}</a>
        </div>
        <div class="feed-grid">
          {recentArticles.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>

      <aside class="sidebar">
        {/* 광고를 사이드바 맨 위로 올린다. 맨 아래에 두면 스크롤을 끝까지 내려야 보인다 */}
        <a class="ad-box" href="https://www.nextio.ai.kr" target="_blank" rel="noopener">
          <span class="ad-label">{ui.homeAdLabel}</span>
          <img class="ad-logo" src="/uploads/nextio-lockup-reverse.svg" alt="Next I/O" />
          {/*
            autoplay를 떼고 preload="none"으로 둔다. 이 영상은 2.47MB인데
            autoplay가 붙어 있으면 화면에 안 보여도 브라우저가 내려받는다.
            지면을 나눈 뒤 이 광고는 PC 지면에만 있는데, 폰에서 재니
            보이지도 않는 영상 2,528KB를 받고 있었다.
          */}
          <video
            src="/uploads/nextio-ad-mobile-robot.mp4"
            loop
            muted
            playsinline
            preload="none"
            data-lazy-video
          ></video>
          <div class="ad-copy">
            <div class="ad-tagline" set:html={ui.homeAdTagline} />
            <div class="ad-contact">{ui.homeAdContact}</div>
          </div>
        </a>

        <div class="row-head">
          <span class="eyebrow">{ui.homePicks}</span>
          <span class="muted">{ui.homeMonth(new Date().getMonth() + 1)}</span>
        </div>
        <div class="picks">
          {
            editorPicks.map((a, i) => (
              <a href={articleHref(a)} class="pick-row">
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="pick-title">{a.data.title}</span>
                  <span class="pick-meta">
                    <span style={`color:${sectionColor(a.data.section)};`}>
                      {en ? SECTIONS[a.data.section].labelEn : SECTIONS[a.data.section].label}
                    </span>
                    {' · by '}{a.data.reporter}
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="newsletter-dark">
          <div class="eyebrow-dark">{ui.homeNlEyebrow}</div>
          <div class="nl-title">{ui.homeNlTitle}</div>
          {/* 상태 문구는 언어별로 다르다. 스크립트가 사전을 다시 들이지 않도록 여기서 실어 보낸다 */}
          <form
            id="subscribe-form"
            data-busy={ui.subProcessing}
            data-done={ui.subDone}
            data-bad={ui.subBadEmail}
            data-err={ui.subError}
            data-btn={ui.subscribeShort}
          >
            <input type="email" name="email" placeholder={ui.emailPlaceholder} required />
            <button type="submit">{ui.subscribeShort}</button>
          </form>
          <p class="nl-status" id="subscribe-status" hidden></p>
          <a class="nl-more" href={subscribeMoreHref}>{ui.homeNlMore}</a>
        </div>
      </aside>
    </div>
  </div>

  {/*
    이어지는 지면. 영문 홈이 꼭지별 전체 목록·구독·푸터를 여기로 넣는다.
    **같은 `.frame` 안에 들어와야 한다** — 밖에 두면 테두리가 한 번 끊겼다 다시 시작해
    이음매가 가로줄로 보인다(한글 홈은 그 자리가 검은 구독 CTA라 티가 나지 않았다).
  */}
  <slot />
</div>

<script>
  // 광고 영상은 화면에 들어올 때만 받아서 재생한다.
  // display:none 안에 있으면 교차가 일어나지 않으므로 폰에서는 아예 받지 않는다.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  if (vids.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          // preload="none"이라 이 시점에는 아직 데이터가 없다. 첫 play()는 거부되므로
          // 받을 준비를 시키고, 데이터가 오면 한 번 더 시도한다.
          // (이걸 안 하면 영상은 내려받아 놓고 멈춘 채로 있다)
          v.preload = 'auto';
          const tryPlay = () => v.play().catch(() => {});
          tryPlay();
          v.addEventListener('canplay', tryPlay, { once: true });
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '200px' });
    vids.forEach((v) => io.observe(v));
  }

  // 구독 폼. 상태 문구는 data-* 로 실려 온다(한/영 한 벌로 쓰기 위해).
  const form = document.getElementById('subscribe-form');
  const statusEl = document.getElementById('subscribe-status');

  function showStatus(text: string) {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.textContent = text;
  }

  if (form instanceof HTMLFormElement) {
    const msg = form.dataset;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.elements.namedItem('email');
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      const btn = form.querySelector('button');
      const reset = () => {
        if (btn instanceof HTMLButtonElement) {
          btn.disabled = false;
          btn.textContent = msg.btn ?? '';
        }
      };
      if (btn instanceof HTMLButtonElement) {
        btn.disabled = true;
        btn.textContent = msg.busy ?? '';
      }
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'home-sidebar' }),
        });
        const data = await res.json();
        if (data.ok) {
          form.hidden = true;
          showStatus(msg.done ?? '');
        } else {
          showStatus(msg.bad ?? '');
          reset();
        }
      } catch {
        showStatus(msg.err ?? '');
        reset();
      }
    });
  }
</script>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
    /* 글자를 줄였으니 띠도 같이 줄인다. 안 그러면 빈 검정 띠만 두껍게 남는다 */
    padding: clamp(12px, 2.4vw, 16px) clamp(14px, 4vw, 32px);
  }
  /* 매체를 한 줄로 소개하는 문구다. 제목이 아니다.
     32px/700 흰색이던 때는 제호(24px)보다 커서 이쪽이 매체 이름처럼 읽혔다.
     제호보다 확실히 아래에 두고, 굵기와 색도 한 단계 내려 태그라인으로 만든다. */
  .hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(15px, 2.6vw, 19px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.02em;
    /* 완전 흰색. 크기를 32→19px로 줄여 제호에 자리를 내준 대신
       색은 가장 밝게 둔다(회색으로 눌렀더니 너무 물러났다). */
    color: #fff;
    word-break: keep-all;
  }
  /* 이번 호 배너. 히어로 바로 아래에서 그 주 호로 보낸다.
     종전에는 제호·부제·배너가 모두 같은 검정이라 세 덩어리가 하나로 붙어 보였다.
     배너만 밝은 판으로 뒤집어 "여기부터 이번 주 내용"이라는 경계를 만든다.
     골드 테두리로 묶어 아래 콘텐츠 영역과도 섞이지 않게 한다. */
  .issue-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    background: var(--gold);
    color: #17170f;
    padding: 15px clamp(14px, 4vw, 32px) 17px;
  }
  .issue-banner .ib-no,
  .issue-banner .ib-meta {
    color: rgba(23, 23, 15, 0.66);
  }
  .issue-banner .ib-label,
  .issue-banner .ib-go {
    color: #17170f;
    font-weight: 600;
  }
  .ib-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 0 0 auto;
  }
  .ib-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .ib-no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .ib-main {
    flex: 1 1 320px;
    min-width: 0;
  }
  .ib-headline {
    font-family: var(--font-serif);
    font-size: clamp(17px, 3vw, 21px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .ib-meta {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .ib-go {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold);
  }
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 24px;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 10px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--meta-soft);
  }
  .muted-link {
    font-size: 14px;
    color: var(--meta);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .quick-cards {
    display: flex;
    gap: 12px;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2px;
  }
  .quick-card {
    background: var(--card);
    border: 1.5px solid var(--line-frame);
    display: flex;
    flex-direction: column;
    flex: 1 0 clamp(152px, 42vw, 200px);
    min-width: clamp(152px, 42vw, 200px);
    scroll-snap-align: start;
  }
  .quick-card .band {
    color: var(--card);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 8px clamp(12px, 3.2vw, 18px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .archive-card {
    background: var(--card-warm);
    border-color: var(--line-dark);
  }
  .archive-band {
    background: var(--line-dark);
  }
  .quick-card .body {
    padding: clamp(12px, 3.4vw, 16px) clamp(13px, 3.8vw, 18px) clamp(11px, 3vw, 14px);
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }
  .quick-card .title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 18px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.03em;
    word-break: keep-all;
    flex: 1;
  }
  .quick-card .byline {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
  }
  .main-split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
    align-items: flex-start;
  }
  .feed {
    flex: 1 1 520px;
    min-width: 0;
  }
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .sidebar {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 316px;
  }
  .picks {
    background: var(--card-warm);
    border: 1px solid #d8d2c2;
  }
  .pick-row {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid #e2dccb;
  }
  .pick-row:last-child {
    border-bottom: none;
  }
  .no {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
  }
  .pick-title {
    display: block;
    font-size: clamp(14px, 3.6vw, 15px);
    line-height: 1.5;
    word-break: keep-all;
  }
  .pick-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--meta);
    margin-top: 5px;
  }
  .newsletter-dark {
    margin-top: 12px;
    background: var(--ink);
    color: #e4e2da;
    padding: 18px;
  }
  .eyebrow-dark {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: #9a9a90;
  }
  .nl-title {
    font-family: var(--font-serif);
    font-size: clamp(15.5px, 4vw, 17px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 8px;
    line-height: 1.45;
    word-break: keep-all;
  }
  .newsletter-dark form {
    display: flex;
    margin-top: 12px;
  }
  .newsletter-dark form[hidden] {
    display: none;
  }
  .newsletter-dark input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line-dark);
    border-right: none;
    background: #1c1c17;
    color: var(--on-dark);
    outline: none;
  }
  .newsletter-dark button {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    background: var(--on-dark);
    border: 1px solid var(--on-dark);
    padding: 10px 16px;
    cursor: pointer;
  }
  .ad-box {
    position: relative;
    display: block;
    margin-top: 12px;
    overflow: hidden;
    background: #0b0e19;
    border: 1px solid var(--line-dark);
  }
  .ad-box video {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .ad-label {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #e4e2da;
    background: rgba(0, 0, 0, 0.55);
    padding: 2px 7px;
  }
  .ad-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.8));
    color: var(--on-dark);
  }
  .ad-logo {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    height: 18px;
    width: auto;
