---
/**
 * 책 한 권 칸 — 책 목록(/books)과 책 페이지(/books/<slug>)가 같이 쓴다.
 *
 * - `full`이면 소개 문단까지(책 페이지), 아니면 소개 대신 「책 소개 보기」 링크(목록)
 * - 영문 책(`lang: 'en'`)은 칸 안의 글자도 영어로 쓴다
 */
import { type Book, won, bookDateLabel, bookHref } from '../lib/books';

interface Props {
  book: Book;
  full?: boolean;
}
const { book: b, full = false } = Astro.props;
const en = b.lang === 'en';
const today = new Date().toISOString().slice(0, 10);
const title = en ? b.title : `『${b.title}』`;
const dateEn = new Date(`${b.date}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="book" id={b.slug} lang={en ? 'en' : undefined}>
  {
    full ? (
      <img class="cover" src={b.cover} alt={en ? `${b.title} cover` : `${title} 표지`} width={b.coverW} height={b.coverH} decoding="async" />
    ) : (
      <a class="cover-link" href={bookHref(b)}>
        <img class="cover" src={b.cover} alt={en ? `${b.title} cover` : `${title} 표지`} width={b.coverW} height={b.coverH} loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="body">
    {full ? <h1 class="title">{title}</h1> : <h2 class="title"><a href={bookHref(b)}>{title}</a></h2>}
    <p class="author">{b.author}</p>
    <p class="lead">{b.lead}</p>
    <dl class="spec">
      <dt>{en ? 'Published' : '발행'}</dt>
      <dd>
        {en
          ? `${dateEn} · Next I/O`
          : `${b.date > today && b.links.length === 0 ? `${bookDateLabel(b.date)} 출간 예정` : `${b.date.replaceAll('-', '.')} 출간`} · 넥스트아이오`}
      </dd>
      {b.pricePaper && (
        <>
          <dt>종이책</dt>
          <dd>{won(b.pricePaper)}{b.pages && ` · ${b.pages}쪽 · 컬러`}</dd>
        </>
      )}
      {b.priceEbook && (
        <>
          <dt>전자책</dt>
          <dd>{won(b.priceEbook)} · PDF</dd>
        </>
      )}
      {b.ebookNote && (
        <>
          <dt>{en ? 'eBook' : '전자책'}</dt>
          <dd>{b.ebookNote}</dd>
        </>
      )}
    </dl>
    {b.links.length > 0 && (
      <div class="buy">
        {b.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener">{l.label} →</a>
        ))}
      </div>
    )}
    {full ? b.about.map((p) => <p class="about">{p}</p>) : <a class="more" href={bookHref(b)}>{en ? 'About this book →' : '책 소개 보기 →'}</a>}
  </div>
</article>

<style>
  .book {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: flex-start;
    padding: 20px 0;
    border-top: 1px solid var(--line-dark);
  }
  .cover-link {
    flex: 0 0 auto;
    width: min(220px, 60%);
  }
  .cover {
    display: block;
    flex: 0 0 auto;
    width: min(220px, 60%);
    height: auto;
    /* 표지가 어두워 먹색 바탕에 묻힌다 — 밝은 종이색 바탕을 깐다(11/20 대표) */
    box-sizing: border-box;
    padding: 14px;
    background: #eceae4;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }
  .cover-link .cover {
    width: 100%;
  }
  .body {
    flex: 1 1 300px;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(20px, 4vw, 26px);
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .author {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .lead {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--gold);
    word-break: keep-all;
  }
  .spec {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    margin: 16px 0 0;
    font-size: 14px;
  }
  .spec dt {
    font-family: var(--font-mono);
    color: var(--on-dark-mute);
  }
  .spec dd {
    margin: 0;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .buy a {
    padding: 8px 14px;
    background: var(--gold);
    color: #17170f;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .more {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    color: var(--on-dark);
  }
  .about {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.75;
    color: #d6d5cd;
    word-break: keep-all;
  }
</style>
