---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimBoot from '../components/SimBoot.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { bylineOf, articleHref, readingLabel, leadImage, baseSlug } from '../lib/articles';
import {
  ISSUES,
  articlesOfIssue,
  issueNumberLabel,
  issueDateLabel,
  issueRangeLabel,
  collectRangeLabel,
  getAllIssuesEn,
  SHOW_PUBLISH_DATE,
  type IssueMeta,
} from '../lib/issues';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/articles';

interface Props {
  issue: IssueMeta;
  lang?: Lang;
}

const { issue, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const ui = t(lang);
const articles = await articlesOfIssue(issue, lang);

// 표지 문구는 번역이 아니라 다시 쓴 것이다(`headlineEn`). 없으면 한글판 문구로 떨어진다.
const headline = (en && issue.headlineEn) || issue.headline;
const deck = en ? issue.deckEn : issue.deck;

// 🔴 영문판 slug 는 `en/<한글 slug>` 라 그대로 비교하면 헤드를 못 찾는다 (2026-09-08).
// 못 찾으면 헤드가 목차에서 안 빠져 영문 호만 「6 more in this issue」로 나왔다.
// 짝을 맞추는 비교는 언제나 baseSlug 다.
const head = issue.headSlug
  ? articles.find((a) => baseSlug(a) === issue.headSlug)
  : articles[0];
const fallbackImage = issue.coverImage ?? (head ? leadImage(head) : undefined);

// 헤드 기사는 표지가 이미 크게 싣는다. 아래 목차는 나머지만 받는다.
// 종전에는 표지 커버라인 네 줄과 목차가 같은 제목을 두 번 보여줬고,
// 헤드 기사 제목은 표지 헤드라인과 목차에 또 두 번 나왔다.
//
// 🔴 헤드 기사는 표지 문구와 제목이 다르더라도 목차에서 뺀다 (2026-09-08 수정).
// 종전에는 「표지 문구 === 기사 제목」일 때만 뺐다. 표지 문구를 따로 지은 호에서
// 목차에서까지 빼면 기사 제목이 페이지 어디에도 안 나오기 때문이었는데,
// 그 대가로 **같은 기사가 서로 다른 두 제목으로 두 번 실렸다.**
// 제1·3·4호가 전부 그 상태였고, 대표가 제4호에서 두 기사로 오독했다.
// 이제 제목이 다를 때는 표지 헤드 블록에 기사 제목을 함께 얹어(head-title)
// 「사라지는 문제」를 그쪽에서 풀고, 목차에서는 언제나 뺀다.
// 표지 문구와 기사 제목이 같은지도 그 언어의 값끼리 견준다.
const headIsSameTitle = !!head && headline.trim() === head.data.title.trim();
const rest = head ? articles.filter((a) => a.slug !== head.slug) : articles;

// 🔴 한·영 전환 스위치 (2026-09-08 추가).
// 호 페이지에만 스위치가 없었다 — IssueView 가 Header 에 altHref 를 안 넘겼다.
// **짝이 실제로 있을 때만 단다.** 영문 호는 `headlineEn` 이 채워진 호만 생성되므로
// 한글 쪽에서는 그 조건을 그대로 물어본다. 영문 쪽의 짝(한글 호)은 언제나 있다.
// hreflang 은 검색엔진용 메타라 화면에 아무것도 그리지 않는다. 스위치는 Header 가 그린다 —
// 둘 다 넘겨야 한다.
const hasEnIssue = getAllIssuesEn().some((i) => i.no === issue.no);
const altHref = en
  ? `/issue/${issue.no}`
  : hasEnIssue
    ? `/en/issue/${issue.no}`
    : undefined;

const grouped = SECTION_ORDER.map((key) => ({
  key,
  list: rest.filter((a) => a.data.section === key),
})).filter((g) => g.list.length > 0);
---

<Base
  title={`${issueNumberLabel(issue, lang)} ${headline} | DISPLAY NOW`}
  description={deck ?? headline}
  image={`/og/issue-${issue.no}.png`}
  lang={lang}
  altHref={altHref}
>
  <div class="frame issue-frame">
    <section class="cover">
      <div class="cover-inner">
      <div class="cover-top">
        <div class="mast-col">
          {/*
            호수를 제호 바로 옆에 크게 붙인다. 오른쪽 작은 회색 줄에만 있던 때는
            제호 62px 대 호수 15px로 4.1배 차이라 몇 호인지 눈에 안 들어왔다(2026-08-25 지적).
            한글 세 글자는 작아지면 뭉개지므로 숫자를 크게, "호"를 작게 둔다.
          */}
          <div class="mast-row">
            <a href={en ? '/en' : '/'} class="mast">
              <img class="mast-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
              <span>DISPLAY NOW</span>
            </a>
            <span class="mast-no"><b>{issue.no}</b>{ui.issueUnit && <i>{ui.issueUnit}</i>}</span>
          </div>
          <span class="identity">{ui.issueIdentity}</span>
        </div>
        {altHref && (
          <div class="cover-lang">
            <LangSwitch lang={lang} altHref={altHref} />
          </div>
        )}
        <span class="issue-no">
          {collectRangeLabel(issue, lang)}
          {SHOW_PUBLISH_DATE && <> · {issueDateLabel(issue)}</>}
        </span>
      </div>

      <div class="cover-stage">
        {
          issue.coverSim ? (
            <div
              class="cover-sim"
              data-sim={issue.coverSim}
              data-params={issue.coverSimParams ? JSON.stringify(issue.coverSimParams) : undefined}
            />
          ) : fallbackImage ? (
            <img class="cover-img" src={fallbackImage} alt={ui.coverAlt(issueNumberLabel(issue, lang))} />
          ) : null
        }
      </div>

      <div class="cover-bottom">
        {/*
          표지 헤드라인이 곧 헤드 기사다(headline은 그 기사 제목을 그대로 쓴다).
          제목을 그 기사로 가는 링크로 만들고 꼭지·기자·읽는 시간을 여기 붙인 뒤,
          아래 목차에서는 헤드 기사를 뺐다.

          커버라인 네 줄도 뺐다. 바로 밑 목차에 같은 제목이 그대로 다시 나왔다.
          인쇄 표지에 해당하는 포스터·og 카드에는 커버라인이 그대로 있다 —
          그쪽은 한 장으로 끝나는 그림이라 목차가 따라붙지 않는다.
        */}
        {
          head ? (
            <a class="head-link" href={articleHref(head)}>
              <h1>{headline}</h1>
            </a>
          ) : (
            <h1>{headline}</h1>
          )
        }
        {deck && <p class="deck">{deck}</p>}
        {
          head && !headIsSameTitle && (
            <p class="head-title"><span class="head-title-label">{ui.articleTitleLabel}</span> {head.data.title}</p>
          )
        }
        {
          head && (
            <div class="head-meta">
              <span style={`color:${sectionColor(head.data.section, 0.78)};`}>
                {en ? SECTIONS[head.data.section].labelEn : SECTIONS[head.data.section].label}
              </span>
              <span>{bylineOf(head)}</span>
              <span>{ui.readFor(readingLabel(head))}</span>
            </div>
          )
        }

        {
          issue.coverSim && (
            <div class="cover-hint">
              {ui.coverHint}
            </div>
          )
        }
      </div>
      </div>
    </section>

    {/* 전환 스위치는 표지 우상단 하나만 둔다 — 헤더까지 달면 같은 버튼이
        745px 간격으로 두 개 선다. hreflang 은 Base 가 altHref 로 받는다. */}
    <Header showNav={false} lang={lang} />

    <div class="content-pad">
      <div class="row-head">
        <span class="eyebrow">{ui.alsoInIssue(rest.length)}</span>
        <span class="muted">{issueRangeLabel(issue, lang)}</span>
      </div>

      {
        grouped.map((g) => (
          <section class="toc-group">
            <div class="toc-band" style={`background:${sectionColor(g.key)};`}>
              {en ? SECTIONS[g.key].labelEn : SECTIONS[g.key].label}
            </div>
            {
              g.list.map((a) => {
                const thumb = leadImage(a);
                return (
                  <a href={articleHref(a)} class="toc-row" style={`border-left-color:${sectionColor(g.key)};`}>
                    {thumb && <img class="toc-thumb" src={thumb} alt="" loading="lazy" />}
                    <div class="toc-main">
                      <div class="toc-title">{a.data.title}</div>
                      <p class="toc-summary">{a.data.summary}</p>
                      <div class="toc-meta">{bylineOf(a)} · {ui.readFor(readingLabel(a))}</div>
                    </div>
                  </a>
                );
              })
            }
          </section>
        ))
      }
      {articles.length === 0 && <p class="empty">{ui.emptyIssue}</p>}

      {/*
        🔴 편집장 노트는 2026-09-08 대표 결정으로 폐기했다. 되살리지 말 것.
        ① 기사의 결론을 미리 흘렸다 — 노트만 읽으면 기사를 열 이유가 줄어든다.
           근거 목록을 전부 싣는 매체가 결론만 요약해 표지에 붙이는 꼴이었다.
        ② 같은 화면에서 제목·summary·꼭지 구분이 이미 세 번 안내한다. 노트는 네 번째였다.
        ③ 분량이 호마다 늘었다 — 233 → 509 → 588 → 706자. 매주 쓰는 비용이 계속 올랐다.
        「이 호가 왜 한 호인가」는 표지 문구와 덱이 헤드 기사에 대해 하고,
        AI 편집장 DEEPLE 표기는 기사 바이라인에 그대로 남는다.
      */}

      <div class="issue-foot">
        <a href={en ? '/en/issue' : '/issue'} class="muted-link">{ui.allIssues}</a>
      </div>
    </div>

    <Footer lang={lang} />
  </div>
</Base>

<SimBoot />

<style is:global>
  /* 표지에서는 시뮬레이터의 제목 띠와 고지 문단을 접는다. 표지는 한 장으로 읽혀야 하고,
     같은 시뮬레이터가 기사 본문에 고지와 함께 다시 나오기 때문이다. */
  .cover-stage .sim-embed {
    border: 0;
    margin: 0;
    background: transparent;
  }
  .cover-stage .sim-head,
  .cover-stage .sim-note {
    display: none;
  }
</style>

<style>
  /* 호 페이지는 한 권짜리 판형이다. 프레임 자체를 좁혀 헤더·구독 버튼·푸터까지
     표지와 같은 폭으로 세운다. 다른 페이지의 프레임 폭(1180px)은 그대로 둔다. */
  .issue-frame {
    width: min(808px, 100%);
    background: var(--ink);
    color: var(--on-dark);
    border-left-color: var(--line-dark);
    border-right-color: var(--line-dark);
  }

  .cover {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(16px, 3.5vw, 26px) clamp(14px, 4vw, 32px) clamp(20px, 4vw, 34px);
  }
  /* 표지는 판형을 갖는다. 넓은 화면에서 가로로 늘어지면 표지가 아니라 배너로 보인다.
     좌우 여백은 비워 두는 편이 잡지 표지에 가깝다. */
  .cover-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.6vw, 20px);
  }
  .cover-top {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1.5px solid rgba(244, 243, 238, 0.28);
  }
  /* 🔴 전환 스위치는 표지 우상단에 둔다 (2026-09-08 대표 지시).
     종전에는 호 페이지에만 스위치가 아예 없었고, 헤더에 달았더니 표지 727px 를
     지난 y=745px 라 첫 화면에서 눈에 띄지 않았다. 영문 유입이 목적인데
     전환 경로가 안 보이면 그 자리에서 나간다. */
  .cover-lang {
    position: absolute;
    top: 2px;
    right: 0;
  }
  /* 좁은 폭에서는 제호와 겹치므로 흐름 안으로 되돌린다. */
  @media (max-width: 560px) {
    .cover-lang {
      position: static;
      order: 3;
      width: 100%;
    }
  }
  .mast-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  /* 매체 정체성 한 줄. 마스트헤드 바로 아래에 작게 붙인다 */
  .identity {
    font-size: clamp(12.5px, 1.6vw, 14px);
    letter-spacing: 0.01em;
    line-height: 1.5;
    opacity: 0.72;
    word-break: keep-all;
  }
  /* 제호와 호수를 한 줄로 세운다. 정체성 문구는 그 아래 줄 */
  .mast-row {
    display: flex;
    align-items: baseline;
    gap: clamp(8px, 1.6vw, 18px);
    flex-wrap: wrap;
    min-width: 0;
  }
  .mast-no {
    display: flex;
    align-items: baseline;
    gap: 2px;
    color: var(--gold);
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1;
    flex: 0 0 auto;
  }
  /* 제호(최대 62px)보다 한 단계 아래로 둔다. 같은 vw 축에 걸어 함께 움직인다 */
  .mast-no b {
    font-size: clamp(20px, 5.4vw, 48px);
    letter-spacing: -0.04em;
  }
  .mast-no i {
    font-style: normal;
    font-size: clamp(14px, 2.8vw, 26px);
  }

  .mast {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 14px);
    font-family: var(--font-serif);
    /* 최소값을 30px에서 24px로 내렸다. 320px에서 제호가 폭을 다 먹어
       옆의 호수가 아랫줄로 밀려났기 때문이다. 좁은 화면에서만 작아진다. */
    font-size: clamp(24px, 7vw, 62px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--gold);
  }
  /* 마크는 제호보다 작게. 표지 활자 위계는 제호가 언제나 맨 위다 */
  .mast-mark {
    height: 0.78em;
    width: auto;
    display: block;
    flex: 0 0 auto;
  }
  .issue-no {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.8vw, 15px);
    letter-spacing: 0.08em;
    opacity: 0.78;
  }
  .cover-stage {
    background: var(--card);
    border: 1.5px solid rgba(244, 243, 238, 0.2);
    padding: clamp(10px, 2vw, 18px);
    color: var(--ink);
  }
  .cover-sim {
    display: block;
  }
  .cover-img {
    display: block;
    width: 100%;
    max-height: 56svh;
    object-fit: contain;
  }
  .cover-bottom h1 {
    margin: 0 0 10px;
    font-family: var(--font-serif);
    font-size: clamp(21px, 4.4vw, 32px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.04em;
    word-break: keep-all;
  }
  .deck {
    margin: 0 0 16px;
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.7;
    opacity: 0.86;
    max-width: 62ch;
    word-break: keep-all;
  }
  .head-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  /* 표지 헤드라인 밑에 붙는 한 줄. 표지만 봐도 그 기사가 어떤 글인지 알 수 있게 한다 */
  .head-title {
    margin: 0.55rem 0 0;
    font-size: 0.94rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }
  /* 🔴 라벨을 ::before content 로 박지 않는다 (2026-09-08).
     한글 「기사 제목 · 」이 CSS 에 있어 영문 호에도 그대로 찍혔다.
     원고 밖에서 화면에 찍히는 글자는 i18n 사전이 덮지 못하므로 템플릿이 갖는다. */
  .head-title-label {
    color: rgba(255, 255, 255, 0.4);
  }
  .head-title-label::after {
    content: ' · ';
  }
  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(244, 243, 238, 0.2);
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.5vw, 13.5px);
    letter-spacing: 0.03em;
    color: var(--on-dark-mute);
  }
  .cover-hint {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0.62;
  }

  /* 표지 아래 목차·편집장 노트까지 표지와 같은 판형 폭으로 이어 붙인다.
     한 권을 위에서 아래로 넘겨 보는 흐름이 되도록. */
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 32px;
    max-width: calc(760px + 48px);
    margin: 0 auto;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--on-dark-mute);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--on-dark-mute);
  }
  .toc-group {
    margin-bottom: 20px;
  }
  .toc-band {
    display: inline-block;
    color: var(--card);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    margin-bottom: 8px;
  }
  .toc-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid rgba(244, 243, 238, 0.14);
    border-left-width: 4px;
    background: rgba(244, 243, 238, 0.05);
    color: var(--on-dark);
    padding: 14px 16px;
    margin-bottom: 8px;
  }
  .toc-thumb {
    flex: 0 0 auto;
    width: clamp(72px, 16vw, 116px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: rgba(244, 243, 238, 0.08);
    border: 1px solid rgba(244, 243, 238, 0.16);
  }
  /* 좁은 화면에서는 썸네일을 뺀다.
     402px에서 72×54px까지 줄어 무슨 그림인지 알아볼 수 없으면서,
     72px를 가져가는 바람에 글이 좁은 칸에 갇혀 요약이 8~10줄로 늘어났다.
     행 하나가 310~356px가 되어 목차를 훑을 수가 없었다.
