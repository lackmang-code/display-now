---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimBoot from '../components/SimBoot.astro';
import { SECTIONS, SECTION_ORDER, sectionColor } from '../lib/sections';
import { bylineOf, articleHref, readingLabel, leadImage } from '../lib/articles';
import {
  ISSUES,
  articlesOfIssue,
  issueNumberLabel,
  issueDateLabel,
  issueRangeLabel,
  collectRangeLabel,
  SHOW_PUBLISH_DATE,
  type IssueMeta,
} from '../lib/issues';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/articles';

interface Props {
  issue: IssueMeta;
  lang?: Lang;
}

const { issue, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const ui = t(lang);
const articles = await articlesOfIssue(issue, lang);

// 표지 문구는 번역이 아니라 다시 쓴 것이다(`headlineEn`). 없으면 한글판 문구로 떨어진다.
const headline = (en && issue.headlineEn) || issue.headline;
const deck = en ? issue.deckEn : issue.deck;
const note = en ? issue.noteEn : issue.note;

const head = issue.headSlug ? articles.find((a) => a.slug === issue.headSlug) : articles[0];
const fallbackImage = issue.coverImage ?? (head ? leadImage(head) : undefined);

// 헤드 기사는 표지가 이미 크게 싣는다. 아래 목차는 나머지만 받는다.
// 종전에는 표지 커버라인 네 줄과 목차가 같은 제목을 두 번 보여줬고,
// 헤드 기사 제목은 표지 헤드라인과 목차에 또 두 번 나왔다.
//
// ⚠️ 단, 표지 헤드라인이 헤드 기사 제목과 **같을 때만** 뺀다.
// 제1호처럼 표지 문구를 따로 지은 호에서는 헤드라인이 기사 제목이 아니어서,
// 목차에서까지 빼면 그 기사 제목이 페이지 어디에도 나오지 않는다
// (실제로 "2스택 탠덤으로 회귀한 LG디스플레이…"가 통째로 사라졌다).
const headIsSameTitle = !!head && issue.headline.trim() === head.data.title.trim();
const rest = headIsSameTitle ? articles.filter((a) => a.slug !== head!.slug) : articles;

const grouped = SECTION_ORDER.map((key) => ({
  key,
  list: rest.filter((a) => a.data.section === key),
})).filter((g) => g.list.length > 0);
---

<Base
  title={`${issueNumberLabel(issue, lang)} ${headline} | DISPLAY NOW`}
  description={deck ?? headline}
  image={`/og/issue-${issue.no}.png`}
  lang={lang}
>
  <div class="frame issue-frame">
    <section class="cover">
      <div class="cover-inner">
      <div class="cover-top">
        <div class="mast-col">
          {/*
            호수를 제호 바로 옆에 크게 붙인다. 오른쪽 작은 회색 줄에만 있던 때는
            제호 62px 대 호수 15px로 4.1배 차이라 몇 호인지 눈에 안 들어왔다(2026-08-25 지적).
            한글 세 글자는 작아지면 뭉개지므로 숫자를 크게, "호"를 작게 둔다.
          */}
          <div class="mast-row">
            <a href={en ? '/en' : '/'} class="mast">
              <img class="mast-mark" src="/logo/dn-mark.png" alt="" width="512" height="429" />
              <span>DISPLAY NOW</span>
            </a>
            <span class="mast-no"><b>{issue.no}</b>{ui.issueUnit && <i>{ui.issueUnit}</i>}</span>
          </div>
          <span class="identity">{ui.issueIdentity}</span>
        </div>
        <span class="issue-no">
          {collectRangeLabel(issue, lang)}
          {SHOW_PUBLISH_DATE && <> · {issueDateLabel(issue)}</>}
        </span>
      </div>

      <div class="cover-stage">
        {
          issue.coverSim ? (
            <div
              class="cover-sim"
              data-sim={issue.coverSim}
              data-params={issue.coverSimParams ? JSON.stringify(issue.coverSimParams) : undefined}
            />
          ) : fallbackImage ? (
            <img class="cover-img" src={fallbackImage} alt={ui.coverAlt(issueNumberLabel(issue, lang))} />
          ) : null
        }
      </div>

      <div class="cover-bottom">
        {/*
          표지 헤드라인이 곧 헤드 기사다(headline은 그 기사 제목을 그대로 쓴다).
          제목을 그 기사로 가는 링크로 만들고 꼭지·기자·읽는 시간을 여기 붙인 뒤,
          아래 목차에서는 헤드 기사를 뺐다.

          커버라인 네 줄도 뺐다. 바로 밑 목차에 같은 제목이 그대로 다시 나왔다.
          인쇄 표지에 해당하는 포스터·og 카드에는 커버라인이 그대로 있다 —
          그쪽은 한 장으로 끝나는 그림이라 목차가 따라붙지 않는다.
        */}
        {
          head ? (
            <a class="head-link" href={articleHref(head)}>
              <h1>{headline}</h1>
            </a>
          ) : (
            <h1>{headline}</h1>
          )
        }
        {deck && <p class="deck">{deck}</p>}
        {
          head && (
            <div class="head-meta">
              <span style={`color:${sectionColor(head.data.section, 0.78)};`}>
                {en ? SECTIONS[head.data.section].labelEn : SECTIONS[head.data.section].label}
              </span>
              <span>{bylineOf(head)}</span>
              <span>{ui.readFor(readingLabel(head))}</span>
            </div>
          )
        }

        {
          issue.coverSim && (
            <div class="cover-hint">
              {ui.coverHint}
            </div>
          )
        }
      </div>
      </div>
    </section>

    <Header showNav={false} lang={lang} />

    <div class="content-pad">
      <div class="row-head">
        <span class="eyebrow">{ui.alsoInIssue(rest.length)}</span>
        <span class="muted">{issueRangeLabel(issue, lang)}</span>
      </div>

      {
        grouped.map((g) => (
          <section class="toc-group">
            <div class="toc-band" style={`background:${sectionColor(g.key)};`}>
              {en ? SECTIONS[g.key].labelEn : SECTIONS[g.key].label}
            </div>
            {
              g.list.map((a) => {
                const thumb = leadImage(a);
                return (
                  <a href={articleHref(a)} class="toc-row" style={`border-left-color:${sectionColor(g.key)};`}>
                    {thumb && <img class="toc-thumb" src={thumb} alt="" loading="lazy" />}
                    <div class="toc-main">
                      <div class="toc-title">{a.data.title}</div>
                      <p class="toc-summary">{a.data.summary}</p>
                      <div class="toc-meta">{bylineOf(a)} · {ui.readFor(readingLabel(a))}</div>
                    </div>
                  </a>
                );
              })
            }
          </section>
        ))
      }
      {articles.length === 0 && <p class="empty">{ui.emptyIssue}</p>}

      {
        issue.note && (
          <div class="note">
            <div class="note-label">{ui.editorNote}</div>
            <p>{note}</p>
            <div class="note-sign">{ui.editorLabel} <b>DEEPLE</b></div>
          </div>
        )
      }

      <div class="issue-foot">
        <a href={en ? '/en/issue' : '/issue'} class="muted-link">{ui.allIssues}</a>
      </div>
    </div>

    <Footer lang={lang} />
  </div>
</Base>

<SimBoot />

<style is:global>
  /* 표지에서는 시뮬레이터의 제목 띠와 고지 문단을 접는다. 표지는 한 장으로 읽혀야 하고,
     같은 시뮬레이터가 기사 본문에 고지와 함께 다시 나오기 때문이다. */
  .cover-stage .sim-embed {
    border: 0;
    margin: 0;
    background: transparent;
  }
  .cover-stage .sim-head,
  .cover-stage .sim-note {
    display: none;
  }
</style>

<style>
  /* 호 페이지는 한 권짜리 판형이다. 프레임 자체를 좁혀 헤더·구독 버튼·푸터까지
     표지와 같은 폭으로 세운다. 다른 페이지의 프레임 폭(1180px)은 그대로 둔다. */
  .issue-frame {
    width: min(808px, 100%);
    background: var(--ink);
    color: var(--on-dark);
    border-left-color: var(--line-dark);
    border-right-color: var(--line-dark);
  }

  .cover {
    background: var(--ink);
    color: var(--on-dark);
    padding: clamp(16px, 3.5vw, 26px) clamp(14px, 4vw, 32px) clamp(20px, 4vw, 34px);
  }
  /* 표지는 판형을 갖는다. 넓은 화면에서 가로로 늘어지면 표지가 아니라 배너로 보인다.
     좌우 여백은 비워 두는 편이 잡지 표지에 가깝다. */
  .cover-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.6vw, 20px);
  }
  .cover-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1.5px solid rgba(244, 243, 238, 0.28);
  }
  .mast-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  /* 매체 정체성 한 줄. 마스트헤드 바로 아래에 작게 붙인다 */
  .identity {
    font-size: clamp(12.5px, 1.6vw, 14px);
    letter-spacing: 0.01em;
    line-height: 1.5;
    opacity: 0.72;
    word-break: keep-all;
  }
  /* 제호와 호수를 한 줄로 세운다. 정체성 문구는 그 아래 줄 */
  .mast-row {
    display: flex;
    align-items: baseline;
    gap: clamp(8px, 1.6vw, 18px);
    flex-wrap: wrap;
    min-width: 0;
  }
  .mast-no {
    display: flex;
    align-items: baseline;
    gap: 2px;
    color: var(--gold);
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1;
    flex: 0 0 auto;
  }
  /* 제호(최대 62px)보다 한 단계 아래로 둔다. 같은 vw 축에 걸어 함께 움직인다 */
  .mast-no b {
    font-size: clamp(20px, 5.4vw, 48px);
    letter-spacing: -0.04em;
  }
  .mast-no i {
    font-style: normal;
    font-size: clamp(14px, 2.8vw, 26px);
  }

  .mast {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 14px);
    font-family: var(--font-serif);
    /* 최소값을 30px에서 24px로 내렸다. 320px에서 제호가 폭을 다 먹어
       옆의 호수가 아랫줄로 밀려났기 때문이다. 좁은 화면에서만 작아진다. */
    font-size: clamp(24px, 7vw, 62px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--gold);
  }
  /* 마크는 제호보다 작게. 표지 활자 위계는 제호가 언제나 맨 위다 */
  .mast-mark {
    height: 0.78em;
    width: auto;
    display: block;
    flex: 0 0 auto;
  }
  .issue-no {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.8vw, 15px);
    letter-spacing: 0.08em;
    opacity: 0.78;
  }
  .cover-stage {
    background: var(--card);
    border: 1.5px solid rgba(244, 243, 238, 0.2);
    padding: clamp(10px, 2vw, 18px);
    color: var(--ink);
  }
  .cover-sim {
    display: block;
  }
  .cover-img {
    display: block;
    width: 100%;
    max-height: 56svh;
    object-fit: contain;
  }
  .cover-bottom h1 {
    margin: 0 0 10px;
    font-family: var(--font-serif);
    font-size: clamp(21px, 4.4vw, 32px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.04em;
    word-break: keep-all;
  }
  .deck {
    margin: 0 0 16px;
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.7;
    opacity: 0.86;
    max-width: 62ch;
    word-break: keep-all;
  }
  .head-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  /* 표지 헤드라인 밑에 붙는 한 줄. 표지만 봐도 그 기사가 어떤 글인지 알 수 있게 한다 */
  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(244, 243, 238, 0.2);
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.5vw, 13.5px);
    letter-spacing: 0.03em;
    color: var(--on-dark-mute);
  }
  .cover-hint {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0.62;
  }

  /* 표지 아래 목차·편집장 노트까지 표지와 같은 판형 폭으로 이어 붙인다.
     한 권을 위에서 아래로 넘겨 보는 흐름이 되도록. */
  .content-pad {
    padding: 20px clamp(14px, 4vw, 24px) 32px;
    max-width: calc(760px + 48px);
    margin: 0 auto;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--on-dark-mute);
  }
  .muted {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--on-dark-mute);
  }
  .toc-group {
    margin-bottom: 20px;
  }
  .toc-band {
    display: inline-block;
    color: var(--card);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    margin-bottom: 8px;
  }
  .toc-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 1px solid rgba(244, 243, 238, 0.14);
    border-left-width: 4px;
    background: rgba(244, 243, 238, 0.05);
    color: var(--on-dark);
    padding: 14px 16px;
    margin-bottom: 8px;
  }
  .toc-thumb {
    flex: 0 0 auto;
    width: clamp(72px, 16vw, 116px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: rgba(244, 243, 238, 0.08);
    border: 1px solid rgba(244, 243, 238, 0.16);
  }
  /* 좁은 화면에서는 썸네일을 뺀다.
     402px에서 72×54px까지 줄어 무슨 그림인지 알아볼 수 없으면서,
     72px를 가져가는 바람에 글이 좁은 칸에 갇혀 요약이 8~10줄로 늘어났다.
     행 하나가 310~356px가 되어 목차를 훑을 수가 없었다.
     그림을 보는 자리는 기사 본문이지 목차가 아니다. */
  @media (max-width: 640px) {
    .toc-thumb {
      display: none;
    }
    /* 요약도 세 줄까지만. 목차는 고르는 곳이지 읽는 곳이 아니다 */
    .toc-summary {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-align: left;
    }
  }
  .toc-main {
    min-width: 0;
  }
  .toc-row,
  .toc-row:visited {
    text-decoration: none;
  }
  .toc-title {
    color: var(--on-dark);
    font-family: var(--font-serif);
    font-size: clamp(16px, 3vw, 19px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .toc-summary {
    margin: 7px 0 8px;
    font-size: 14px;
    line-height: 1.65;
    color: #cfcec6;
    text-align: justify;
  }
  .toc-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .empty {
    color: var(--on-dark-mute);
    font-size: 15px;
  }
  .note {
    margin-top: 6px;
    background: rgba(244, 243, 238, 0.05);
    border: 1px solid rgba(244, 243, 238, 0.14);
    padding: 16px 18px;
  }
  .note-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--gold-dim);
    margin-bottom: 8px;
  }
  .note p {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    text-align: justify;
  }
  .note-sign {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--on-dark-mute);
  }
  .note-sign b {
    font-weight: 500;
  }
  .issue-foot {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(244, 243, 238, 0.16);
  }
  .muted-link {
    font-size: 14px;
    color: var(--on-dark-mute);
  }
</style>
