---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  /** 이 페이지의 언어. `<html lang>`과 hreflang에 함께 쓰인다. */
  lang?: 'ko' | 'en';
  /**
   * 반대 언어판의 경로. **짝이 실제로 있을 때만 넘긴다.**
   *
   * 넘어오면 hreflang 세 줄(ko·en·x-default)이 걸리고, 없으면 한 줄도 걸리지 않는다.
   * 없는 페이지를 가리키는 hreflang은 구글에 잘못된 짝을 신고하는 것과 같다.
   */
  altHref?: string;
}

const DESC_KO =
  '디스플레이 나우(DISPLAY NOW)는 100% 전문 AI 기자단으로 구성된 디스플레이 산업 전문 온라인 매거진입니다.';
const DESC_EN =
  'DISPLAY NOW is a display-industry trade magazine written entirely by a team of specialist AI reporters. Every article ships with its full source list.';

const {
  title,
  noindex = false,
  image = '/og/default.png',
  lang = 'ko',
  altHref,
} = Astro.props;
const description = Astro.props.description ?? (lang === 'en' ? DESC_EN : DESC_KO);

// 짝이 있을 때만 hreflang을 건다. 한글판을 x-default로 둔다 — 원본이 한글이고,
// 언어를 특정할 수 없는 방문자에게 보낼 기본판이 그쪽이기 때문이다.

// 빌드를 파일 방식(`foo.html`)으로 내므로 pathname에 확장자가 붙는다. 그대로 쓰면 canonical이
// `/tag.html`이 되어 사이트맵·내부 링크가 가리키는 `/tag`와 어긋난다. 확장자를 떼어 셋을 맞춘다.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);
const imageURL = new URL(image, Astro.site);

// 짝이 있을 때만 hreflang을 건다. 없는 페이지를 가리키는 hreflang은 구글에 잘못된 짝을
// 신고하는 것과 같다. 한글판을 x-default로 둔다 — 원본이 한글이라서다.
const koURL = altHref ? (lang === 'ko' ? canonicalURL : new URL(altHref, Astro.site)) : null;
const enURL = altHref ? (lang === 'en' ? canonicalURL : new URL(altHref, Astro.site)) : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="AoI9GAr5S4qLW7ldXSpgmCJ81R7dgFBFh2o00_T7dJA" />
    <meta name="naver-site-verification" content="8fef8f501fc323b567a6562eb3efeda472394cab" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {koURL && <link rel="alternate" hreflang="ko" href={koURL} />}
    {enURL && <link rel="alternate" hreflang="en" href={enURL} />}
    {koURL && <link rel="alternate" hreflang="x-default" href={koURL} />}
    <link rel="alternate" type="application/rss+xml" title="DISPLAY NOW RSS" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DISPLAY NOW" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NewsMediaOrganization',
      name: 'DISPLAY NOW',
      // 한글 표기를 검색엔진에 알린다. 사이트 본문은 전부 영문 워드마크라서,
      // 이것이 없으면 "디스플레이 나우"로 찾는 사람에게 이 매체는 존재하지 않는다
      // (2026-08-24 실제로 검색해 확인 — 삼성 나우바만 나왔다).
      alternateName: ['디스플레이 나우', '디스플레이나우', 'DisplayNow'],
      url: Astro.site?.toString(),
      logo: new URL('/logo/dn-lockup-reverse.png', Astro.site).toString(),
      // 페이지 언어를 따른다. 영문 페이지가 자기를 한국어 매체라고 신고하면
      // 검색엔진이 영문 독자에게 내보낼 이유를 잃는다.
      // alternateName의 한글 표기는 언어와 무관한 사실이므로 양쪽에 그대로 둔다.
      inLanguage: lang,
      description:
        lang === 'en'
          ? 'DISPLAY NOW is a display-industry trade magazine written by four AI reporters, built on papers, patents and public filings alone.'
          : '디스플레이 나우(DISPLAY NOW)는 네 명의 AI 기자가 논문·특허·공시만 근거로 쓰는 디스플레이 산업 전문 온라인 매거진입니다.',
      publisher: {
        '@type': 'Organization',
        name: lang === 'en' ? 'NEXTIO' : '넥스트아이오',
        alternateName: lang === 'en' ? '넥스트아이오' : 'Next I/O',
      },
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
