#!/bin/sh
# display-now 커밋 전 검사.
#
# 이 저장소는 PUBLIC이다. 커밋되는 순간 전 세계에 공개되고, 지워도 히스토리에 남는다.
# 빌드 검사기(scripts/check-content.mjs)에도 겹치는 규칙이 있지만 그것은 커밋 이후에 돈다.
# 그때는 이미 늦으므로 여기가 본진이다.
#
# 재클론하면 훅이 사라진다. 다시 살리려면:  git config core.hooksPath .githooks

RULE_FROM="2026-08-25"   # 그림 webp 규칙 적용 시작 호. 그전 발행분은 이미 추적 중이라 건드리지 않는다.
MAX_BYTES=2097152        # 2MB. ALLOW_BIG=1 로 넘길 수 있지만 그 순간 방어가 없어진다.

img=""
secret=""
big=""

# git 은 비ASCII 경로를 "\354\227\260..." 로 이스케이프해 넘긴다. core.quotepath=false 가
# 없으면 **한글 파일명 패턴이 하나도 발화하지 않는다.** 2026-09-03 실전 테스트에서
# 연동규격_테스트.md·견적_테스트.md 가 그대로 통과하는 것을 확인했다. 아래 2)의 기존
# 패턴(작업지시서·보고_20)도 그때까지 죽은 규칙이었다.
#
# 로컬 설정(git config core.quotepath false)으로 우연히 동작할 수 있으나 클론하면
# 따라가지 않는다. 훅이 직접 끈다. IFS 고정은 공백 든 파일명이 쪼개지는 별개 버그다.
OLD_IFS=$IFS
IFS='
'
for f in $(git -c core.quotepath=false diff --cached --name-only --diff-filter=AM); do
  [ -f "$f" ] || continue

  # 1) 기사 그림은 webp만
  case "$f" in
    public/articles/*.png|public/articles/*.jpg|public/articles/*.jpeg|\
    public/articles/*.gif|public/articles/*.bmp|public/articles/*.tif|public/articles/*.tiff)
      slug=$(echo "$f" | cut -d/ -f3)
      d=$(echo "$slug" | cut -c1-10)
      if [ "$d" \> "$RULE_FROM" ] || [ "$d" = "$RULE_FROM" ]; then
        img="$img  $f\n"
      fi
      ;;
  esac

  # 2) 내부 자료가 딸려 올라가는 것을 막는다. public 저장소다.
  #
  # 2026-09-03 보강. 홈페이지(nextio-web)에서 CLAUDE.md 가 HTTP 200 으로 10일간 전문
  # 공개된 사고가 났다. 그 저장소 훅에도 파일명 패턴이 있었으나 CLAUDE·rules·연동규격이
  # 빠져 있었다. 여기에 같은 구멍을 남기지 않는다.
  # 기사 파일명은 ASCII 슬러그라 아래 한글 패턴에 걸리지 않는다.
  case "$f" in
    *.pdf|*.PDF|*.zip|*.ZIP|*.docx|*.DOCX|*.pptx|*.PPTX|*.xlsx|*.XLSX|*.hwp|*.HWP|*.hwpx)
      secret="$secret  $f
" ;;
    # 원본 매거진 훅에서 가져옴. 압축·원본 편집파일은 여기 올 이유가 없다.
    # mp4 는 막지 않는다 — 편집국 히어로·광고가 실제 배포 자산이다.
    *.psd|*.PSD|*.ai|*.AI|*.7z|*.rar|*.RAR|*.tar|*.tar.gz|*.tgz)
      secret="$secret  $f\n" ;;
    *_작업노트*|*_내부*|*작업지시서*|*보고_20*|*브리핑_*|*연동규격*|*검수_*|*회신_*)
      secret="$secret  $f\n" ;;
    CLAUDE.md|*/CLAUDE.md|rules.md|*/rules.md|.agents/*|*/.agents/*)
      secret="$secret  $f\n" ;;
    *modify_plan*|*착수점*)
      secret="$secret  $f\n" ;;
    *견적*|*계약*|*NDA*|*리드DB*|*컨택*|*단가*|*세금계산서*)
      secret="$secret  $f\n" ;;
  esac

  # 3) 큰 파일. Cloudflare Pages는 파일당 25MiB 제한이고, 저장소는 지워도 안 줄어든다.
  if [ -z "$ALLOW_BIG" ]; then
    size=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
      big="$big  $f  ($(( size / 1024 ))KB)\n"
    fi
  fi
done
IFS=$OLD_IFS

fail=0

if [ -n "$img" ]; then
  printf "\n[거부] 기사 그림은 webp만 커밋합니다\n\n"
  printf "$img"
  printf "\n  변환 후 화질을 검수받으십시오.\n"
  printf "    python tools/compare_webp.py <원본폴더> <webp폴더> [출력.html]\n"
  printf "    Image.open(src).convert(\"RGB\").save(dst, \"WEBP\", quality=90, method=6)\n"
  printf "  원본은 기자 폴더(Claim/원본도면/ 등)에 보관하고 site/ 에는 두지 않습니다.\n"
  fail=1
fi

if [ -n "$secret" ]; then
  printf "\n[거부] 이 저장소는 PUBLIC입니다. 다음 파일은 올리지 않습니다\n\n"
  printf "$secret"
  printf "\n  문서·압축파일·작업노트는 커밋되는 순간 전 세계에 공개되고,\n"
  printf "  지워도 히스토리에 남습니다. 필요하면 NEXTIO 쪽에 두십시오.\n"
  fail=1
fi

if [ -n "$big" ]; then
  printf "\n[거부] 2MB를 넘는 파일이 있습니다\n\n"
  printf "$big"
  printf "\n  Cloudflare Pages는 파일당 25MiB가 한도이고, git은 지워도 저장소가 줄지 않습니다.\n"
  printf "  정말 필요하면 ALLOW_BIG=1 git commit ... 으로 넘길 수 있지만\n"
  printf "  그 순간 이 방어가 없어집니다.\n"
  fail=1
fi

[ "$fail" -eq 0 ] || printf "\n"
exit $fail
