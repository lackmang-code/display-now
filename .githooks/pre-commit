#!/bin/sh
# 기사 그림 형식 검사 — 커밋 자체를 막는다.
#
# 빌드 단계 검사기(scripts/check-content.mjs)는 커밋 이후에 돈다. 그때는 이미 늦다.
# git은 파일을 지워도 히스토리에 블롭이 남아 저장소가 줄지 않기 때문이다.
# 실제로 2026-08-23에 png 3장을 커밋하고 push한 뒤에야 webp로 바꿨고, 706KB가 영구히 남았다.
#
# 되돌리는 법: 아직 push 전이라면 커밋을 다시 만들면 된다(git reset --soft HEAD~1).
# push한 뒤에는 히스토리 재작성 말고는 방법이 없다.

RULE_FROM="2026-08-25"   # 제2호부터 적용. 그전 발행분은 이미 추적 중이라 건드리지 않는다.
bad=""

for f in $(git diff --cached --name-only --diff-filter=AM); do
  case "$f" in
    public/articles/*.png|public/articles/*.jpg|public/articles/*.jpeg|\
    public/articles/*.gif|public/articles/*.bmp|public/articles/*.tif|public/articles/*.tiff)
      slug=$(echo "$f" | cut -d/ -f3)
      date=$(echo "$slug" | cut -c1-10)
      if [ "$date" \> "$RULE_FROM" ] || [ "$date" = "$RULE_FROM" ]; then
        bad="$bad  $f\n"
      fi
      ;;
  esac
done

if [ -n "$bad" ]; then
  printf "\n커밋 거부 — 기사 그림은 webp만 커밋합니다\n\n"
  printf "$bad"
  printf "\n변환:\n"
  printf '  python tools/compare_webp.py 로 화질을 확인한 뒤 커밋하십시오.\n'
  printf '  Image.open(src).convert("RGB").save(dst, "WEBP", quality=90, method=6)\n\n'
  printf "원본 png는 기자 폴더(Claim/원본도면/ 등)에 보관하고 site/ 에는 두지 않습니다.\n\n"
  exit 1
fi
exit 0
